// ============================================================================
// Transportadoras SaaS — Modelagem fisica do banco de dados
// ============================================================================
// Este arquivo contem APENAS a modelagem de dados (schema Prisma).
// Nenhuma logica de negocio, API ou validacao de aplicacao esta implementada
// aqui -- isso pertence a camada de servico (apps/api), nao ao schema.
//
// Convencoes adotadas:
// - snake_case no banco (via @@map/@map), camelCase no client Prisma
// - toda tabela operacional carrega tenant_id para isolamento multi-tenant
//   (reforcado por Row-Level Security no Postgres, fora do escopo do Prisma)
// - TollPlaza, TollRate e TagProvider sao dados de referencia GLOBAIS
//   (nao carregam tenant_id): sao compartilhados entre todas as transportadoras
// - Document e Attachment sao polimorficos por design (owner_type/entity_name
//   + id) para nao exigir nova tabela a cada novo tipo de arquivo
// - Colunas geoespaciais (geometry/geography) usam Unsupported(), porque o
//   Prisma nao tem tipo nativo para PostGIS -- a extensao ja esta habilitada
//   no datasource abaixo
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
  DISPATCHER
  AUDITOR
  DRIVER

  @@map("user_role")
}

enum FleetType {
  OWN
  AGGREGATED
  OUTSOURCED

  @@map("fleet_type")
}

enum VehicleType {
  TRACTOR_UNIT
  TRUCK
  VAN
  PICKUP
  OTHER

  @@map("vehicle_type")
}

/// Situacao operacional do veiculo -- distinta de deletedAt (exclusao
/// logica): um veiculo SOLD/MAINTENANCE ainda e um registro valido e
/// consultavel, apenas nao esta disponivel para uso.
enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  SOLD

  @@map("vehicle_status")
}

enum VehicleFuelType {
  DIESEL
  DIESEL_S10
  GASOLINE
  ETHANOL
  FLEX
  ELECTRIC
  HYBRID
  GNV
  OTHER

  @@map("vehicle_fuel_type")
}

/// Combustivel efetivamente abastecido em um FuelSupply (Fase 18) --
/// DISTINTO de VehicleFuelType (especificacao do veiculo): um veiculo FLEX
/// pode abastecer GASOLINA numa vez e ETANOL noutra, e ARLA32 (fluido de
/// arrefecimento de motores diesel) nao e um combustivel de especificacao
/// de veiculo. Nomenclatura em pt-BR de proposito (granularidade de posto
/// de combustivel real: S10/S500, nao apenas "DIESEL").
enum FuelType {
  DIESEL_S10
  DIESEL_S500
  GASOLINA
  ETANOL
  ARLA32
  OUTRO

  @@map("fuel_type")
}

/// Forma de pagamento do abastecimento -- DISTINTO de ExpensePaymentMethod
/// (Fase 16): FLEET_CARD (cartao frota, o meio mais comum de pagamento de
/// combustivel) e INVOICE (fatura do posto) nao existem la, e nao ha
/// separacao CREDIT/DEBIT aqui.
enum PaymentType {
  CASH
  PIX
  CARD
  INVOICE
  FLEET_CARD
  OTHER

  @@map("payment_type")
}

enum VehicleMaintenanceStatus {
  OPEN
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED

  @@map("vehicle_maintenance_status")
}

enum VehicleMaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  EMERGENCY
  OTHER

  @@map("vehicle_maintenance_type")
}

enum VehicleMaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("vehicle_maintenance_priority")
}

/// Estado do ciclo de vida do pneu (Fase 20) -- distinto de TireLocationType
/// (ONDE o pneu esta fisicamente agora). RETREADED e setado automaticamente
/// ao registrar uma recapagem; SCRAPPED ao registrar um descarte.
enum TireStatus {
  NEW
  IN_USE
  STOCK
  RETREADED
  SCRAPPED

  @@map("tire_status")
}

enum TireLocationType {
  STOCK
  VEHICLE
  TRAILER

  @@map("tire_location_type")
}

enum TrailerType {
  SIMPLE
  BITREM
  RODOTREM
  VANDERLEIA
  FULL_TRAILER
  SEMI_TRAILER
  DOLLY
  OTHER

  @@map("trailer_type")
}

enum TripStatus {
  PLANNED
  WAITING_DRIVER
  WAITING_DEPARTURE
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED

  @@map("trip_status")
}

enum TripPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("trip_priority")
}

enum RouteVersionReason {
  INITIAL
  DEVIATION
  ACCIDENT
  ROADWORK
  INTERDICTION
  DESTINATION_CHANGE

  @@map("route_version_reason")
}

enum RouteEventType {
  DEVIATION
  ACCIDENT
  ROADWORK
  INTERDICTION
  DESTINATION_CHANGE

  @@map("route_event_type")
}

enum AlertType {
  ROUTE_DEVIATION
  TOLL_DISCREPANCY
  DELAY
  ROUTE_EVENT
  DOCUMENT_EXPIRING
  OTHER

  @@map("alert_type")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("alert_severity")
}

enum NotificationChannel {
  PUSH
  EMAIL
  WHATSAPP
  SMS

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

enum TollTransactionSource {
  INTEGRATION
  MANUAL

  @@map("toll_transaction_source")
}

/// Classificacao automatica da transacao (valor cobrado vs. calculado pela
/// formula pricePerAxle * axleCount) -- ver TollTransactionsService.
enum TollTransactionStatus {
  NORMAL
  DIVERGENT
  EXEMPT

  @@map("toll_transaction_status")
}

/// Formato do arquivo de extrato importado (Fase 15). XML/TXT/API_INTEGRATION
/// ja modelados para permitir suporte futuro sem alterar o restante do
/// sistema -- apenas CSV/XLSX sao aceitos pelo upload nesta fase.
enum ImportFileType {
  CSV
  XLSX
  XML
  TXT
  API_INTEGRATION

  @@map("import_file_type")
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS

  @@map("import_job_status")
}

/// Motivo pelo qual uma linha do extrato NAO virou TollTransaction --
/// alimenta ImportJobError (ver GET /toll-import/:id/errors).
enum ImportRowIssueType {
  VALIDATION_ERROR
  DUPLICATE

  @@map("import_row_issue_type")
}

enum TollAuditStatus {
  OK
  DISCREPANCY
  PENDING

  @@map("toll_audit_status")
}

/// Categoria da despesa de viagem (Fase 16). TOLL_EXTRA cobre pedagio pago
/// fora do fluxo de tag/TollTransaction (ex: reembolso avulso) -- a fonte de
/// verdade do pedagio via tag continua sendo TollTransaction.
enum ExpenseCategory {
  FUEL
  FOOD
  HOTEL
  TOLL_EXTRA
  MAINTENANCE
  TIRES
  PARKING
  WASH
  ADVANCE
  FINE
  OTHER

  @@map("expense_category")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("expense_status")
}

enum ExpensePaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BANK_TRANSFER
  COMPANY_ACCOUNT
  OTHER

  @@map("expense_payment_method")
}

enum RevenueCategory {
  FREIGHT
  BONUS
  EXTRA_SERVICE
  INSURANCE
  OTHER

  @@map("revenue_category")
}

/// Estado do fechamento financeiro da viagem (Fase 17). REOPENED e distinto
/// de OPEN -- OPEN nunca foi fechado; REOPENED ja foi fechado ao menos uma
/// vez e foi reaberto (o historico do fechamento anterior nunca e apagado,
/// apenas sobrescrito no proximo fechamento).
enum SettlementStatus {
  OPEN
  CLOSED
  REOPENED

  @@map("settlement_status")
}

enum LocationType {
  FACTORY
  DISTRIBUTION_CENTER
  PORT
  TERMINAL
  CUSTOMER_SITE
  BRANCH
  OTHER

  @@map("location_type")
}

enum DocumentType {
  CRLV
  ANTT
  CNH
  MEDICAL_EXAM
  MOPP
  LICENSING
  INSURANCE
  OTHER

  @@map("document_type")
}

enum DocumentOwnerType {
  VEHICLE
  TRAILER
  DRIVER
  TENANT

  @@map("document_owner_type")
}

enum AttachmentType {
  PHOTO_VEHICLE
  PHOTO_CARGO
  PHOTO_INVOICE
  PHOTO_TOLL
  RECEIPT
  OTHER

  @@map("attachment_type")
}

enum ExternalSystem {
  TMS
  ERP
  TELEMETRY_PROVIDER
  TOLL_OPERATOR

  @@map("external_system")
}

/// Classificacao da parada operacional (Fase 25). UNKNOWN e o padrao quando o
/// app apenas detecta "veiculo parado" via GPS -- a classificacao real pode
/// ser feita pelo motorista depois, sem bloquear o registro da parada.
enum TripStopType {
  UNKNOWN
  FUEL
  REST
  MEAL
  MAINTENANCE
  OTHER

  @@map("trip_stop_type")
}

/// Origem do numero de eixos DECLARADO num AxleEvent -- DRIVER_INPUT quando o
/// motorista respondeu ao alerta de pedagio, TIMEOUT_DEFAULT quando nao
/// respondeu e o sistema assumiu a configuracao padrao automaticamente.
enum AxleEventSource {
  DRIVER_INPUT
  TIMEOUT_DEFAULT

  @@map("axle_event_source")
}

/// Estado de sincronizacao de um evento operacional gerado pelo app do
/// motorista (Fase 25). Registros so existem no backend depois de
/// sincronizados -- PENDING/FAILED sao principalmente estados do lado do
/// dispositivo (fila local), mantidos aqui para o campo nunca ficar
/// inconsistente com o que a fase pede.
enum SyncStatus {
  PENDING
  SYNCED
  FAILED

  @@map("sync_status")
}

/// Estado da carga no inicio da viagem (Fase 27) -- informado uma vez pelo
/// motorista na tela de largada, nunca inferido/alterado automaticamente.
enum TripLoadStatus {
  LOADED
  EMPTY

  @@map("trip_load_status")
}

// ============================================================================
// PLATAFORMA — tenant, usuarios, configuracoes, auditoria geral
// ============================================================================

/// Transportadora — raiz do isolamento multi-tenant. Toda tabela operacional
/// referencia Tenant direta ou indiretamente.
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  /// Razao social.
  name      String
  /// Nome fantasia (opcional -- nem toda transportadora usa um).
  tradeName String?  @map("trade_name")
  document  String   @unique @map("document") @db.VarChar(20) // CNPJ
  /// Identificador amigavel/URL-safe, unico. Ainda nao usado para roteamento
  /// (sem subdominio nesta fase) -- preparado para resolucao futura de tenant
  /// por subdominio/dominio personalizado (ex: "acme" em acme.app.com).
  slug      String   @unique
  /// URL do logotipo da empresa. Upload de arquivo fica para fase futura --
  /// aqui e apenas a referencia (ex: URL de um storage externo).
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  settings                TenantSettings?
  users                   UserAccount[]
  fleets                  Fleet[]
  vehicles                Vehicle[]
  trailers                Trailer[]
  drivers                 Driver[]
  customers               Customer[]
  locations               Location[]
  trips                   Trip[]
  vehicleTags             VehicleTag[]
  vehicleMaintenances     VehicleMaintenance[]
  documents               Document[]
  attachments             Attachment[]
  externalReferences      ExternalReference[]
  auditLogs               AuditLog[]
  tripCompositions        TripComposition[]
  tripCompositionTrailers TripCompositionTrailer[]
  axleConfigurations      AxleConfiguration[]
  routeVersions           RouteVersion[]
  routeEvents             RouteEvent[]
  routePlans              RoutePlan[]
  routePlanTolls          RoutePlanToll[]
  trackingPoints          TrackingPoint[]
  tripStops               TripStop[]
  axleEvents              AxleEvent[]
  alerts                  Alert[]
  notifications           Notification[]
  telemetry               Telemetry[]
  tripExpenses            TripExpense[]
  tripRevenues            TripRevenue[]
  tripAdvances            TripAdvance[]
  tripSettlements         TripSettlement[]
  tripMetrics             TripMetrics[]
  driverShifts            DriverShift[]
  tollTransactions        TollTransaction[]
  tollAudits              TollAudit[]
  tollRoutes              TollRoute[]
  tollRouteStops          TollRouteStop[]
  importJobs              ImportJob[]
  importJobErrors         ImportJobError[]
  fuelStations            FuelStation[]
  fuelSupplies            FuelSupply[]
  tires                   Tire[]
  tireMovements           TireMovement[]
  tireRetreads            TireRetread[]
  tireInspections         TireInspection[]
  tireDisposals           TireDisposal[]

  @@map("tenants")
}

/// Configuracoes operacionais da transportadora. 1:1 com Tenant, separado
/// para nao poluir a tabela principal com colunas de configuracao.
model TenantSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  tenantId                  String   @unique @map("tenant_id") @db.Uuid
  maxDeviationMeters        Int      @default(500) @map("max_deviation_meters")
  gpsPingIntervalSeconds    Int      @default(30) @map("gps_ping_interval_seconds")
  alertDelayThresholdMin    Int      @default(15) @map("alert_delay_threshold_min")
  /// Minutos parado (dentro de stopRadiusMeters) para o app do motorista
  /// considerar "parada detectada" (Fase 25) -- configuravel por tenant.
  stopDetectionMinutes      Int      @default(10) @map("stop_detection_minutes")
  /// Raio (metros) considerado "mesma regiao" para deteccao de parada.
  stopRadiusMeters          Int      @default(150) @map("stop_radius_meters")
  /// Raio (metros) a partir do qual o app do motorista mostra o alerta de
  /// praca de pedagio proxima (Fase 25).
  tollProximityRadiusMeters Int      @default(3000) @map("toll_proximity_radius_meters")
  /// Minutos consecutivos fora da rota planejada (alem de maxDeviationMeters)
  /// para confirmar um desvio sustentado (Fase 26) -- evita alertar por um
  /// unico ponto de GPS ruidoso. Reaproveita maxDeviationMeters (ja existente,
  /// ate entao nao consumido por nenhum codigo) para o limite de distancia.
  routeDeviationMinutes     Int      @default(5) @map("route_deviation_minutes")
  timezone                  String   @default("America/Sao_Paulo")
  currency                  String   @default("BRL") @db.VarChar(3)
  language                  String   @default("pt-BR") @map("language")
  preferences               Json?    @default("{}")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Conta de usuario da plataforma (admin, operador/despachante). Motoristas
/// podem opcionalmente ter uma UserAccount vinculada para login no app --
/// ver Driver.userAccountId.
model UserAccount {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  email        String
  passwordHash String    @map("password_hash")
  role         UserRole  @default(OPERATOR)
  isActive     Boolean   @default(true) @map("is_active")
  /// Exclusao logica (distinta de isActive: usuario desativado pode ser
  /// reativado; usuario excluido nao aparece mais em nenhuma listagem).
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant                         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverProfile                  Driver?
  auditLogs                      AuditLog[]
  acknowledgedAlerts             Alert[]              @relation("AlertAcknowledgedBy")
  notifications                  Notification[]
  refreshTokens                  RefreshToken[]
  vehicleMaintenancesResponsible VehicleMaintenance[]
  importJobsCreated              ImportJob[]
  tripExpensesCreated            TripExpense[]        @relation("TripExpenseCreator")
  tripExpensesUpdated            TripExpense[]        @relation("TripExpenseUpdater")
  tripExpensesApproved           TripExpense[]        @relation("TripExpenseApprover")
  tripRevenuesCreated            TripRevenue[]        @relation("TripRevenueCreator")
  tripRevenuesUpdated            TripRevenue[]        @relation("TripRevenueUpdater")
  tripAdvancesCreated            TripAdvance[]        @relation("TripAdvanceCreator")
  tripAdvancesUpdated            TripAdvance[]        @relation("TripAdvanceUpdater")
  tripSettlementsClosed          TripSettlement[]     @relation("TripSettlementCloser")
  fuelSuppliesCreated            FuelSupply[]         @relation("FuelSupplyCreator")
  fuelSuppliesUpdated            FuelSupply[]         @relation("FuelSupplyUpdater")
  tiresCreated                   Tire[]               @relation("TireCreator")
  tiresUpdated                   Tire[]               @relation("TireUpdater")
  tireMovementsCreated           TireMovement[]       @relation("TireMovementCreator")
  tireRetreadsCreated            TireRetread[]        @relation("TireRetreadCreator")
  tireInspectionsCreated         TireInspection[]     @relation("TireInspectionCreator")
  tireDisposalsCreated           TireDisposal[]       @relation("TireDisposalCreator")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("user_accounts")
}

/// Sessao de refresh token (JWT de longa duracao), persistida para permitir
/// revogacao/rotacao -- um JWT sozinho nao pode ser invalidado antes de
/// expirar. O id do registro E o "jti" embutido no payload do refresh token.
/// Nao carrega tenant_id: autenticacao e por usuario, o isolamento por
/// tenant do restante do sistema e resolvido via UserAccount.tenantId.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Trilha de auditoria geral da plataforma (nao apenas pedagio). Registrada
/// para qualquer alteracao sensivel em qualquer entidade.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  action        String // ex: "trip.status_changed", "toll_rate.updated"
  entityName    String   @map("entity_name")
  entityId      String   @map("entity_id") @db.Uuid
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  deviceInfo    String?  @map("device_info")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   UserAccount? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityName, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ============================================================================
// FROTA — frota, veiculos, implementos, tags de pedagio
// ============================================================================

/// Agrupamento organizacional de veiculos (ex: Matriz, Filial SP, Frota
/// propria, Frota agregada). Opcional em Vehicle.
model Fleet {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  type       FleetType @default(OWN)
  locationId String?   @map("location_id") @db.Uuid // base/filial, opcional
  isActive   Boolean   @default(true) @map("is_active")
  /// Exclusao logica (mesmo padrao ja usado em Driver/UserAccount).
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  vehicles Vehicle[]

  @@index([tenantId])
  @@map("fleets")
}

/// Unidade tratora (cavalo mecanico). NAO carrega mais eixos/categoria fixos
/// -- isso e derivado de AxleConfiguration por composicao de viagem, porque
/// o mesmo cavalo pode puxar implementos diferentes em viagens diferentes.
/// "category" e texto livre (proposital) porque a nomenclatura de categoria
/// de veiculo no transporte rodoviario brasileiro varia muito por empresa/
/// regiao (ex: "Toco", "Truck 6x2", "Cavalo Trucado") -- nao vale a pena
/// travar num enum fixo.
model Vehicle {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  fleetId               String?          @map("fleet_id") @db.Uuid
  plate                 String           @db.VarChar(10)
  renavam               String?          @db.VarChar(20)
  chassisNumber         String?          @map("chassis_number") @db.VarChar(30)
  brand                 String
  model                 String
  manufactureYear       Int?             @map("manufacture_year")
  modelYear             Int?             @map("model_year")
  color                 String?
  type                  VehicleType      @default(TRACTOR_UNIT)
  category              String?
  fuelType              VehicleFuelType? @map("fuel_type")
  /// Capacidade do tanque de combustivel (litros).
  tankCapacityLiters    Decimal?         @map("tank_capacity_liters") @db.Decimal(10, 2)
  /// Consumo medio (km por litro).
  averageConsumptionKmL Decimal?         @map("average_consumption_km_l") @db.Decimal(10, 2)
  /// Quilometragem atual registrada do veiculo (distinta de
  /// Telemetry.odometerKm, que e uma serie historica de leituras).
  odometerKm            Decimal?         @map("odometer_km") @db.Decimal(10, 2)
  /// Peso Bruto Total (PBT), em kg.
  grossWeightKg         Decimal?         @map("gross_weight_kg") @db.Decimal(10, 2)
  netWeightKg           Decimal?         @map("net_weight_kg") @db.Decimal(10, 2)
  cargoCapacityKg       Decimal?         @map("cargo_capacity_kg") @db.Decimal(10, 2)
  axleCount             Int?             @map("axle_count")
  notes                 String?
  status                VehicleStatus    @default(ACTIVE)
  /// Exclusao logica (mesmo padrao ja usado em Driver/UserAccount).
  deletedAt             DateTime?        @map("deleted_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fleet                   Fleet?               @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  tripCompositions        TripComposition[]
  tags                    VehicleTag[]
  telemetry               Telemetry[]
  maintenances            VehicleMaintenance[]
  tollTransactions        TollTransaction[]
  tripExpenses            TripExpense[]
  fuelSupplies            FuelSupply[]
  tripStops               TripStop[]
  axleEvents              AxleEvent[]
  routePlans              RoutePlan[]
  tires                   Tire[]               @relation("TireCurrentVehicle")
  tireMovementsAsPrevious TireMovement[]       @relation("TireMovementPreviousVehicle")
  tireMovementsAsNew      TireMovement[]       @relation("TireMovementNewVehicle")

  @@unique([tenantId, plate])
  @@unique([tenantId, renavam])
  @@unique([tenantId, chassisNumber])
  @@index([tenantId])
  @@index([fleetId])
  @@map("vehicles")
}

/// Registro de manutencao do veiculo. Modulo de negocio completo (agendamento,
/// custo, oficina, pecas...) fica para uma fase dedicada -- aqui existe o
/// suficiente para o relacionamento Vehicle->Manutencoes e para a regra de
/// exclusao ("nao excluir veiculo com manutencao aberta").
model VehicleMaintenance {
  id                 String                     @id @default(uuid()) @db.Uuid
  tenantId           String                     @map("tenant_id") @db.Uuid
  vehicleId          String                     @map("vehicle_id") @db.Uuid
  type               VehicleMaintenanceType     @default(PREVENTIVE)
  status             VehicleMaintenanceStatus   @default(OPEN)
  priority           VehicleMaintenancePriority @default(MEDIUM)
  /// Data de abertura da manutencao (distinta de createdAt: pode ser
  /// retroativa, ex: importacao de historico).
  openedAt           DateTime                   @default(now()) @map("opened_at")
  scheduledAt        DateTime?                  @map("scheduled_at")
  completedAt        DateTime?                  @map("completed_at")
  odometerKm         Decimal?                   @map("odometer_km") @db.Decimal(10, 2)
  workshop           String?
  supplier           String?
  mechanic           String?
  /// Usuario interno responsavel por acompanhar esta manutencao -- distinto
  /// do AuditLog.userId (que registra quem alterou o REGISTRO, nao quem e
  /// o responsavel pela manutencao em si).
  responsibleUserId  String?                    @map("responsible_user_id") @db.Uuid
  description        String?
  notes              String?
  laborCost          Decimal?                   @map("labor_cost") @db.Decimal(10, 2)
  partsCost          Decimal?                   @map("parts_cost") @db.Decimal(10, 2)
  /// Sempre calculado pelo service (laborCost + partsCost) -- nunca aceito
  /// diretamente do cliente.
  totalCost          Decimal?                   @map("total_cost") @db.Decimal(10, 2)
  serviceOrderNumber String?                    @map("service_order_number")
  warrantyUntil      DateTime?                  @map("warranty_until")
  nextReviewAt       DateTime?                  @map("next_review_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle         Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  responsibleUser UserAccount? @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@index([vehicleId, status])
  @@map("vehicle_maintenances")
}

/// Pneu da frota (Fase 20). status = estado de ciclo de vida (NEW/IN_USE/
/// STOCK/RETREADED/SCRAPPED); locationType/vehicleId/trailerId/position =
/// ONDE o pneu esta fisicamente AGORA (sempre um snapshot atual -- o
/// historico de cada troca fica em TireMovement, nunca sobrescrito).
model Tire {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  fireNumber          String           @map("fire_number")
  manufacturer        String
  model               String
  size                String
  dot                 String?
  serialNumber        String?          @map("serial_number")
  purchaseDate        DateTime?        @map("purchase_date")
  purchasePrice       Decimal?         @map("purchase_price") @db.Decimal(10, 2)
  expectedLifespanKm  Decimal?         @map("expected_lifespan_km") @db.Decimal(10, 2)
  initialTreadDepthMm Decimal?         @map("initial_tread_depth_mm") @db.Decimal(5, 2)
  /// Atualizado automaticamente pela inspecao mais recente (ver
  /// TiresService.createInspection).
  currentTreadDepthMm Decimal?         @map("current_tread_depth_mm") @db.Decimal(5, 2)
  status              TireStatus       @default(STOCK)
  locationType        TireLocationType @default(STOCK) @map("location_type")
  vehicleId           String?          @map("vehicle_id") @db.Uuid
  trailerId           String?          @map("trailer_id") @db.Uuid
  position            String?
  createdBy           String           @map("created_by") @db.Uuid
  updatedBy           String?          @map("updated_by") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?         @relation("TireCurrentVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  trailer     Trailer?         @relation("TireCurrentTrailer", fields: [trailerId], references: [id], onDelete: SetNull)
  creator     UserAccount      @relation("TireCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater     UserAccount?     @relation("TireUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  movements   TireMovement[]
  retreads    TireRetread[]
  inspections TireInspection[]
  disposal    TireDisposal?

  @@unique([tenantId, fireNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, vehicleId])
  @@index([tenantId, trailerId])
  @@map("tires")
}

/// Historico de troca/movimentacao de um pneu -- toda alteracao de
/// localizacao gera uma linha aqui, nunca sobrescrita (ver
/// TiresService.createMovement). previous* fica null na primeira
/// movimentacao (pneu recem-cadastrado, sem localizacao anterior alem do
/// estoque implicito).
model TireMovement {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  tireId               String            @map("tire_id") @db.Uuid
  movementDate         DateTime          @default(now()) @map("movement_date")
  previousLocationType TireLocationType? @map("previous_location_type")
  previousVehicleId    String?           @map("previous_vehicle_id") @db.Uuid
  previousTrailerId    String?           @map("previous_trailer_id") @db.Uuid
  previousPosition     String?           @map("previous_position")
  newLocationType      TireLocationType  @map("new_location_type")
  newVehicleId         String?           @map("new_vehicle_id") @db.Uuid
  newTrailerId         String?           @map("new_trailer_id") @db.Uuid
  newPosition          String?           @map("new_position")
  odometerKm           Decimal?          @map("odometer_km") @db.Decimal(10, 2)
  reason               String?
  createdBy            String            @map("created_by") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at")

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tire            Tire        @relation(fields: [tireId], references: [id], onDelete: Cascade)
  previousVehicle Vehicle?    @relation("TireMovementPreviousVehicle", fields: [previousVehicleId], references: [id], onDelete: SetNull)
  newVehicle      Vehicle?    @relation("TireMovementNewVehicle", fields: [newVehicleId], references: [id], onDelete: SetNull)
  previousTrailer Trailer?    @relation("TireMovementPreviousTrailer", fields: [previousTrailerId], references: [id], onDelete: SetNull)
  newTrailer      Trailer?    @relation("TireMovementNewTrailer", fields: [newTrailerId], references: [id], onDelete: SetNull)
  creator         UserAccount @relation("TireMovementCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, tireId])
  @@map("tire_movements")
}

/// Recapagem -- um pneu pode ter varias ao longo da vida. Registrar uma
/// recapagem atualiza Tire.status para RETREADED automaticamente.
model TireRetread {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tireId      String   @map("tire_id") @db.Uuid
  company     String
  cost        Decimal  @db.Decimal(10, 2)
  retreadDate DateTime @map("retread_date")
  warranty    String?
  mileageKm   Decimal? @map("mileage_km") @db.Decimal(10, 2)
  notes       String?
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tire    Tire        @relation(fields: [tireId], references: [id], onDelete: Cascade)
  creator UserAccount @relation("TireRetreadCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, tireId])
  @@map("tire_retreads")
}

/// Inspecao periodica (sulco/pressao) -- registrar uma inspecao atualiza
/// Tire.currentTreadDepthMm automaticamente para o valor medido.
model TireInspection {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tireId         String   @map("tire_id") @db.Uuid
  inspectionDate DateTime @default(now()) @map("inspection_date")
  treadDepthMm   Decimal  @map("tread_depth_mm") @db.Decimal(5, 2)
  pressurePsi    Decimal? @map("pressure_psi") @db.Decimal(6, 2)
  notes          String?
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tire    Tire        @relation(fields: [tireId], references: [id], onDelete: Cascade)
  creator UserAccount @relation("TireInspectionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, tireId])
  @@map("tire_inspections")
}

/// Descarte -- 1:1 com Tire (um pneu so e descartado uma vez). Registrar um
/// descarte atualiza Tire.status para SCRAPPED e remove o pneu de qualquer
/// veiculo/carreta automaticamente.
model TireDisposal {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tireId        String   @unique @map("tire_id") @db.Uuid
  reason        String
  disposalDate  DateTime @map("disposal_date")
  odometerKm    Decimal? @map("odometer_km") @db.Decimal(10, 2)
  residualValue Decimal? @map("residual_value") @db.Decimal(10, 2)
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tire    Tire        @relation(fields: [tireId], references: [id], onDelete: Cascade)
  creator UserAccount @relation("TireDisposalCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("tire_disposals")
}

/// Posto de abastecimento (Fase 18) -- dado de cadastro do tenant (ao
/// contrario de TollPlaza/TagProvider, que sao globais: cada transportadora
/// cadastra seus proprios postos conveniados/habituais).
model FuelStation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  cnpj      String?  @db.VarChar(20)
  city      String?
  state     String?  @db.VarChar(2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplies FuelSupply[]

  @@index([tenantId])
  @@map("fuel_stations")
}

/// Abastecimento de um veiculo (Fase 18). tripId e opcional -- quando
/// presente, vehicleId/driverId sao SEMPRE derivados da Trip (nunca aceitos
/// do cliente); quando ausente, vehicleId/driverId sao informados
/// diretamente (e validados). totalAmount e SEMPRE calculado
/// (liters * pricePerLiter), nunca aceito do cliente.
/// fuelStationId e OPCIONAL (Fase 25): o app do motorista registra apenas
/// KM+litros e a localizacao (latitude/longitude) -- sem escolher/inventar um
/// posto. O fluxo administrativo (Fase 18) continua exigindo fuelStationId no
/// DTO de criacao manual.
model FuelSupply {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  vehicleId     String       @map("vehicle_id") @db.Uuid
  driverId      String       @map("driver_id") @db.Uuid
  tripId        String?      @map("trip_id") @db.Uuid
  fuelStationId String?      @map("fuel_station_id") @db.Uuid
  attachmentId  String?      @map("attachment_id") @db.Uuid
  fuelType      FuelType     @map("fuel_type")
  liters        Decimal      @db.Decimal(10, 3)
  pricePerLiter Decimal      @map("price_per_liter") @db.Decimal(10, 4)
  /// Sempre liters * pricePerLiter -- ver FuelSuppliesService.
  totalAmount   Decimal      @map("total_amount") @db.Decimal(10, 2)
  /// Odometro no momento do abastecimento -- nunca menor que
  /// Vehicle.odometerKm no momento do registro (ver validacao no service).
  odometerKm    Decimal      @map("odometer_km") @db.Decimal(10, 2)
  supplyDate    DateTime     @map("supply_date")
  paymentType   PaymentType? @map("payment_type")
  invoiceNumber String?      @map("invoice_number")
  notes         String?
  /// Localizacao do abastecimento (Fase 25) -- preenchida pelo app do
  /// motorista quando nao ha fuelStationId conhecido.
  latitude      Decimal?     @db.Decimal(9, 6)
  longitude     Decimal?     @db.Decimal(9, 6)
  deviceEventId String?      @unique @map("device_event_id")
  syncedAt      DateTime?    @map("synced_at")
  syncStatus    SyncStatus   @default(SYNCED) @map("sync_status")
  createdBy     String       @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver      Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  trip        Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  fuelStation FuelStation? @relation(fields: [fuelStationId], references: [id], onDelete: Restrict)
  attachment  Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  creator     UserAccount  @relation("FuelSupplyCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater     UserAccount? @relation("FuelSupplyUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, driverId])
  @@index([tenantId, tripId])
  @@index([tenantId, fuelStationId])
  @@index([tenantId, supplyDate])
  @@map("fuel_supplies")
}

/// Implemento (carreta simples, bitrem, rodotrem, vanderleia, reboque,
/// semirreboque, dolly). Combinado ao Vehicle via TripComposition/
/// TripCompositionTrailer em cada composicao.
model Trailer {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  plate     String      @db.VarChar(10)
  type      TrailerType @default(SIMPLE)
  notes     String?
  isActive  Boolean     @default(true) @map("is_active")
  /// Exclusao logica (mesmo padrao ja usado em Driver/UserAccount).
  deletedAt DateTime?   @map("deleted_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tripCompositionTrailers TripCompositionTrailer[]
  tires                   Tire[]                   @relation("TireCurrentTrailer")
  tireMovementsAsPrevious TireMovement[]           @relation("TireMovementPreviousTrailer")
  tireMovementsAsNew      TireMovement[]           @relation("TireMovementNewTrailer")

  @@unique([tenantId, plate])
  @@index([tenantId])
  @@map("trailers")
}

/// Operadora de tag de pedagio (Sem Parar, ConectCar, Veloe, Move Mais).
/// Dado de referencia GLOBAL -- nao pertence a um tenant especifico.
model TagProvider {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  website   String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicleTags      VehicleTag[]
  tollTransactions TollTransaction[]
  importJobs       ImportJob[]

  @@map("tag_providers")
}

/// Vinculo entre o veiculo do tenant e sua tag de pedagio, preparando a
/// importacao futura de extratos por operadora.
model VehicleTag {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  vehicleId     String    @map("vehicle_id") @db.Uuid
  tagProviderId String    @map("tag_provider_id") @db.Uuid
  tagNumber     String    @map("tag_number")
  isActive      Boolean   @default(true) @map("is_active")
  activatedAt   DateTime? @map("activated_at")
  /// Data de vencimento da tag -- usada para bloquear transacoes de pedagio
  /// registradas com tag vencida (ver TollTransactionsService).
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tagProvider TagProvider @relation(fields: [tagProviderId], references: [id], onDelete: Restrict)

  @@unique([tagProviderId, tagNumber])
  @@index([tenantId])
  @@index([vehicleId])
  @@map("vehicle_tags")
}

// ============================================================================
// MOTORISTAS — perfil, jornada
// ============================================================================

/// Perfil operacional do motorista. userAccountId e opcional -- so existe
/// quando o motorista tem login no app (Driver App). Documentos (CNH,
/// exame medico, MOPP, ANTT...) NAO sao campos aqui -- usam o model
/// Document generico/polimorfico (ownerType=DRIVER, ownerId=Driver.id).
model Driver {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  userAccountId   String?   @unique @map("user_account_id") @db.Uuid
  name            String
  cpf             String    @db.VarChar(11)
  rg              String?   @db.VarChar(20)
  cnhNumber       String    @map("cnh_number") @db.VarChar(20)
  cnhCategory     String    @map("cnh_category") @db.VarChar(5)
  cnhExpiresAt    DateTime  @map("cnh_expires_at")
  birthDate       DateTime? @map("birth_date")
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?   @db.VarChar(2)
  zipCode         String?   @map("zip_code") @db.VarChar(9)
  notes           String?
  admissionDate   DateTime? @map("admission_date")
  /// Preenchida no desligamento do motorista -- distinta de deletedAt
  /// (desligado ainda e um registro historico valido; excluido logicamente
  /// nao deveria mais aparecer em listagens).
  terminationDate DateTime? @map("termination_date")
  isActive        Boolean   @default(true) @map("is_active")
  /// Exclusao logica (mesmo padrao de UserAccount.deletedAt).
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAccount      UserAccount?      @relation(fields: [userAccountId], references: [id], onDelete: SetNull)
  trips            Trip[]
  shifts           DriverShift[]
  tollTransactions TollTransaction[]
  tripExpenses     TripExpense[]
  tripAdvances     TripAdvance[]
  fuelSupplies     FuelSupply[]
  tripStops        TripStop[]
  axleEvents       AxleEvent[]

  @@unique([tenantId, cpf])
  @@unique([tenantId, cnhNumber])
  @@index([tenantId])
  @@map("drivers")
}

/// Jornada de trabalho do motorista. trip_id e opcional -- a jornada pode
/// existir fora de uma viagem especifica (parado, manutencao, descanso).
model DriverShift {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  driverId  String    @map("driver_id") @db.Uuid
  tripId    String?   @map("trip_id") @db.Uuid
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  trip   Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  breaks ShiftBreak[]

  @@index([tenantId])
  @@index([driverId])
  @@index([tripId])
  @@map("driver_shifts")
}

/// Pausa dentro de uma jornada de motorista.
model ShiftBreak {
  id            String    @id @default(uuid()) @db.Uuid
  driverShiftId String    @map("driver_shift_id") @db.Uuid
  startedAt     DateTime  @map("started_at")
  endedAt       DateTime? @map("ended_at")
  reason        String?

  driverShift DriverShift @relation(fields: [driverShiftId], references: [id], onDelete: Cascade)

  @@index([driverShiftId])
  @@map("shift_breaks")
}

// ============================================================================
// CLIENTES E LOCAIS
// ============================================================================

/// Embarcador -- dono da carga transportada.
model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  document  String?  @db.VarChar(20) // CNPJ/CPF
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trips    Trip[]
  revenues TripRevenue[]

  @@index([tenantId])
  @@map("customers")
}

/// Local de carga/descarga -- fabrica, CD, porto, terminal, cliente, filial.
/// Reutilizavel entre viagens (a mesma fabrica e cadastrada uma vez).
model Location {
  id        String                                @id @default(uuid()) @db.Uuid
  tenantId  String                                @map("tenant_id") @db.Uuid
  name      String
  type      LocationType                          @default(OTHER)
  address   String?
  /// Ponto geografico (PostGIS). Tipo nao suportado nativamente pelo Prisma.
  geoPoint  Unsupported("geometry(Point, 4326)")? @map("geo_point")
  createdAt DateTime                              @default(now()) @map("created_at")
  updatedAt DateTime                              @updatedAt @map("updated_at")

  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fleets             Fleet[]
  tripsAsOrigin      Trip[]  @relation("TripOrigin")
  tripsAsDestination Trip[]  @relation("TripDestination")

  @@index([tenantId])
  @@map("locations")
}

// ============================================================================
// COMPOSICAO DE VEICULO — cavalo + implementos + eixos
// ============================================================================

/// Composicao de cavalo mecanico + implementos, com configuracao de eixos.
/// tripId e OPCIONAL de proposito: a composicao pode ser montada/testada
/// pela gestao de frota (esta fase) ANTES de existir uma Trip -- o modulo
/// de Viagens (fase futura) associa tripId quando a viagem e criada. Quando
/// associada, e 1:1 com Trip (unique).
model TripComposition {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tripId    String?  @unique @map("trip_id") @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip              Trip?                    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle           Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  trailers          TripCompositionTrailer[]
  axleConfiguration AxleConfiguration?
  axleEvents        AxleEvent[]

  @@index([tenantId])
  @@index([vehicleId])
  @@map("trip_compositions")
}

/// Implemento(s) daquela composicao, com posicao (1a carreta, 2a carreta --
/// cobre bitrem/rodotrem com multiplos implementos).
model TripCompositionTrailer {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  tripCompositionId String @map("trip_composition_id") @db.Uuid
  trailerId         String @map("trailer_id") @db.Uuid
  positionOrder     Int    @map("position_order")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tripComposition TripComposition @relation(fields: [tripCompositionId], references: [id], onDelete: Cascade)
  trailer         Trailer         @relation(fields: [trailerId], references: [id], onDelete: Restrict)

  @@unique([tripCompositionId, positionOrder])
  @@index([tenantId])
  @@index([trailerId])
  @@map("trip_composition_trailers")
}

/// Snapshot da configuracao de eixos para a composicao daquela viagem --
/// eixo levantado normalmente NAO e cobrado, entao essa configuracao
/// determina a categoria de cobranca em TollRate/TollPrediction/TollTransaction.
model AxleConfiguration {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  tripCompositionId String   @unique @map("trip_composition_id") @db.Uuid
  totalAxles        Int      @map("total_axles")
  raisedAxles       Int      @default(0) @map("raised_axles")
  loweredAxles      Int      @default(0) @map("lowered_axles")
  suspendedAxles    Int      @default(0) @map("suspended_axles")
  steeringAxles     Int      @default(0) @map("steering_axles")
  tractionAxles     Int      @default(0) @map("traction_axles")
  /// Categoria calculada (padrao usado pelas concessionarias, ex: "2 eixos"),
  /// derivada dos campos acima -- usada para casar com TollRate.axleCategory.
  billableCategory  String   @map("billable_category")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tripComposition TripComposition @relation(fields: [tripCompositionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("axle_configurations")
}

// ============================================================================
// VIAGEM — ciclo de vida, rota, eventos, rastreamento, alertas
// ============================================================================

/// Viagem. Estados: PLANNED -> IN_PROGRESS -> COMPLETED | CANCELLED.
/// Replanejamento e um evento dentro de IN_PROGRESS, nao um status proprio.
model Trip {
  id                    String       @id @default(uuid()) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  customerId            String?      @map("customer_id") @db.Uuid
  driverId              String?      @map("driver_id") @db.Uuid
  originLocationId      String       @map("origin_location_id") @db.Uuid
  destinationLocationId String       @map("destination_location_id") @db.Uuid
  /// Rota de pedagio (Fase 23) -- corredor operacional conhecido, usado
  /// para determinar deterministicamente as pracas esperadas na viagem.
  /// Opcional: viagens sem rota continuam funcionando normalmente (nao
  /// entram na conciliacao, mas seguem operando e podendo ter pedagios
  /// registrados manualmente como antes da Fase 23).
  tollRouteId           String?      @map("toll_route_id") @db.Uuid
  /// Rota GEOGRAFICA planejada (Fase 26), calculada por um provider externo
  /// (ver RoutePlan) -- distinta de tollRouteId (corredor operacional
  /// manual da Fase 23; os dois convivem, nenhum substitui o outro).
  /// Aponta para qual das RoutePlan desta viagem (podem existir varias:
  /// alternativas + recalculos historicos) e a atualmente selecionada/ativa.
  routePlanId           String?      @unique @map("route_plan_id") @db.Uuid
  status                TripStatus   @default(PLANNED)
  priority              TripPriority @default(NORMAL)
  /// Carregado ou vazio, informado pelo motorista na largada (Fase 27) --
  /// nulo em viagens antigas/nao iniciadas por este fluxo.
  loadStatus            TripLoadStatus? @map("load_status")
  /// Odometro do veiculo no momento da largada, informado pelo motorista
  /// (Fase 27) -- distinto de Vehicle.odometerKm (que reflete a leitura MAIS
  /// RECENTE do veiculo, atualizada a cada abastecimento/conclusao). Gravado
  /// uma unica vez (primeiro start nunca e sobrescrito por retomadas).
  initialOdometerKm     Decimal?     @map("initial_odometer_km") @db.Decimal(10, 1)
  notes                 String?
  plannedDeparture      DateTime?    @map("planned_departure")
  plannedArrival        DateTime?    @map("planned_arrival")
  actualDeparture       DateTime?    @map("actual_departure")
  actualArrival         DateTime?    @map("actual_arrival")
  /// Exclusao logica -- so permitida enquanto a viagem nunca saiu do
  /// planejamento (ver regra em TripsService: apenas PLANNED/CANCELLED).
  deletedAt             DateTime?    @map("deleted_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  driver           Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  origin           Location   @relation("TripOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destination      Location   @relation("TripDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  tollRoute        TollRoute? @relation(fields: [tollRouteId], references: [id], onDelete: SetNull)
  // routePlanId aponta para a RoutePlan ATUAL entre as varias que a viagem
  // pode acumular (relation nomeada "CurrentRoutePlan", distinta da relation
  // 1:N "TripRoutePlans" abaixo, que e o historico completo via
  // RoutePlan.tripId) -- ver comentario em RoutePlan.
  currentRoutePlan RoutePlan? @relation("CurrentRoutePlan", fields: [routePlanId], references: [id], onDelete: SetNull)

  composition      TripComposition?
  routeVersions    RouteVersion[]
  routeEvents      RouteEvent[]
  routePlans       RoutePlan[]       @relation("TripRoutePlans")
  trackingPoints   TrackingPoint[]
  alerts           Alert[]
  tollTransactions TollTransaction[]
  expenses         TripExpense[]
  revenues         TripRevenue[]
  advances         TripAdvance[]
  settlement       TripSettlement?
  fuelSupplies     FuelSupply[]
  metrics          TripMetrics?
  driverShifts     DriverShift[]
  telemetry        Telemetry[]
  tripStops        TripStop[]
  axleEvents       AxleEvent[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("trips")
}

/// Versao imutavel da rota de uma viagem. Cada replanejamento cria uma nova
/// versao -- nunca se edita uma versao existente.
model RouteVersion {
  id            String                                     @id @default(uuid()) @db.Uuid
  tenantId      String                                     @map("tenant_id") @db.Uuid
  tripId        String                                     @map("trip_id") @db.Uuid
  versionNumber Int                                        @map("version_number")
  reason        RouteVersionReason                         @default(INITIAL)
  /// Geometria da rota (PostGIS linestring). Nao suportado nativamente.
  geometry      Unsupported("geometry(LineString, 4326)")?
  createdAt     DateTime                                   @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip            Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tollPredictions TollPrediction[]
  triggeringEvent RouteEvent?      @relation("RouteEventResult")

  @@unique([tripId, versionNumber])
  @@index([tenantId])
  @@map("route_versions")
}

/// Evento que motiva alerta e, quando exige desvio de fato, uma nova
/// RouteVersion. Nem todo evento gera replanejamento.
model RouteEvent {
  id                      String         @id @default(uuid()) @db.Uuid
  tenantId                String         @map("tenant_id") @db.Uuid
  tripId                  String         @map("trip_id") @db.Uuid
  type                    RouteEventType
  detectedAt              DateTime       @default(now()) @map("detected_at")
  resolvedAt              DateTime?      @map("resolved_at")
  resultingRouteVersionId String?        @unique @map("resulting_route_version_id") @db.Uuid
  /// Fase 26 -- quando o evento (tipicamente DEVIATION, detectado
  /// automaticamente a partir de TrackingPoint x RoutePlan.encodedPolyline)
  /// resulta num recalculo de rota geografica, aponta para o RoutePlan
  /// gerado. Mesma convencao de resultingRouteVersionId (FK opcional/unica),
  /// mas para o novo conceito de rota (RoutePlan), nao a rota operacional.
  resultingRoutePlanId    String?        @unique @map("resulting_route_plan_id") @db.Uuid

  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip                  Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  resultingRouteVersion RouteVersion? @relation("RouteEventResult", fields: [resultingRouteVersionId], references: [id], onDelete: SetNull)
  resultingRoutePlan    RoutePlan?    @relation("RouteEventRoutePlanResult", fields: [resultingRoutePlanId], references: [id], onDelete: SetNull)
  alerts                Alert[]

  @@index([tenantId])
  @@index([tripId])
  @@map("route_events")
}

/// Origem da estimativa de pedagio de uma RoutePlan (Fase 26). MATCHED_PLAZAS
/// = soma das RoutePlanToll casadas com TollPlaza (fonte preferida, mais
/// precisa); PROVIDER_AGGREGATE = a API de rotas informou que ha pedagio na
/// rota e devolveu um valor agregado, mas nenhuma praca individual pode ser
/// identificada com confianca no catalogo (nunca inventamos uma praca so
/// para "explicar" esse valor); NONE = sem qualquer informacao de pedagio.
enum RouteTollEstimateSource {
  MATCHED_PLAZAS
  PROVIDER_AGGREGATE
  NONE

  @@map("route_toll_estimate_source")
}

/// Confianca da correspondencia entre uma praca descoberta na rota e uma
/// TollPlaza do catalogo (Fase 26). MATCHED = dentro da tolerancia
/// configurada; UNMATCHED = candidato identificado (coordenadas de um
/// provider futuro que devolva pracas nomeadas), mas sem correspondencia
/// confiavel -- nunca vira uma TollPlaza nova automaticamente.
enum TollMatchStatus {
  MATCHED
  UNMATCHED

  @@map("toll_match_status")
}

/// Rota GEOGRAFICA planejada (Fase 26), calculada por um RoutingProvider
/// externo (ver apps/api/src/routing). DISTINTA de TollRoute (Fase 23,
/// corredor operacional manual por nome/praca, sem geolocalizacao) -- as
/// duas convivem, nenhuma substitui a outra (ver Trip.tollRouteId x
/// Trip.routePlanId). Uma Trip pode acumular varias RoutePlan ao longo do
/// tempo (alternativas oferecidas + recalculos apos desvio) -- a relation
/// "TripRoutePlans" (via tripId) e o historico completo; Trip.routePlanId
/// ("CurrentRoutePlan") aponta para qual delas esta ativa agora. Nunca
/// editada apos criada (mesmo espirito de imutabilidade de RouteVersion) --
/// um recalculo sempre cria uma RoutePlan nova, nunca atualiza uma existente.
model RoutePlan {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  tripId               String                  @map("trip_id") @db.Uuid
  /// Composicao/veiculo cujo AxleConfiguration.totalAxles foi usado para
  /// estimar o pedagio (snapshot -- ver axleCountUsed). Nao duplica dados do
  /// veiculo, so referencia.
  vehicleId            String?                 @map("vehicle_id") @db.Uuid
  originLabel          String                  @map("origin_label")
  destinationLabel     String                  @map("destination_label")
  originLatitude       Decimal                 @map("origin_latitude") @db.Decimal(10, 7)
  originLongitude      Decimal                 @map("origin_longitude") @db.Decimal(10, 7)
  destinationLatitude  Decimal                 @map("destination_latitude") @db.Decimal(10, 7)
  destinationLongitude Decimal                 @map("destination_longitude") @db.Decimal(10, 7)
  distanceMeters       Int                     @map("distance_meters")
  durationSeconds      Int                     @map("duration_seconds")
  /// Geometria codificada no formato "encoded polyline" do Google (algoritmo
  /// publico, reaproveitavel por qualquer provider) -- evita depender de
  /// PostGIS/SQL bruto (Unsupported() no Prisma) para o caso de uso desta
  /// fase. Decodificada sob demanda (ver routing/utils/polyline.util.ts).
  encodedPolyline      String                  @map("encoded_polyline") @db.Text
  /// Soma das RoutePlanToll.estimatedAmount conhecidas, OU o valor agregado
  /// do provider quando nao ha nenhuma praca casada (ver tollEstimateSource).
  /// Sempre uma PREVISAO -- nunca confundir com cobranca real (TollTransaction).
  totalTollAmount      Decimal?                @map("total_toll_amount") @db.Decimal(10, 2)
  tollEstimateSource   RouteTollEstimateSource @default(NONE) @map("toll_estimate_source")
  currency             String                  @default("BRL") @db.VarChar(3)
  /// Quantidade de eixos usada para estimar pedagio (padrao da composicao no
  /// momento do calculo) -- NUNCA altera AxleConfiguration.totalAxles.
  axleCountUsed        Int?                    @map("axle_count_used")
  /// Motivo desta versao existir -- reaproveita o enum ja criado para
  /// RouteVersion (Fase 23/roadmap), mesmo significado semantico.
  reason               RouteVersionReason      @default(INITIAL)
  /// Identificador do provider usado (ex: "GOOGLE") -- string livre, nao
  /// enum, de proposito: novos providers nao devem exigir migration.
  provider             String
  /// Id da rota no provider, quando ele expuser um (nem todo provider tem).
  providerRouteId      String?                 @map("provider_route_id")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip           Trip            @relation("TripRoutePlans", fields: [tripId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  currentForTrip Trip?           @relation("CurrentRoutePlan")
  tolls          RoutePlanToll[]
  deviationEvent RouteEvent?     @relation("RouteEventRoutePlanResult")

  @@index([tenantId])
  @@index([tripId])
  @@map("route_plans")
}

/// Praca de pedagio descoberta ao longo de uma RoutePlan (Fase 26).
/// Descoberta cruzando a geometria da rota (RoutePlan.encodedPolyline) com o
/// catalogo de TollPlaza (nao o inverso -- a API de rotas usada nesta fase
/// nao devolve uma lista confiavel de pracas nomeadas, so geometria + valor
/// agregado, ver GoogleRoutingProvider). Por isso, nesta implementacao, toda
/// linha aqui criada ja nasce com tollPlazaId preenchido (MATCHED); o campo
/// matchStatus/matchConfidence fica modelado para quando um provider futuro
/// devolver candidatos nomeados que precisem de correspondencia por
/// coordenadas/distancia (ver routing/utils/toll-matching.util.ts).
model RoutePlanToll {
  id                       String          @id @default(uuid()) @db.Uuid
  tenantId                 String          @map("tenant_id") @db.Uuid
  routePlanId              String          @map("route_plan_id") @db.Uuid
  /// Nulo somente quando matchStatus = UNMATCHED.
  tollPlazaId              String?         @map("toll_plaza_id") @db.Uuid
  /// Posicao da praca ao longo da rota (1 = mais proxima da origem).
  sequence                 Int
  latitude                 Decimal         @db.Decimal(10, 7)
  longitude                Decimal         @db.Decimal(10, 7)
  /// Nome exibido -- vem da TollPlaza casada quando houver (nunca inventado
  /// quando UNMATCHED; nesse caso fica um rotulo generico "Praca N").
  name                     String
  distanceFromOriginMeters Int             @map("distance_from_origin_meters")
  /// Sempre uma PREVISAO (TOLL ESTIMATED) -- nulo quando TollPlaza.pricePerAxle
  /// e desconhecido (nunca assumir zero como tarifa valida, mesmo principio
  /// da Fase 22/computeAuditVerdict).
  estimatedAmount          Decimal?        @map("estimated_amount") @db.Decimal(10, 2)
  currency                 String          @default("BRL") @db.VarChar(3)
  axleCountUsed            Int?            @map("axle_count_used")
  matchStatus              TollMatchStatus @default(UNMATCHED) @map("match_status")
  /// Score 0..1 de confianca da correspondencia (1 = distancia zero da
  /// rota). Nulo quando UNMATCHED.
  matchConfidence          Decimal?        @map("match_confidence") @db.Decimal(4, 3)
  /// Fonte da descoberta (ex: "TOLL_PLAZA_MATCH") -- distingue de futuras
  /// fontes (ex: candidato nomeado devolvido por outro provider).
  source                   String
  /// Dados brutos do provider/calculo, quando uteis para auditoria futura
  /// (ex: distancia calculada ate a rota, indice no polyline).
  metadata                 Json?
  createdAt                DateTime        @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routePlan RoutePlan  @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  tollPlaza TollPlaza? @relation(fields: [tollPlazaId], references: [id], onDelete: SetNull)

  @@unique([routePlanId, sequence])
  @@index([tenantId])
  @@index([routePlanId])
  @@index([tollPlazaId])
  @@map("route_plan_tolls")
}

/// Ponto de GPS -- alto volume, granularidade de segundos. Fonte tanto do
/// rastreamento ao vivo (via WebSocket) quanto do replay de viagem.
/// Recomenda-se particionamento por tempo (ex: mensal) em producao.
model TrackingPoint {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  tripId        String     @map("trip_id") @db.Uuid
  latitude      Decimal    @db.Decimal(9, 6)
  longitude     Decimal    @db.Decimal(9, 6)
  speedKmh      Decimal?   @map("speed_kmh") @db.Decimal(5, 2)
  headingDeg    Decimal?   @map("heading_deg") @db.Decimal(5, 2)
  recordedAt    DateTime   @map("recorded_at")
  /// Id gerado pelo dispositivo (app do motorista, Fase 25) -- garante
  /// idempotencia quando o mesmo ponto e reenviado apos reconexao. Nulo para
  /// pontos que venham a ser gerados por outra origem (ex: replay/importacao).
  deviceEventId String?    @unique @map("device_event_id")
  syncedAt      DateTime   @default(now()) @map("synced_at")
  syncStatus    SyncStatus @default(SYNCED) @map("sync_status")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tripId, recordedAt])
  @@map("tracking_points")
}

/// Parada operacional da viagem (Fase 25) -- distinta de TollRouteStop (praca
/// de pedagio ESPERADA pela rota). Detectada pelo app do motorista (veiculo
/// parado na mesma regiao por tempo acima do limite configuravel em
/// TenantSettings) e classificada inicialmente como UNKNOWN; o motorista pode
/// reclassificar depois (FUEL/REST/MEAL/MAINTENANCE/OTHER) sem precisar
/// reabrir a parada.
model TripStop {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  tripId          String       @map("trip_id") @db.Uuid
  vehicleId       String       @map("vehicle_id") @db.Uuid
  driverId        String       @map("driver_id") @db.Uuid
  type            TripStopType @default(UNKNOWN)
  latitude        Decimal      @db.Decimal(9, 6)
  longitude       Decimal      @db.Decimal(9, 6)
  startedAt       DateTime     @map("started_at")
  endedAt         DateTime?    @map("ended_at")
  /// Sempre calculado (endedAt - startedAt) no fechamento -- nunca aceito do
  /// cliente.
  durationMinutes Int?         @map("duration_minutes")
  /// Nome/local do posto ou ponto identificado -- nulo quando nao for
  /// possivel identificar (nunca inventado, ver regra da Fase 25).
  locationLabel   String?      @map("location_label")
  deviceEventId   String       @unique @map("device_event_id")
  syncedAt        DateTime     @default(now()) @map("synced_at")
  syncStatus      SyncStatus   @default(SYNCED) @map("sync_status")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@map("trip_stops")
}

/// Excecao TEMPORARIA de eixos numa praca especifica (Fase 25) -- NUNCA alta
/// AxleConfiguration.totalAxles (que continua sendo o padrao permanente da
/// composicao). Cada passagem com quantidade diferente do padrao gera um
/// registro aqui; o retorno ao padrao apos a praca e implicito (fechamento do
/// evento), sem exigir nenhuma acao do motorista. Serve de historico/consulta
/// para quem lanca a TollTransaction real saber quantos eixos foram usados
/// naquela passagem -- nao gera a transacao sozinho (sem leitura automatica
/// de tag nesta fase).
model AxleEvent {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  tripId            String          @map("trip_id") @db.Uuid
  tripCompositionId String          @map("trip_composition_id") @db.Uuid
  vehicleId         String          @map("vehicle_id") @db.Uuid
  driverId          String          @map("driver_id") @db.Uuid
  /// Praca de pedagio identificada por proximidade GPS -- nulo quando o app
  /// nao conseguiu identificar a praca com seguranca.
  tollPlazaId       String?         @map("toll_plaza_id") @db.Uuid
  /// Snapshot de AxleConfiguration.totalAxles no momento do evento.
  defaultAxles      Int             @map("default_axles")
  /// Quantidade efetivamente informada (pelo motorista) ou assumida
  /// (timeout) para esta passagem.
  declaredAxles     Int             @map("declared_axles")
  /// Sempre max(defaultAxles - declaredAxles, 0) -- nunca aceito do cliente.
  suspendedAxles    Int             @map("suspended_axles")
  source            AxleEventSource
  startedAt         DateTime        @map("started_at")
  endedAt           DateTime?       @map("ended_at")
  latitude          Decimal         @db.Decimal(9, 6)
  longitude         Decimal         @db.Decimal(9, 6)
  deviceEventId     String          @unique @map("device_event_id")
  syncedAt          DateTime        @default(now()) @map("synced_at")
  syncStatus        SyncStatus      @default(SYNCED) @map("sync_status")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip            Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripComposition TripComposition @relation(fields: [tripCompositionId], references: [id], onDelete: Cascade)
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver          Driver          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  tollPlaza       TollPlaza?      @relation(fields: [tollPlazaId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@index([tollPlazaId])
  @@map("axle_events")
}

/// Evento de sistema (desvio, discrepancia de pedagio, atraso, documento
/// vencendo). Representa O QUE aconteceu -- a entrega ao usuario e Notification.
model Alert {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  tripId           String?       @map("trip_id") @db.Uuid
  routeEventId     String?       @map("route_event_id") @db.Uuid
  type             AlertType
  severity         AlertSeverity @default(MEDIUM)
  message          String
  acknowledgedAt   DateTime?     @map("acknowledged_at")
  acknowledgedById String?       @map("acknowledged_by_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip           Trip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  routeEvent     RouteEvent?    @relation(fields: [routeEventId], references: [id], onDelete: SetNull)
  acknowledgedBy UserAccount?   @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([tenantId])
  @@index([tripId])
  @@map("alerts")
}

/// Entrega de um Alert a um usuario por um canal especifico. Um Alert pode
/// gerar varias Notifications (push + email, por exemplo).
model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  alertId     String              @map("alert_id") @db.Uuid
  recipientId String              @map("recipient_id") @db.Uuid
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  sentAt      DateTime?           @map("sent_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alert     Alert       @relation(fields: [alertId], references: [id], onDelete: Cascade)
  recipient UserAccount @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([alertId])
  @@index([recipientId, status])
  @@map("notifications")
}

/// Dados de telemetria do veiculo (ignicao, bateria, combustivel,
/// temperatura, RPM, odometro, velocidade CAN) -- separado de TrackingPoint
/// porque e mais pesado e mais esparso que a posicao GPS.
model Telemetry {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tripId       String?  @map("trip_id") @db.Uuid
  vehicleId    String   @map("vehicle_id") @db.Uuid
  ignitionOn   Boolean? @map("ignition_on")
  batteryLevel Decimal? @map("battery_level") @db.Decimal(5, 2)
  fuelLevel    Decimal? @map("fuel_level") @db.Decimal(5, 2)
  temperatureC Decimal? @map("temperature_c") @db.Decimal(5, 2)
  rpm          Int?
  odometerKm   Decimal? @map("odometer_km") @db.Decimal(10, 2)
  canSpeedKmh  Decimal? @map("can_speed_kmh") @db.Decimal(5, 2)
  recordedAt   DateTime @map("recorded_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip    Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vehicleId, recordedAt])
  @@index([tripId])
  @@map("telemetry")
}

// ============================================================================
// PEDAGIO — praca, tarifa, previsao, cobranca real, auditoria
// ============================================================================

/// Praca de pedagio. Dado de referencia GLOBAL -- nao pertence a um tenant.
model TollPlaza {
  id           String                                @id @default(uuid()) @db.Uuid
  name         String
  operator     String // concessionaria (ex: CCR, Arteris) -- distinta de TagProvider (Sem Parar, ConectCar...), texto livre de proposito
  highway      String?
  /// Quilometro da rodovia onde a praca esta localizada.
  km           Decimal?                              @db.Decimal(10, 3)
  city         String?
  state        String?                               @db.VarChar(2)
  latitude     Decimal?                              @db.Decimal(10, 7)
  longitude    Decimal?                              @db.Decimal(10, 7)
  /// Valor cobrado por eixo -- usado no calculo automatico de
  /// TollTransaction.expectedAmount (valorPorEixo * quantidadeDeEixos).
  /// Distinto de TollRate (tarifa por categoria/periodo, usada nas
  /// previsoes de rota) -- aqui e uma formula linear simples.
  pricePerAxle Decimal?                              @map("price_per_axle") @db.Decimal(10, 2)
  /// Ponto geografico (PostGIS) -- exige SQL bruto, nao exposto via API
  /// nesta fase (mesmo padrao ja usado em Location.geoPoint).
  geoPoint     Unsupported("geometry(Point, 4326)")? @map("geo_point")
  createdAt    DateTime                              @default(now()) @map("created_at")
  updatedAt    DateTime                              @updatedAt @map("updated_at")

  rates          TollRate[]
  predictions    TollPrediction[]
  transactions   TollTransaction[]
  routeStops     TollRouteStop[]
  axleEvents     AxleEvent[]
  routePlanTolls RoutePlanToll[]

  @@map("toll_plazas")
}

/// Rota de pedagio (Fase 23) -- corredor operacional conhecido pela
/// transportadora (ex: "Sao Jose do Rio Preto -> Sao Paulo"), usado para
/// determinar deterministicamente quais pracas sao esperadas numa viagem,
/// SEM depender de geolocalizacao/roteirizacao automatica (fora de escopo
/// desta fase -- ver TollPrediction/RouteVersion para a abordagem
/// geografica, ainda nao usada por nenhum codigo). originLabel/
/// destinationLabel sao texto livre (nome de cidade/regiao), distintos de
/// Location (que representa um endereco operacional especifico de
/// embarque/descarga) -- um corredor de pedagio e um conceito de rodovia,
/// nao de endereco.
model TollRoute {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  originLabel      String   @map("origin_label")
  destinationLabel String   @map("destination_label")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stops  TollRouteStop[]
  trips  Trip[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("toll_routes")
}

/// Parada (praca esperada) de uma TollRoute, em ordem. A mesma TollPlaza
/// pode participar de varias rotas; uma rota nao pode repetir a mesma praca
/// duas vezes (ver @@unique abaixo) -- TollPlaza continua sendo a unica
/// fonte de verdade da praca, esta tabela so guarda a ORDEM dela dentro de
/// uma rota especifica.
model TollRouteStop {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  tollRouteId String @map("toll_route_id") @db.Uuid
  tollPlazaId String @map("toll_plaza_id") @db.Uuid
  /// Posicao da praca na rota (1 = primeira praca esperada).
  sequence    Int

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tollRoute TollRoute @relation(fields: [tollRouteId], references: [id], onDelete: Cascade)
  tollPlaza TollPlaza @relation(fields: [tollPlazaId], references: [id], onDelete: Restrict)

  @@unique([tollRouteId, sequence])
  @@unique([tollRouteId, tollPlazaId])
  @@index([tenantId])
  @@index([tollPlazaId])
  @@map("toll_route_stops")
}

/// Tarifa por praca e categoria de eixos, versionada no tempo (effectiveFrom)
/// -- preserva o valor correto historico mesmo que a tarifa mude depois.
/// Dado de referencia GLOBAL.
model TollRate {
  id            String   @id @default(uuid()) @db.Uuid
  tollPlazaId   String   @map("toll_plaza_id") @db.Uuid
  axleCategory  String   @map("axle_category") // ex: "2 eixos", "9 eixos"
  price         Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")

  tollPlaza TollPlaza @relation(fields: [tollPlazaId], references: [id], onDelete: Cascade)

  @@unique([tollPlazaId, axleCategory, effectiveFrom])
  @@index([tollPlazaId])
  @@map("toll_rates")
}

/// Custo de pedagio previsto por praca, calculado para uma versao de rota
/// especifica. Recalculado a cada replanejamento (nova RouteVersion).
model TollPrediction {
  id              String   @id @default(uuid()) @db.Uuid
  routeVersionId  String   @map("route_version_id") @db.Uuid
  tollPlazaId     String   @map("toll_plaza_id") @db.Uuid
  predictedAmount Decimal  @map("predicted_amount") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  routeVersion RouteVersion @relation(fields: [routeVersionId], references: [id], onDelete: Cascade)
  tollPlaza    TollPlaza    @relation(fields: [tollPlazaId], references: [id], onDelete: Restrict)
  audits       TollAudit[]

  @@index([routeVersionId])
  @@index([tollPlazaId])
  @@map("toll_predictions")
}

/// Cobranca real ocorrida em uma praca. Vincula-se a Trip e a TollPlaza --
/// NUNCA diretamente a uma RouteVersion; e a TollAudit quem cruza os dois
/// (conciliacao com a PREVISAO de rota). vehicleId/driverId/tagProviderId
/// sao denormalizados a partir da Trip/tag ativa no momento do registro --
/// mesma convencao ja adotada no projeto (tenant_id denormalizado em toda
/// tabela operacional) para permitir filtros/relatorios diretos sem joins
/// complexos e sensiveis a mudanca de tag ao longo do tempo.
model TollTransaction {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  tripId            String                @map("trip_id") @db.Uuid
  vehicleId         String                @map("vehicle_id") @db.Uuid
  driverId          String?               @map("driver_id") @db.Uuid
  tollPlazaId       String                @map("toll_plaza_id") @db.Uuid
  tagProviderId     String?               @map("tag_provider_id") @db.Uuid
  axleCount         Int                   @map("axle_count")
  /// Calculado automaticamente: TollPlaza.pricePerAxle * axleCount.
  expectedAmount    Decimal               @map("expected_amount") @db.Decimal(10, 2)
  chargedAmount     Decimal               @map("charged_amount") @db.Decimal(10, 2)
  /// Calculado automaticamente: chargedAmount - expectedAmount.
  discrepancyAmount Decimal               @map("discrepancy_amount") @db.Decimal(10, 2)
  /// Classificacao automatica (NORMAL/DIVERGENT/EXEMPT) -- ver
  /// TollTransactionsService. Distinta de TollAudit.status (que conciliar
  /// com a PREVISAO de rota, nao com a formula simples de valor por eixo).
  status            TollTransactionStatus @default(NORMAL)
  chargedAt         DateTime              @map("charged_at")
  source            TollTransactionSource @default(INTEGRATION)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver      Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  tollPlaza   TollPlaza    @relation(fields: [tollPlazaId], references: [id], onDelete: Restrict)
  tagProvider TagProvider? @relation(fields: [tagProviderId], references: [id], onDelete: SetNull)
  audit       TollAudit?

  @@index([tenantId])
  @@index([tripId])
  @@index([tollPlazaId, chargedAt])
  @@index([tenantId, vehicleId])
  @@index([tenantId, driverId])
  @@index([tenantId, status])
  @@index([tenantId, tagProviderId])
  @@map("toll_transactions")
}

/// Job de importacao de extrato de pedagio enviado por uma operadora (Fase
/// 15). O parser real (CSV/XLSX hoje; XML/TXT/API_INTEGRATION preparados
/// para o futuro) e escolhido dinamicamente a partir de fileType, sem exigir
/// mudanca de schema para suportar um novo formato.
model ImportJob {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  providerId       String          @map("provider_id") @db.Uuid
  /// Nome do arquivo no storage privado (gerado, nunca o nome original --
  /// evita colisao/overwrite e nao expoe o nome enviado pelo usuario no disco).
  filename         String
  originalFilename String          @map("original_filename")
  fileType         ImportFileType  @map("file_type")
  status           ImportJobStatus @default(PENDING)
  importedRecords  Int             @default(0) @map("imported_records")
  ignoredRecords   Int             @default(0) @map("ignored_records")
  errorRecords     Int             @default(0) @map("error_records")
  startedAt        DateTime?       @map("started_at")
  finishedAt       DateTime?       @map("finished_at")
  createdBy        String          @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider TagProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  creator  UserAccount      @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  errors   ImportJobError[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([providerId])
  @@map("import_jobs")
}

/// Detalhe de uma linha do extrato nao importada (erro de validacao ou
/// duplicidade) -- nunca interrompe o job inteiro, apenas registra a
/// inconsistencia daquela linha especifica. Alimenta GET /toll-import/:id/errors.
model ImportJobError {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  importJobId String             @map("import_job_id") @db.Uuid
  rowNumber   Int                @map("row_number")
  issueType   ImportRowIssueType @map("issue_type")
  message     String
  /// Snapshot da linha original do arquivo, para o usuario conseguir
  /// corrigir e reenviar sem precisar abrir o arquivo de novo.
  rawData     Json               @map("raw_data")
  createdAt   DateTime           @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([tenantId])
  @@map("import_job_errors")
}

/// Conciliacao entre valor previsto e valor cobrado. SEMPRE derivada/
/// calculada -- nunca editada manualmente.
model TollAudit {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  tollTransactionId String          @unique @map("toll_transaction_id") @db.Uuid
  tollPredictionId  String?         @map("toll_prediction_id") @db.Uuid
  discrepancyAmount Decimal?        @map("discrepancy_amount") @db.Decimal(10, 2)
  status            TollAuditStatus @default(PENDING)
  calculatedAt      DateTime        @default(now()) @map("calculated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tollTransaction TollTransaction @relation(fields: [tollTransactionId], references: [id], onDelete: Cascade)
  tollPrediction  TollPrediction? @relation(fields: [tollPredictionId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("toll_audits")
}

// ============================================================================
// FINANCEIRO — despesas e comparativo planejado x executado
// ============================================================================

/// Despesa operacional de uma viagem (abastecimento, alimentacao,
/// hospedagem, manutencao emergencial, etc. -- Fase 16). Toda despesa
/// pertence obrigatoriamente a uma Trip; driverId/vehicleId sao SEMPRE
/// derivados da Trip no momento da criacao (nunca aceitos do cliente), o
/// mesmo principio ja aplicado em TollTransaction (Fase 14). Suporta um
/// fluxo de aprovacao simples (status) e vinculo opcional a um Attachment
/// ja existente (comprovante) -- sem upload de arquivo nesta fase.
model TripExpense {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  tripId         String                @map("trip_id") @db.Uuid
  driverId       String?               @map("driver_id") @db.Uuid
  vehicleId      String?               @map("vehicle_id") @db.Uuid
  category       ExpenseCategory
  description    String
  supplier       String?
  documentNumber String?               @map("document_number")
  expenseDate    DateTime              @map("expense_date")
  amount         Decimal               @db.Decimal(10, 2)
  currency       String                @default("BRL") @db.VarChar(3)
  paymentMethod  ExpensePaymentMethod? @map("payment_method")
  status         ExpenseStatus         @default(PENDING)
  /// Quem tomou a decisao (aprovou OU rejeitou) -- preenchido em ambos os
  /// casos, ja que nao ha um par rejectedBy/rejectedAt dedicado; a decisao
  /// exata fica registrada no AuditLog da acao.
  approvedBy     String?               @map("approved_by") @db.Uuid
  approvedAt     DateTime?             @map("approved_at")
  attachmentId   String?               @map("attachment_id") @db.Uuid
  createdBy      String                @map("created_by") @db.Uuid
  updatedBy      String?               @map("updated_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip       Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver     Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  attachment Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  approver   UserAccount? @relation("TripExpenseApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  creator    UserAccount  @relation("TripExpenseCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater    UserAccount? @relation("TripExpenseUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, driverId])
  @@index([tenantId, vehicleId])
  @@map("trip_expenses")
}

/// Receita da viagem (frete, bonificacao, servico extra, seguro -- Fase 17).
/// Toda receita pertence obrigatoriamente a uma Trip do mesmo tenant.
model TripRevenue {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  tripId        String          @map("trip_id") @db.Uuid
  description   String
  category      RevenueCategory
  /// Nunca negativo -- validado tambem no DTO (@Min(0)).
  amount        Decimal         @db.Decimal(10, 2)
  receivedAt    DateTime        @map("received_at")
  invoiceNumber String?         @map("invoice_number")
  customerId    String?         @map("customer_id") @db.Uuid
  attachmentId  String?         @map("attachment_id") @db.Uuid
  createdBy     String          @map("created_by") @db.Uuid
  updatedBy     String?         @map("updated_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip       Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  attachment Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  creator    UserAccount  @relation("TripRevenueCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater    UserAccount? @relation("TripRevenueUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@index([tenantId, category])
  @@index([tenantId, customerId])
  @@map("trip_revenues")
}

/// Adiantamento pago ao motorista durante a viagem (Fase 17). driverId e
/// SEMPRE derivado da Trip (nunca aceito do cliente) -- mesmo principio ja
/// aplicado em TripExpense/TollTransaction.
model TripAdvance {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  tripId        String                @map("trip_id") @db.Uuid
  driverId      String                @map("driver_id") @db.Uuid
  description   String
  /// Sempre positivo -- validado tambem no DTO (@IsPositive).
  amount        Decimal               @db.Decimal(10, 2)
  paymentMethod ExpensePaymentMethod? @map("payment_method")
  paidAt        DateTime              @map("paid_at")
  attachmentId  String?               @map("attachment_id") @db.Uuid
  createdBy     String                @map("created_by") @db.Uuid
  updatedBy     String?               @map("updated_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip       Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver     Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  attachment Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  creator    UserAccount  @relation("TripAdvanceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater    UserAccount? @relation("TripAdvanceUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@index([tenantId, driverId])
  @@map("trip_advances")
}

/// Comparativo planejado x executado -- o maior diferencial do sistema.
/// 1:1 com Trip, concentra as metricas de planejamento e de execucao real
/// num so lugar para consultas de inteligencia operacional.
model TripMetrics {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tripId   String @unique @map("trip_id") @db.Uuid

  plannedDistanceKm  Decimal? @map("planned_distance_km") @db.Decimal(10, 2)
  plannedDurationMin Int?     @map("planned_duration_min")
  plannedFuelLiters  Decimal? @map("planned_fuel_liters") @db.Decimal(10, 2)
  plannedTollAmount  Decimal? @map("planned_toll_amount") @db.Decimal(10, 2)
  plannedTotalCost   Decimal? @map("planned_total_cost") @db.Decimal(10, 2)

  actualDistanceKm  Decimal? @map("actual_distance_km") @db.Decimal(10, 2)
  actualDurationMin Int?     @map("actual_duration_min")
  actualFuelLiters  Decimal? @map("actual_fuel_liters") @db.Decimal(10, 2)
  actualTollAmount  Decimal? @map("actual_toll_amount") @db.Decimal(10, 2)
  actualTotalCost   Decimal? @map("actual_total_cost") @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("trip_metrics")
}

/// Fechamento financeiro da viagem (Fase 17) -- 1:1 com Trip, criado (lazy)
/// apenas quando a viagem e fechada pela primeira vez. Os totais sao um
/// SNAPSHOT calculado no momento do fechamento (nao recalculado ao vivo);
/// reabrir (REOPENED) altera apenas o status, nunca apaga o snapshot
/// anterior -- fechar novamente depois de reaberto recalcula os totais.
model TripSettlement {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  tripId        String           @unique @map("trip_id") @db.Uuid
  totalRevenue  Decimal          @default(0) @map("total_revenue") @db.Decimal(12, 2)
  totalExpenses Decimal          @default(0) @map("total_expenses") @db.Decimal(12, 2)
  totalAdvances Decimal          @default(0) @map("total_advances") @db.Decimal(12, 2)
  /// totalRevenue - totalExpenses - totalAdvances -- pode ser negativo
  /// (prejuizo); nunca bloqueia o fechamento.
  netResult     Decimal          @default(0) @map("net_result") @db.Decimal(12, 2)
  status        SettlementStatus @default(OPEN)
  closedBy      String?          @map("closed_by") @db.Uuid
  closedAt      DateTime?        @map("closed_at")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip   Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  closer UserAccount? @relation("TripSettlementCloser", fields: [closedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("trip_settlements")
}

// ============================================================================
// DOCUMENTOS E ANEXOS — genericos, polimorficos
// ============================================================================

/// Documento formal (CRLV, ANTT, CNH, licenciamento, seguro). Dono
/// polimorfico -- pode pertencer a um veiculo, trailer, motorista ou tenant.
model Document {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  type      DocumentType
  ownerType DocumentOwnerType @map("owner_type")
  ownerId   String            @map("owner_id") @db.Uuid
  number    String?
  issuedAt  DateTime?         @map("issued_at")
  expiresAt DateTime?         @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([tenantId, ownerType, ownerId])
  @@index([expiresAt])
  @@map("documents")
}

/// Arquivo anexavel a qualquer entidade (foto do caminhao, da carga, da
/// nota, do pedagio, comprovante). entityName + entityId sao polimorficos,
/// mesmo padrao do ExternalReference. documentId e opcional -- usado quando
/// o anexo e o arquivo de um Document.
model Attachment {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  documentId   String?        @map("document_id") @db.Uuid
  entityName   String         @map("entity_name") // ex: "Trip", "TollTransaction"
  entityId     String         @map("entity_id") @db.Uuid
  type         AttachmentType @default(OTHER)
  storageKey   String         @map("storage_key")
  uploadedById String?        @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document     Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  tripExpenses TripExpense[]
  tripRevenues TripRevenue[]
  tripAdvances TripAdvance[]
  fuelSupplies FuelSupply[]

  @@index([tenantId, entityName, entityId])
  @@map("attachments")
}

// ============================================================================
// INTEGRACOES FUTURAS — mapeamento generico, sem acoplar a nenhum sistema
// ============================================================================

/// Mapeamento generico entre uma entidade interna e sua referencia num
/// sistema externo (TMS, ERP, telemetria, concessionaria de pedagio). Evita
/// criar uma tabela de integracao especifica a cada novo sistema.
model ExternalReference {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  entityName     String         @map("entity_name")
  entityId       String         @map("entity_id") @db.Uuid
  externalSystem ExternalSystem @map("external_system")
  externalId     String         @map("external_id")
  lastSyncedAt   DateTime?      @map("last_synced_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([externalSystem, externalId])
  @@index([tenantId, entityName, entityId])
  @@map("external_references")
}

