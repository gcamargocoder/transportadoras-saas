enum TollTransactionStatus {
  NORMAL
  DIVERGENT
  EXEMPT

  @@map("toll_transaction_status")
}

/// Formato do arquivo de extrato importado (Fase 15). XML/TXT/API_INTEGRATION
/// ja modelados para permitir suporte futuro sem alterar o restante do
/// sistema -- apenas CSV/XLSX sao aceitos pelo upload nesta fase.
enum ImportFileType {
  CSV
  XLSX
  XML
  TXT
  API_INTEGRATION

  @@map("import_file_type")
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS

  @@map("import_job_status")
}

/// Motivo pelo qual uma linha do extrato NAO virou TollTransaction --
/// alimenta ImportJobError (ver GET /toll-import/:id/errors).
enum ImportRowIssueType {
  VALIDATION_ERROR
  DUPLICATE

  @@map("import_row_issue_type")
}

enum TollAuditStatus {
  OK
  DISCREPANCY
  PENDING

