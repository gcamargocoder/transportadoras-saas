enum TireStatus {
  NEW
  IN_USE
  STOCK
  RETREADED
  SCRAPPED

  @@map("tire_status")
}

enum TireLocationType {
  STOCK
  VEHICLE
  TRAILER

  @@map("tire_location_type")
}

enum TrailerType {
  SIMPLE
  BITREM
  RODOTREM
  VANDERLEIA
  FULL_TRAILER
  SEMI_TRAILER
  DOLLY
  OTHER

  @@map("trailer_type")
}

enum TripStatus {
  PLANNED
  WAITING_DRIVER
  WAITING_DEPARTURE
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED

  @@map("trip_status")
}

enum TripPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("trip_priority")
