// ============================================================================
// Transportadoras SaaS — Modelagem fisica do banco de dados
// ============================================================================
// Este arquivo contem APENAS a modelagem de dados (schema Prisma).
// Nenhuma logica de negocio, API ou validacao de aplicacao esta implementada
// aqui -- isso pertence a camada de servico (apps/api), nao ao schema.
//
// Convencoes adotadas:
// - snake_case no banco (via @@map/@map), camelCase no client Prisma
// - toda tabela operacional carrega tenant_id para isolamento multi-tenant
//   (reforcado por Row-Level Security no Postgres, fora do escopo do Prisma)
// - TollPlaza, TollRate e TagProvider sao dados de referencia GLOBAIS
//   (nao carregam tenant_id): sao compartilhados entre todas as transportadoras
// - Document e Attachment sao polimorficos por design (owner_type/entity_name
//   + id) para nao exigir nova tabela a cada novo tipo de arquivo
// - Colunas geoespaciais (geometry/geography) usam Unsupported(), porque o
//   Prisma nao tem tipo nativo para PostGIS -- a extensao ja esta habilitada
//   no datasource abaixo
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
  DISPATCHER
  AUDITOR
  DRIVER

  @@map("user_role")
}

enum FleetType {
  OWN
  AGGREGATED
  OUTSOURCED

  @@map("fleet_type")
}

enum VehicleType {
  TRACTOR_UNIT
  TRUCK
  VAN
  PICKUP
  OTHER

  @@map("vehicle_type")
}

/// Situacao operacional do veiculo -- distinta de deletedAt (exclusao
/// logica): um veiculo SOLD/MAINTENANCE ainda e um registro valido e
/// consultavel, apenas nao esta disponivel para uso.
enum VehicleStatus {
  ACTIVE
  INACTIVE
  /// Fase 62 -- impedimento temporario de operar (ex: pendencia documental,
  /// decisao administrativa), distinto de MAINTENANCE (fisicamente em
  /// oficina) e INACTIVE (desativado). TripsService.startTrip ja bloqueia
  /// qualquer status != ACTIVE ("veiculo inativo") -- SUSPENDED e coberto
  /// automaticamente, sem alterar essa validacao central.
  SUSPENDED
  MAINTENANCE
  SOLD

  @@map("vehicle_status")
}

/// Fase 62 -- classificacao de propriedade do veiculo, mesmo espirito de
/// DriverType (Fase 61): nomenclatura identica (OWN/AGGREGATED/THIRD_PARTY)
/// para consistencia entre motorista e veiculo.
enum VehicleOwnershipType {
  OWN
  AGGREGATED
  THIRD_PARTY

  @@map("vehicle_ownership_type")
}

enum VehicleFuelType {
  DIESEL
  DIESEL_S10
  GASOLINE
  ETHANOL
  FLEX
  ELECTRIC
  HYBRID
  GNV
  OTHER

  @@map("vehicle_fuel_type")
}

/// Combustivel efetivamente abastecido em um FuelSupply (Fase 18) --
/// DISTINTO de VehicleFuelType (especificacao do veiculo): um veiculo FLEX
/// pode abastecer GASOLINA numa vez e ETANOL noutra, e ARLA32 (fluido de
/// arrefecimento de motores diesel) nao e um combustivel de especificacao
/// de veiculo. Nomenclatura em pt-BR de proposito (granularidade de posto
/// de combustivel real: S10/S500, nao apenas "DIESEL").
enum FuelType {
  DIESEL_S10
  DIESEL_S500
  GASOLINA
  ETANOL
  ARLA32
  OUTRO

  @@map("fuel_type")
}

/// Forma de pagamento do abastecimento -- DISTINTO de ExpensePaymentMethod
/// (Fase 16): FLEET_CARD (cartao frota, o meio mais comum de pagamento de
/// combustivel) e INVOICE (fatura do posto) nao existem la, e nao ha
/// separacao CREDIT/DEBIT aqui.
enum PaymentType {
  CASH
  PIX
  CARD
  INVOICE
  FLEET_CARD
  OTHER

  @@map("payment_type")
}

enum VehicleMaintenanceStatus {
  OPEN
  /// Fase 82 -- diagnostico tecnico em andamento (Ordem de Servico).
  DIAGNOSING
  /// Fase 82 -- diagnostico concluido, aguardando aprovacao do orcamento.
  AWAITING_APPROVAL
  /// Fase 82 -- orcamento aprovado, ainda nao iniciada a execucao.
  APPROVED
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED

  @@map("vehicle_maintenance_status")
}

enum VehicleMaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  EMERGENCY
  OTHER

  @@map("vehicle_maintenance_type")
}

enum VehicleMaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("vehicle_maintenance_priority")
}

/// Catalogo de componentes/itens de manutencao (Fase 45) -- rotulagem
/// estruturada para permitir agregacao (custo/ocorrencias por componente),
/// distinta de description/notes (texto livre, nunca usado para agregar).
/// Enum (nao tabela) por consistencia com o padrao ja usado no projeto para
/// catalogos fixos (ExpenseCategory, TripStopType etc.).
enum MaintenanceComponent {
  ENGINE
  TRANSMISSION
  DIFFERENTIAL
  BRAKES
  SUSPENSION
  CLUTCH
  TIRES
  COOLING
  ELECTRICAL
  ARLA
  FILTERS
  ENGINE_OIL
  TRANSMISSION_OIL
  DIFFERENTIAL_OIL
  DIESEL_FILTER
  AIR_FILTER
  OIL_FILTER
  BATTERY
  SPRINGS
  SHOCK_ABSORBERS
  SIDER
  TRAILER
  OTHER

  @@map("maintenance_component")
}

/// Estado do ciclo de vida do pneu (Fase 20) -- distinto de TireLocationType
/// (ONDE o pneu esta fisicamente agora). RETREADED e setado automaticamente
/// ao registrar uma recapagem; SCRAPPED ao registrar um descarte.
enum TireStatus {
  NEW
  IN_USE
  STOCK
  RETREADED
  SCRAPPED

  @@map("tire_status")
}

enum TireLocationType {
  STOCK
  VEHICLE
  TRAILER

  @@map("tire_location_type")
}

enum TrailerType {
  SIMPLE
  BITREM
  RODOTREM
  VANDERLEIA
  FULL_TRAILER
  SEMI_TRAILER
  DOLLY
  OTHER

  @@map("trailer_type")
}

enum TripStatus {
  PLANNED
  WAITING_DRIVER
  WAITING_DEPARTURE
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED

  @@map("trip_status")
}

enum TripPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("trip_priority")
}

enum RouteVersionReason {
  INITIAL
  DEVIATION
  ACCIDENT
  ROADWORK
  INTERDICTION
  DESTINATION_CHANGE
  /// Fase 89 -- sugestao de sequencia de paradas/entregas (TripDeliveryStop)
  /// aplicada explicitamente pelo usuario. Nunca criada automaticamente.
  STOP_RESEQUENCE

  @@map("route_version_reason")
}

enum RouteEventType {
  DEVIATION
  ACCIDENT
  ROADWORK
  INTERDICTION
  DESTINATION_CHANGE

  @@map("route_event_type")
}

enum AlertType {
  ROUTE_DEVIATION
  TOLL_DISCREPANCY
  DELAY
  ROUTE_EVENT
  DOCUMENT_EXPIRING
  OTHER

  @@map("alert_type")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("alert_severity")
}

enum NotificationChannel {
  PUSH
  EMAIL
  WHATSAPP
  SMS

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

enum TollTransactionSource {
  INTEGRATION
  MANUAL

  @@map("toll_transaction_source")
}

/// Classificacao automatica da transacao (valor cobrado vs. calculado pela
/// formula pricePerAxle * axleCount) -- ver TollTransactionsService.
enum TollTransactionStatus {
  NORMAL
  DIVERGENT
  EXEMPT

  @@map("toll_transaction_status")
}

/// Formato do arquivo de extrato importado (Fase 15). XML/TXT/API_INTEGRATION
/// ja modelados para permitir suporte futuro sem alterar o restante do
/// sistema -- apenas CSV/XLSX sao aceitos pelo upload nesta fase.
enum ImportFileType {
  CSV
  XLSX
  XML
  TXT
  API_INTEGRATION

  @@map("import_file_type")
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS

  @@map("import_job_status")
}

/// Motivo pelo qual uma linha do extrato NAO virou TollTransaction --
/// alimenta ImportJobError (ver GET /toll-import/:id/errors).
enum ImportRowIssueType {
  VALIDATION_ERROR
  DUPLICATE

  @@map("import_row_issue_type")
}

enum TollAuditStatus {
  OK
  DISCREPANCY
  PENDING

  @@map("toll_audit_status")
}

/// Categoria da despesa de viagem (Fase 16). TOLL_EXTRA cobre pedagio pago
/// fora do fluxo de tag/TollTransaction (ex: reembolso avulso) -- a fonte de
/// verdade do pedagio via tag continua sendo TollTransaction.
enum ExpenseCategory {
  FUEL
  FOOD
  HOTEL
  TOLL_EXTRA
  MAINTENANCE
  TIRES
  PARKING
  WASH
  ADVANCE
  FINE
  OTHER

  @@map("expense_category")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("expense_status")
}

enum ExpensePaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BANK_TRANSFER
  COMPANY_ACCOUNT
  OTHER

  @@map("expense_payment_method")
}

enum RevenueCategory {
  FREIGHT
  BONUS
  EXTRA_SERVICE
  INSURANCE
  OTHER

  @@map("revenue_category")
}

/// Estado do fechamento financeiro da viagem (Fase 17). REOPENED e distinto
/// de OPEN -- OPEN nunca foi fechado; REOPENED ja foi fechado ao menos uma
/// vez e foi reaberto (o historico do fechamento anterior nunca e apagado,
/// apenas sobrescrito no proximo fechamento).
enum SettlementStatus {
  OPEN
  CLOSED
  REOPENED

  @@map("settlement_status")
}

enum LocationType {
  FACTORY
  DISTRIBUTION_CENTER
  PORT
  TERMINAL
  CUSTOMER_SITE
  BRANCH
  OTHER

  @@map("location_type")
}

enum DocumentType {
  CRLV
  ANTT
  CNH
  MEDICAL_EXAM
  MOPP
  LICENSING
  INSURANCE
  OTHER

  @@map("document_type")
}

enum DocumentOwnerType {
  VEHICLE
  TRAILER
  DRIVER
  TENANT

  @@map("document_owner_type")
}

enum AttachmentType {
  PHOTO_VEHICLE
  PHOTO_CARGO
  PHOTO_INVOICE
  PHOTO_TOLL
  RECEIPT
  OTHER

  @@map("attachment_type")
}

enum ExternalSystem {
  TMS
  ERP
  TELEMETRY_PROVIDER
  TOLL_OPERATOR

  @@map("external_system")
}

/// Classificacao da parada operacional (Fase 25, catalogo ampliado na Fase
/// 43). UNKNOWN e o padrao quando o app apenas detecta "veiculo parado" via
/// GPS -- a classificacao real pode ser feita pelo motorista depois, sem
/// bloquear o registro da parada. Agrupamento de apresentacao (OPERACIONAL/
/// VEICULO/TRANSITO/MOTORISTA/ADMINISTRATIVO/OUTROS) fica em
/// fleet-operations/constants (nao e uma coluna -- e so rotulagem de UI).
enum TripStopType {
  UNKNOWN
  FUEL
  REST
  MEAL
  MAINTENANCE
  OTHER
  // Fase 43 -- OPERACIONAL
  LOADING
  UNLOADING
  WAITING_LOADING
  WAITING_UNLOADING
  YARD
  CUSTOMER
  GARAGE
  // Fase 43 -- VEICULO
  BREAKDOWN
  TIRE
  // Fase 43 -- TRANSITO
  CONGESTION
  ACCIDENT
  ROAD_CLOSURE
  INSPECTION
  // Fase 43 -- MOTORISTA
  PERSONAL_NEED
  // Fase 43 -- ADMINISTRATIVO
  DOCUMENTATION
  WAITING_AUTHORIZATION

  @@map("trip_stop_type")
}

/// Origem do registro da parada (Fase 43). DRIVER_APP/GPS sao os unicos
/// fluxos reais hoje (StopsScreen e useLocationTracker, respectivamente --
/// ambos ja existiam antes desta fase, so nao eram distinguiveis). ADMIN e
/// gravado pelo backend quando criado via POST /trip-stops (nunca aceito do
/// cliente). MANUAL/SYSTEM/IMPORT ficam definidos para evolucao futura
/// (fechamento automatico ao concluir viagem, importacao de dados externos)
/// -- documentados como NAO utilizados nesta fase, nunca um fluxo fake so
/// pra "existir".
enum TripStopSource {
  MANUAL
  DRIVER_APP
  GPS
  SYSTEM
  IMPORT
  ADMIN

  @@map("trip_stop_source")
}

/// Origem do numero de eixos DECLARADO num AxleEvent -- DRIVER_INPUT quando o
/// motorista respondeu ao alerta de pedagio, TIMEOUT_DEFAULT quando nao
/// respondeu e o sistema assumiu a configuracao padrao automaticamente.
enum AxleEventSource {
  DRIVER_INPUT
  TIMEOUT_DEFAULT

  @@map("axle_event_source")
}

/// Estado de sincronizacao de um evento operacional gerado pelo app do
/// motorista (Fase 25). Registros so existem no backend depois de
/// sincronizados -- PENDING/FAILED sao principalmente estados do lado do
/// dispositivo (fila local), mantidos aqui para o campo nunca ficar
/// inconsistente com o que a fase pede.
enum SyncStatus {
  PENDING
  SYNCED
  FAILED

  @@map("sync_status")
}

/// Estado da carga no inicio da viagem (Fase 27) -- informado uma vez pelo
/// motorista na tela de largada, nunca inferido/alterado automaticamente.
enum TripLoadStatus {
  LOADED
  EMPTY

  @@map("trip_load_status")
}

// ============================================================================
// PLATAFORMA — tenant, usuarios, configuracoes, auditoria geral
// ============================================================================

/// Status de ciclo de vida da transportadora na plataforma (Fase 47,
/// Super Administracao) -- mais rico que o `isActive` booleano ja
/// existente (mantido, nunca removido). Sincronizado numa via so
/// (status -> isActive) pelo TenantsService: ACTIVE/TRIAL sempre deixam
/// isActive=true; SUSPENDED/EXPIRED sempre deixam isActive=false. O
/// TenantGuard (bloqueio de acesso) continua usando so isActive, nunca
/// duplicando a logica de bloqueio para o status novo.
enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  EXPIRED
}

/// Nivel de plano SaaS (Fase 47) -- estrutura inicial, sem cobranca/Stripe
/// nesta fase. Nomes genericos, ajustaveis livremente depois (nao sao
/// valores comerciais definitivos).
enum TenantPlanTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

/// Modulos funcionais que podem ser habilitados/desabilitados por
/// transportadora (Fase 47). Estrutura preparada para o sistema consultar
/// "este tenant tem X habilitado?" -- nesta fase NENHUM controller
/// existente consulta isso ainda (nunca bloqueia funcionalidade already
/// em uso), ver TenantModule util.
enum TenantModule {
  TRIPS
  TOLLS
  FUEL
  MAINTENANCE
  TIRES
  CHECKLIST
  STOPS
  DASHBOARDS
  REPORTS
  /// Fase 59 -- gestao de fretes, contratos e tabelas de frete.
  FREIGHT
}

/// Transportadora — raiz do isolamento multi-tenant. Toda tabela operacional
/// referencia Tenant direta ou indiretamente.
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  /// Razao social.
  name      String
  /// Nome fantasia (opcional -- nem toda transportadora usa um).
  tradeName String?      @map("trade_name")
  document  String       @unique @map("document") @db.VarChar(20) // CNPJ
  /// Identificador amigavel/URL-safe, unico. Ainda nao usado para roteamento
  /// (sem subdominio nesta fase) -- preparado para resolucao futura de tenant
  /// por subdominio/dominio personalizado (ex: "acme" em acme.app.com).
  slug      String       @unique
  /// URL do logotipo da empresa. Upload de arquivo fica para fase futura --
  /// aqui e apenas a referencia (ex: URL de um storage externo).
  logoUrl   String?      @map("logo_url")
  isActive  Boolean      @default(true) @map("is_active")
  /// Fase 47 -- ver comentario do enum TenantStatus.
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  settings                  TenantSettings?
  plan                      TenantPlan?
  /// Fase 50 -- relacao comercial (assinatura/cobranca), distinta de
  /// TenantPlan (que governa modulos/limites).
  subscription              TenantSubscription?
  subscriptionPayments      SubscriptionPayment[]
  users                     UserAccount[]
  fleets                    Fleet[]
  vehicles                  Vehicle[]
  trailers                  Trailer[]
  drivers                   Driver[]
  customers                 Customer[]
  locations                 Location[]
  trips                     Trip[]
  vehicleTags               VehicleTag[]
  vehicleMaintenances       VehicleMaintenance[]
  maintenancePlans          MaintenancePlan[]
  documents                 Document[]
  attachments               Attachment[]
  externalReferences        ExternalReference[]
  auditLogs                 AuditLog[]
  tripCompositions          TripComposition[]
  tripCompositionTrailers   TripCompositionTrailer[]
  axleConfigurations        AxleConfiguration[]
  routeVersions             RouteVersion[]
  routeEvents               RouteEvent[]
  routePlans                RoutePlan[]
  routePlanTolls            RoutePlanToll[]
  trackingPoints            TrackingPoint[]
  tripStops                 TripStop[]
  axleEvents                AxleEvent[]
  alerts                    Alert[]
  notifications             Notification[]
  telemetry                 Telemetry[]
  tripExpenses              TripExpense[]
  tripRevenues              TripRevenue[]
  tripAdvances              TripAdvance[]
  tripSettlements           TripSettlement[]
  tripMetrics               TripMetrics[]
  driverShifts              DriverShift[]
  tripOccurrences           TripOccurrence[]
  tollTransactions          TollTransaction[]
  tollAudits                TollAudit[]
  tollRoutes                TollRoute[]
  tollRouteStops            TollRouteStop[]
  importJobs                ImportJob[]
  importJobErrors           ImportJobError[]
  fuelStations              FuelStation[]
  fuelSupplies              FuelSupply[]
  tires                     Tire[]
  tireMovements             TireMovement[]
  tireRetreads              TireRetread[]
  tireInspections           TireInspection[]
  tireDisposals             TireDisposal[]
  checklistTemplates        ChecklistTemplate[]
  checklistExecutions       ChecklistExecution[]
  checklistEvidence         ChecklistEvidence[]
  fiscalDocuments           FiscalDocument[]
  /// Fase 59 -- gestao de fretes, contratos e tabelas de frete.
  contracts                 Contract[]
  freightTables             FreightTable[]
  freightRules              FreightRule[]
  tripFreights              TripFreight[]
  /// Fase 60 -- faturamento operacional.
  tripBillings              TripBilling[]
  tripBillingEntries        TripBillingEntry[]
  /// Fase 72 -- contas a receber (titulos gerados a partir do faturamento).
  receivables               Receivable[]
  receivablePayments        ReceivablePayment[]
  /// Fase 73 -- contas a pagar (titulos gerados a partir das despesas).
  payables                  Payable[]
  payablePayments           PayablePayment[]
  /// Fase 61 -- motoristas, agregados e terceiros.
  driverVehicleAssignments  DriverVehicleAssignment[]
  /// Fase 76 -- controle de periodo financeiro (fechamento/competencia).
  financialPeriods          FinancialPeriod[]
  /// Fase 78 -- contas financeiras (bancarias/caixa) e suas movimentacoes.
  financialAccounts         FinancialAccount[]
  financialTransactions     FinancialTransaction[]
  /// Fase 80 -- conciliacao bancaria (movimentacoes externas importadas).
  financialBankTransactions FinancialBankTransaction[]
  /// Fase 83 -- catalogo de pecas e ledger de estoque.
  parts                     Part[]
  partStockMovements        PartStockMovement[]
  /// Fase 84 -- oficinas/fornecedores de manutencao.
  maintenanceProviders      MaintenanceProvider[]
  /// Fase 88 -- paradas/entregas planejadas de viagens multi-entrega.
  tripDeliveryStops         TripDeliveryStop[]
  /// Fase 93 -- CRM: contatos e observacoes comerciais de clientes.
  customerContacts          CustomerContact[]
  customerNotes             CustomerNote[]
  /// Fase 94 -- Cotacoes.
  quotations                Quotation[]
  /// Fase 95 -- Propostas.
  proposals                 Proposal[]
  /// Fase 96 -- Pipeline Comercial.
  pipelineStages            PipelineStage[]
  pipelineOpportunities     PipelineOpportunity[]
  /// Fase 98 -- Renovacao de Contratos.
  contractRenewals          ContractRenewal[]

  @@map("tenants")
}

/// Configuracoes operacionais da transportadora. 1:1 com Tenant, separado
/// para nao poluir a tabela principal com colunas de configuracao.
model TenantSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  tenantId                  String   @unique @map("tenant_id") @db.Uuid
  maxDeviationMeters        Int      @default(500) @map("max_deviation_meters")
  gpsPingIntervalSeconds    Int      @default(30) @map("gps_ping_interval_seconds")
  alertDelayThresholdMin    Int      @default(15) @map("alert_delay_threshold_min")
  /// Minutos parado (dentro de stopRadiusMeters) para o app do motorista
  /// considerar "parada detectada" (Fase 25) -- configuravel por tenant.
  stopDetectionMinutes      Int      @default(10) @map("stop_detection_minutes")
  /// Raio (metros) considerado "mesma regiao" para deteccao de parada.
  stopRadiusMeters          Int      @default(150) @map("stop_radius_meters")
  /// Raio (metros) a partir do qual o app do motorista mostra o alerta de
  /// praca de pedagio proxima (Fase 25).
  tollProximityRadiusMeters Int      @default(3000) @map("toll_proximity_radius_meters")
  /// Minutos consecutivos fora da rota planejada (alem de maxDeviationMeters)
  /// para confirmar um desvio sustentado (Fase 26) -- evita alertar por um
  /// unico ponto de GPS ruidoso. Reaproveita maxDeviationMeters (ja existente,
  /// ate entao nao consumido por nenhum codigo) para o limite de distancia.
  routeDeviationMinutes     Int      @default(5) @map("route_deviation_minutes")
  timezone                  String   @default("America/Sao_Paulo")
  currency                  String   @default("BRL") @db.VarChar(3)
  language                  String   @default("pt-BR") @map("language")
  preferences               Json?    @default("{}")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Plano SaaS da transportadora (Fase 47, Super Administracao). 1:1 com
/// Tenant, mesmo padrao de TenantSettings -- separado para nao poluir a
/// tabela principal. Sem cobranca/Stripe nesta fase -- so estrutura
/// (tier/trial/limites/modulos). Limites nulos = sem limite (nunca um
/// numero comercial inventado por padrao).
model TenantPlan {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @unique @map("tenant_id") @db.Uuid
  tier           TenantPlanTier @default(STARTER)
  /// Fase 49 -- data de inicio do trial (preenchida na 1a transicao para
  /// TRIAL, nunca sobrescrita depois -- preserva historico mesmo que o
  /// tenant saia e volte para TRIAL ou tenha o status alterado manualmente).
  trialStartedAt DateTime?      @map("trial_started_at")
  /// Preenchido quando o tenant esta (ou esteve) em trial. Fase 49 -- usado
  /// pelo scheduler de expiracao automatica (TRIAL -> EXPIRED quando
  /// trialEndsAt < agora); antes so era editavel manualmente pelo SUPER_ADMIN.
  trialEndsAt    DateTime?      @map("trial_ends_at")
  /// Limites configuraveis por tenant. null = sem limite.
  maxUsers       Int?           @map("max_users")
  maxVehicles    Int?           @map("max_vehicles")
  maxDrivers     Int?           @map("max_drivers")
  maxStorageMb   Int?           @map("max_storage_mb")
  /// Modulos habilitados -- default = todos (nunca bloqueia modulo ja em
  /// uso por um tenant existente).
  enabledModules TenantModule[] @default([TRIPS, TOLLS, FUEL, MAINTENANCE, TIRES, CHECKLIST, STOPS, DASHBOARDS, REPORTS, FREIGHT]) @map("enabled_modules")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_plans")
}

// ============================================================================
// ASSINATURA E COBRANCA (Fase 50) -- relacao COMERCIAL (quanto/quando/como o
// tenant paga), deliberadamente separada de TenantPlan (que continua sendo a
// UNICA fonte de modulos/limites/enforcement, intocado nesta fase). Cobranca
// e 100% MANUAL nesta fase -- sem Stripe/gateway/webhook real, so campos
// opcionais preparados para integracao futura.
// ============================================================================

enum SubscriptionStatus {
  ACTIVE
  PENDING
  OVERDUE
  SUSPENDED
  CANCELLED
}

enum SubscriptionPaymentMethod {
  PIX_SCHEDULED
  DIRECT_DEBIT
  /// Preparado para uso futuro -- nenhuma integracao real nesta fase.
  STRIPE
}

enum BillingPeriodicity {
  MONTHLY
  YEARLY
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

/// 1:1 com Tenant. planTier reaproveita o MESMO enum TenantPlanTier de
/// TenantPlan (nunca um enum paralelo) mas representa o tier COMERCIAL
/// (o que esta sendo cobrado) -- pode divergir do TenantPlan.tier atual
/// (ex: upgrade de features acordado antes do upgrade comercial formal),
/// nunca sincronizado automaticamente entre os dois.
model TenantSubscription {
  id                     String                    @id @default(uuid()) @db.Uuid
  tenantId               String                    @unique @map("tenant_id") @db.Uuid
  planTier               TenantPlanTier            @map("plan_tier")
  amount                 Decimal                   @db.Decimal(10, 2)
  periodicity            BillingPeriodicity
  paymentMethod          SubscriptionPaymentMethod @map("payment_method")
  startDate              DateTime                  @map("start_date")
  /// Dia do mes de vencimento (1-31), usado pelo calculo de proximo
  /// vencimento (billing-date.util.ts) -- nunca calculado no frontend.
  dueDay                 Int                       @map("due_day")
  nextDueDate            DateTime                  @map("next_due_date")
  status                 SubscriptionStatus        @default(PENDING)
  notes                  String?                   @db.Text
  /// Preparacao Stripe (Fase 50, secao 12) -- nunca lidos/escritos por
  /// nenhum codigo nesta fase, so reservam o campo para integracao futura.
  externalCustomerId     String?                   @map("external_customer_id")
  externalSubscriptionId String?                   @map("external_subscription_id")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments SubscriptionPayment[]

  @@index([status])
  @@index([nextDueDate])
  @@map("tenant_subscriptions")
}

/// Historico de pagamentos -- registro IMUTAVEL (ledger). Deliberadamente
/// SEM updatedAt e sem nenhum endpoint de update/delete: cada acao gera uma
/// linha NOVA, nunca altera uma existente (pedido explicito: nao alterar
/// retroativamente, nao permitir apagar historico financeiro).
model SubscriptionPayment {
  id                String                    @id @default(uuid()) @db.Uuid
  tenantId          String                    @map("tenant_id") @db.Uuid
  subscriptionId    String                    @map("subscription_id") @db.Uuid
  amount            Decimal                   @db.Decimal(10, 2)
  dueDate           DateTime                  @map("due_date")
  paidAt            DateTime?                 @map("paid_at")
  paymentMethod     SubscriptionPaymentMethod @map("payment_method")
  status            SubscriptionPaymentStatus @default(PENDING)
  reference         String?                   @db.Text
  /// Preparacao Stripe -- nunca lido/escrito nesta fase.
  externalPaymentId String?                   @map("external_payment_id")
  createdBy         String                    @map("created_by") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  creator      UserAccount        @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@map("subscription_payments")
}

/// Conta de usuario da plataforma (admin, operador/despachante). Motoristas
/// podem opcionalmente ter uma UserAccount vinculada para login no app --
/// ver Driver.userAccountId.
model UserAccount {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  email        String
  passwordHash String    @map("password_hash")
  role         UserRole  @default(OPERATOR)
  isActive     Boolean   @default(true) @map("is_active")
  /// Exclusao logica (distinta de isActive: usuario desativado pode ser
  /// reativado; usuario excluido nao aparece mais em nenhuma listagem).
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant                          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverProfile                   Driver?
  auditLogs                       AuditLog[]
  acknowledgedAlerts              Alert[]                   @relation("AlertAcknowledgedBy")
  notifications                   Notification[]
  refreshTokens                   RefreshToken[]
  vehicleMaintenancesResponsible  VehicleMaintenance[]
  importJobsCreated               ImportJob[]
  tripExpensesCreated             TripExpense[]             @relation("TripExpenseCreator")
  tripExpensesUpdated             TripExpense[]             @relation("TripExpenseUpdater")
  tripExpensesApproved            TripExpense[]             @relation("TripExpenseApprover")
  tripRevenuesCreated             TripRevenue[]             @relation("TripRevenueCreator")
  tripRevenuesUpdated             TripRevenue[]             @relation("TripRevenueUpdater")
  tripAdvancesCreated             TripAdvance[]             @relation("TripAdvanceCreator")
  tripAdvancesUpdated             TripAdvance[]             @relation("TripAdvanceUpdater")
  tripSettlementsClosed           TripSettlement[]          @relation("TripSettlementCloser")
  fuelSuppliesCreated             FuelSupply[]              @relation("FuelSupplyCreator")
  fuelSuppliesUpdated             FuelSupply[]              @relation("FuelSupplyUpdater")
  tiresCreated                    Tire[]                    @relation("TireCreator")
  tiresUpdated                    Tire[]                    @relation("TireUpdater")
  tireMovementsCreated            TireMovement[]            @relation("TireMovementCreator")
  tireRetreadsCreated             TireRetread[]             @relation("TireRetreadCreator")
  tireInspectionsCreated          TireInspection[]          @relation("TireInspectionCreator")
  tireDisposalsCreated            TireDisposal[]            @relation("TireDisposalCreator")
  partsCreated                    Part[]                    @relation("PartCreator")
  partStockMovementsCreated       PartStockMovement[]       @relation("PartStockMovementCreator")
  maintenanceProvidersCreated     MaintenanceProvider[]     @relation("MaintenanceProviderCreator")
  tollRatesCreated                TollRate[]                @relation("TollRateCreator")
  subscriptionPaymentsCreated     SubscriptionPayment[]
  fiscalDocumentsCreated          FiscalDocument[]          @relation("FiscalDocumentCreator")
  fiscalDocumentsUpdated          FiscalDocument[]          @relation("FiscalDocumentUpdater")
  tripOccurrencesCreated          TripOccurrence[]          @relation("TripOccurrenceCreator")
  tripOccurrencesResolved         TripOccurrence[]          @relation("TripOccurrenceResolver")
  customerNotesCreated            CustomerNote[]            @relation("CustomerNoteCreator")
  contractsCreated                Contract[]                @relation("ContractCreator")
  contractsUpdated                Contract[]                @relation("ContractUpdater")
  freightTablesCreated            FreightTable[]            @relation("FreightTableCreator")
  freightTablesUpdated            FreightTable[]            @relation("FreightTableUpdater")
  freightRulesCreated             FreightRule[]             @relation("FreightRuleCreator")
  freightRulesUpdated             FreightRule[]             @relation("FreightRuleUpdater")
  tripFreightsCreated             TripFreight[]             @relation("TripFreightCreator")
  tripFreightsUpdated             TripFreight[]             @relation("TripFreightUpdater")
  tripBillingsCreated             TripBilling[]             @relation("TripBillingCreator")
  tripBillingsUpdated             TripBilling[]             @relation("TripBillingUpdater")
  tripBillingsCancelled           TripBilling[]             @relation("TripBillingCanceller")
  tripBillingEntriesCreated       TripBillingEntry[]        @relation("TripBillingEntryCreator")
  driverVehicleAssignmentsCreated DriverVehicleAssignment[] @relation("DriverVehicleAssignmentCreator")
  receivablesCreated              Receivable[]              @relation("ReceivableCreator")
  receivablesCancelled            Receivable[]              @relation("ReceivableCanceller")
  receivablePaymentsCreated       ReceivablePayment[]       @relation("ReceivablePaymentCreator")
  payablesCreated                 Payable[]                 @relation("PayableCreator")
  payablesCancelled               Payable[]                 @relation("PayableCanceller")
  payablePaymentsCreated          PayablePayment[]          @relation("PayablePaymentCreator")
  financialPeriodsOpened          FinancialPeriod[]         @relation("FinancialPeriodOpener")
  financialPeriodsClosed          FinancialPeriod[]         @relation("FinancialPeriodCloser")
  financialAccountsCreated        FinancialAccount[]        @relation("FinancialAccountCreator")
  financialTransactionsCreated    FinancialTransaction[]    @relation("FinancialTransactionCreator")
  /// Fase 94 -- Cotacoes.
  quotationsCreated               Quotation[]               @relation("QuotationCreator")
  quotationsUpdated               Quotation[]               @relation("QuotationUpdater")
  /// Fase 95 -- Propostas.
  proposalsCreated                Proposal[]                @relation("ProposalCreator")
  proposalsUpdated                Proposal[]                @relation("ProposalUpdater")
  /// Fase 96 -- Pipeline Comercial.
  pipelineOpportunitiesCreated    PipelineOpportunity[]     @relation("PipelineOpportunityCreator")
  pipelineOpportunitiesUpdated    PipelineOpportunity[]     @relation("PipelineOpportunityUpdater")
  /// Fase 98 -- Renovacao de Contratos.
  contractRenewalsInitiated       ContractRenewal[]         @relation("ContractRenewalInitiator")
  contractRenewalsCompleted       ContractRenewal[]         @relation("ContractRenewalCompleter")
  contractRenewalsCancelled       ContractRenewal[]         @relation("ContractRenewalCanceller")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("user_accounts")
}

/// Sessao de refresh token (JWT de longa duracao), persistida para permitir
/// revogacao/rotacao -- um JWT sozinho nao pode ser invalidado antes de
/// expirar. O id do registro E o "jti" embutido no payload do refresh token.
/// Nao carrega tenant_id: autenticacao e por usuario, o isolamento por
/// tenant do restante do sistema e resolvido via UserAccount.tenantId.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Trilha de auditoria geral da plataforma (nao apenas pedagio). Registrada
/// para qualquer alteracao sensivel em qualquer entidade.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  action        String // ex: "trip.status_changed", "toll_rate.updated"
  entityName    String   @map("entity_name")
  entityId      String   @map("entity_id") @db.Uuid
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  deviceInfo    String?  @map("device_info")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   UserAccount? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityName, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ============================================================================
// FROTA — frota, veiculos, implementos, tags de pedagio
// ============================================================================

/// Agrupamento organizacional de veiculos (ex: Matriz, Filial SP, Frota
/// propria, Frota agregada). Opcional em Vehicle.
model Fleet {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  type       FleetType @default(OWN)
  locationId String?   @map("location_id") @db.Uuid // base/filial, opcional
  isActive   Boolean   @default(true) @map("is_active")
  /// Exclusao logica (mesmo padrao ja usado em Driver/UserAccount).
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  vehicles Vehicle[]

  @@index([tenantId])
  @@map("fleets")
}

/// Unidade tratora (cavalo mecanico). NAO carrega mais eixos/categoria fixos
/// -- isso e derivado de AxleConfiguration por composicao de viagem, porque
/// o mesmo cavalo pode puxar implementos diferentes em viagens diferentes.
/// "category" e texto livre (proposital) porque a nomenclatura de categoria
/// de veiculo no transporte rodoviario brasileiro varia muito por empresa/
/// regiao (ex: "Toco", "Truck 6x2", "Cavalo Trucado") -- nao vale a pena
/// travar num enum fixo.
model Vehicle {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  fleetId               String?              @map("fleet_id") @db.Uuid
  plate                 String               @db.VarChar(10)
  renavam               String?              @db.VarChar(20)
  chassisNumber         String?              @map("chassis_number") @db.VarChar(30)
  brand                 String
  model                 String
  manufactureYear       Int?                 @map("manufacture_year")
  modelYear             Int?                 @map("model_year")
  color                 String?
  type                  VehicleType          @default(TRACTOR_UNIT)
  category              String?
  fuelType              VehicleFuelType?     @map("fuel_type")
  /// Capacidade do tanque de combustivel (litros).
  tankCapacityLiters    Decimal?             @map("tank_capacity_liters") @db.Decimal(10, 2)
  /// Consumo medio (km por litro).
  averageConsumptionKmL Decimal?             @map("average_consumption_km_l") @db.Decimal(10, 2)
  /// Quilometragem atual registrada do veiculo (distinta de
  /// Telemetry.odometerKm, que e uma serie historica de leituras).
  odometerKm            Decimal?             @map("odometer_km") @db.Decimal(10, 2)
  /// Peso Bruto Total (PBT), em kg.
  grossWeightKg         Decimal?             @map("gross_weight_kg") @db.Decimal(10, 2)
  netWeightKg           Decimal?             @map("net_weight_kg") @db.Decimal(10, 2)
  cargoCapacityKg       Decimal?             @map("cargo_capacity_kg") @db.Decimal(10, 2)
  axleCount             Int?                 @map("axle_count")
  notes                 String?
  status                VehicleStatus        @default(ACTIVE)
  /// Fase 62 -- classificacao de propriedade (mesmo espirito de Driver.type).
  ownershipType         VehicleOwnershipType @default(OWN) @map("ownership_type")
  /// Exclusao logica (mesmo padrao ja usado em Driver/UserAccount).
  deletedAt             DateTime?            @map("deleted_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  tenant                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fleet                   Fleet?                    @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  tripCompositions        TripComposition[]
  tags                    VehicleTag[]
  telemetry               Telemetry[]
  maintenances            VehicleMaintenance[]
  maintenancePlans        MaintenancePlan[]
  tollTransactions        TollTransaction[]
  tripExpenses            TripExpense[]
  fuelSupplies            FuelSupply[]
  tripStops               TripStop[]
  axleEvents              AxleEvent[]
  tripOccurrences         TripOccurrence[]
  routePlans              RoutePlan[]
  tires                   Tire[]                    @relation("TireCurrentVehicle")
  tireMovementsAsPrevious TireMovement[]            @relation("TireMovementPreviousVehicle")
  tireMovementsAsNew      TireMovement[]            @relation("TireMovementNewVehicle")
  checklistExecutions     ChecklistExecution[]
  fiscalDocuments         FiscalDocument[]
  /// Fase 61 -- historico de motoristas (proprios/agregados) vinculados a
  /// este veiculo.
  driverAssignments       DriverVehicleAssignment[]

  @@unique([tenantId, plate])
  @@unique([tenantId, renavam])
  @@unique([tenantId, chassisNumber])
  @@index([tenantId])
  @@index([fleetId])
  @@index([tenantId, ownershipType])
  @@index([tenantId, status])
  @@map("vehicles")
}

/// Registro de manutencao do veiculo (Fase 12: relacionamento basico +
/// regra de exclusao; Fase 45: modulo completo -- componente, pecas
/// itemizadas, vinculo com plano preventivo, tempo parado, proxima
/// quilometragem). Continua sendo A UNICA fonte de verdade de manutencao --
/// "MaintenanceRecord" nao e um model separado, e este mesmo (evita
/// duplicar dominio).
model VehicleMaintenance {
  id                   String                     @id @default(uuid()) @db.Uuid
  tenantId             String                     @map("tenant_id") @db.Uuid
  vehicleId            String                     @map("vehicle_id") @db.Uuid
  type                 VehicleMaintenanceType     @default(PREVENTIVE)
  status               VehicleMaintenanceStatus   @default(OPEN)
  priority             VehicleMaintenancePriority @default(MEDIUM)
  /// Fase 45 -- item/sistema do veiculo alvo desta manutencao. Opcional
  /// (nem todo registro historico tem essa granularidade).
  component            MaintenanceComponent?
  /// Data de abertura da manutencao (distinta de createdAt: pode ser
  /// retroativa, ex: importacao de historico).
  openedAt             DateTime                   @default(now()) @map("opened_at")
  scheduledAt          DateTime?                  @map("scheduled_at")
  /// Fase 82 -- data em que a execucao da OS de fato comecou (distinta de
  /// openedAt/scheduledAt). Preenchida pela acao POST /maintenances/:id/start.
  startedAt            DateTime?                  @map("started_at")
  completedAt          DateTime?                  @map("completed_at")
  /// Fase 82 -- texto de diagnostico tecnico (distinto de description, que e
  /// o problema relatado, e de notes, observacoes gerais). Preenchido pela
  /// acao POST /maintenances/:id/diagnose, editavel depois via PATCH.
  diagnosis            String?
  odometerKm           Decimal?                   @map("odometer_km") @db.Decimal(10, 2)
  /// Fase 82 -- quilometragem do veiculo na CONCLUSAO da OS, distinta de
  /// odometerKm (na abertura) e de nextOdometerKm (projecao da proxima
  /// manutencao deste componente). Preenchida pela acao POST /:id/complete.
  completionOdometerKm Decimal?                   @map("completion_odometer_km") @db.Decimal(10, 2)
  /// Fase 45 -- quilometragem prevista da PROXIMA manutencao deste
  /// componente (distinto de MaintenancePlan.intervalKm, que e a regra;
  /// este e o valor calculado/informado para ESTE registro especifico).
  nextOdometerKm       Decimal?                   @map("next_odometer_km") @db.Decimal(10, 2)
  workshop             String?
  supplier             String?
  mechanic             String?
  /// Fase 84 -- vinculo opcional com o catalogo de oficinas/fornecedores
  /// (MaintenanceProvider, type=WORKSHOP/SUPPLIER respectivamente). Os
  /// campos de texto livre acima (workshop/supplier, Fase 13) sao
  /// preservados -- registros historicos ou sem cadastro continuam
  /// funcionando exatamente como antes (mesmo padrao de
  /// MaintenancePart.partId na Fase 83).
  workshopId           String?                    @map("workshop_id") @db.Uuid
  supplierId           String?                    @map("supplier_id") @db.Uuid
  /// Usuario interno responsavel por acompanhar esta manutencao -- distinto
  /// do AuditLog.userId (que registra quem alterou o REGISTRO, nao quem e
  /// o responsavel pela manutencao em si).
  responsibleUserId    String?                    @map("responsible_user_id") @db.Uuid
  description          String?
  notes                String?
  laborCost            Decimal?                   @map("labor_cost") @db.Decimal(10, 2)
  /// Fase 45 -- quando ha pecas itemizadas (relacao `parts`), este valor e
  /// SEMPRE recalculado como a soma delas pelo service, nunca aceito solto
  /// do cliente nesse caso. Sem itens, continua aceito diretamente (mesmo
  /// comportamento desde a Fase 13).
  partsCost            Decimal?                   @map("parts_cost") @db.Decimal(10, 2)
  /// Sempre calculado pelo service (laborCost + partsCost) -- nunca aceito
  /// diretamente do cliente.
  totalCost            Decimal?                   @map("total_cost") @db.Decimal(10, 2)
  /// Fase 45 -- tempo de veiculo parado para esta manutencao, em minutos,
  /// SEMPRE informado explicitamente (nunca inferido de openedAt/
  /// completedAt, que podem nao representar o periodo real de parada --
  /// ex: pecas encomendadas com o veiculo rodando ate elas chegarem).
  downtimeMinutes      Int?                       @map("downtime_minutes")
  serviceOrderNumber   String?                    @map("service_order_number")
  /// Fase 45 -- nota fiscal do fornecedor/oficina, distinta de
  /// serviceOrderNumber (OS interna).
  invoiceNumber        String?                    @map("invoice_number")
  warrantyUntil        DateTime?                  @map("warranty_until")
  nextReviewAt         DateTime?                  @map("next_review_at")
  /// Fase 45 -- preenchido quando este registro cumpre um MaintenancePlan
  /// (preventiva agendada). Opcional -- corretivas e preventivas avulsas
  /// nunca tem plano.
  maintenancePlanId    String?                    @map("maintenance_plan_id") @db.Uuid
  /// Fase 111 -- vinculo opcional com a execucao de checklist (pre/pos-
  /// viagem) cuja nao-conformidade critica motivou a abertura desta OS.
  /// MESMO padrao ja usado por TireMovement.maintenanceId (Fase 109): so
  /// preenchido quando o admin abre a OS explicitamente a partir de um
  /// checklist (nunca criado automaticamente) -- nenhuma segunda maquina de
  /// estados "checklist em manutencao".
  checklistExecutionId String?                    @map("checklist_execution_id") @db.Uuid
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle            Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  responsibleUser    UserAccount?         @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)
  maintenancePlan    MaintenancePlan?     @relation(fields: [maintenancePlanId], references: [id], onDelete: SetNull)
  checklistExecution ChecklistExecution?  @relation(fields: [checklistExecutionId], references: [id], onDelete: SetNull)
  parts              MaintenancePart[]
  /// Fase 83 -- saidas de estoque geradas ao concluir esta OS (ver
  /// PartsService.consumePartsForMaintenance).
  partStockMovements PartStockMovement[]
  /// Fase 109 -- movimentacoes de pneu (troca/instalacao/remocao) vinculadas
  /// a esta OS, quando aplicavel (ver TireMovement.maintenanceId).
  tireMovements      TireMovement[]
  /// Fase 84 -- oficina/fornecedor vinculados (ver comentario de workshopId/
  /// supplierId acima).
  workshopProvider   MaintenanceProvider? @relation("MaintenanceWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  supplierProvider   MaintenanceProvider? @relation("MaintenanceSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@index([vehicleId, status])
  @@index([tenantId, component])
  @@index([maintenancePlanId])
  @@index([workshopId])
  @@index([supplierId])
  @@index([checklistExecutionId])
  @@map("vehicle_maintenances")
}

/// Plano de manutencao PREVENTIVA (Fase 45) -- regra de recorrencia por
/// veiculo/componente (intervalo em km/dias/horas), usada pela camada de
/// alertas para calcular vencidas/proximas (MAINTENANCE_OVERDUE/
/// MAINTENANCE_DUE_SOON). Nao gera VehicleMaintenance automaticamente --
/// so serve de REFERENCIA para o calculo; o registro real continua sendo
/// criado manualmente (administrativo, online) e pode referenciar o plano
/// via VehicleMaintenance.maintenancePlanId.
model MaintenancePlan {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  vehicleId       String                 @map("vehicle_id") @db.Uuid
  name            String
  component       MaintenanceComponent
  maintenanceType VehicleMaintenanceType @default(PREVENTIVE) @map("maintenance_type")
  /// Pelo menos um dos 3 intervalos abaixo deve ser informado (validado no
  /// service, nunca a nivel de schema) -- um plano sem nenhum criterio de
  /// vencimento nunca gera alerta.
  intervalKm      Int?                   @map("interval_km")
  intervalDays    Int?                   @map("interval_days")
  intervalHours   Int?                   @map("interval_hours")
  /// Antecedencia (km/dias) para o alerta MAINTENANCE_DUE_SOON, antes de
  /// vencer de fato. Opcional -- sem isso, so MAINTENANCE_OVERDUE se aplica.
  alertBeforeKm   Int?                   @map("alert_before_km")
  alertBeforeDays Int?                   @map("alert_before_days")
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  records VehicleMaintenance[]

  @@index([tenantId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, active])
  @@map("maintenance_plans")
}

/// Peca/item utilizado numa manutencao (Fase 45) -- itemizacao opcional de
/// VehicleMaintenance.partsCost. Quando existem linhas aqui, partsCost do
/// registro pai e SEMPRE a soma delas (ver MaintenancesService) -- nunca os
/// dois valores divergindo.
model MaintenancePart {
  id            String   @id @default(uuid()) @db.Uuid
  maintenanceId String   @map("maintenance_id") @db.Uuid
  /// Fase 83 -- vinculo opcional com o catalogo de pecas. Linhas criadas
  /// antes da Fase 83 (ou itens sem correspondente no catalogo) continuam
  /// com partId=null -- `name` permanece o texto livre em ambos os casos.
  /// Presente = a conclusao da OS gera uma saida de estoque automatica (ver
  /// PartsService.consumePartsForMaintenance); ausente = so um item de
  /// custo, sem efeito no estoque (comportamento identico ao pre-Fase 83).
  partId        String?  @map("part_id") @db.Uuid
  name          String
  quantity      Decimal  @db.Decimal(10, 2)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(10, 2)
  /// Sempre calculado pelo service (quantity * unitPrice) -- nunca aceito
  /// diretamente do cliente.
  totalPrice    Decimal  @map("total_price") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  maintenance VehicleMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  part        Part?              @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([maintenanceId])
  @@index([partId])
  @@map("maintenance_parts")
}

enum PartStockMovementType {
  IN
  OUT
  ADJUSTMENT

  @@map("part_stock_movement_type")
}

/// Catalogo de pecas (Fase 83) -- fonte unica para cadastro de pecas usadas
/// na manutencao da frota (nao existia antes; MaintenancePart era so um
/// item de custo em texto livre, sem controle de estoque).
///
/// currentStock/isLowStock sao CACHE PERSISTIDO, nunca aceito do cliente --
/// sempre recalculado pelo service dentro da MESMA transacao (runSerializable,
/// mesmo utilitario da Fase 48) de qualquer PartStockMovement, nunca uma
/// segunda fonte de verdade (a soma das movimentacoes SEMPRE bate com
/// currentStock -- ver docs/parts-inventory.md). Justificativa de persistir
/// em vez de so calcular sob demanda (diferente de FinancialAccount.
/// currentBalance, que e 100% calculado): a listagem precisa filtrar/paginar
/// por "estoque baixo" (currentStock <= minStock, comparacao entre 2
/// colunas da MESMA linha, que o Prisma nao expressa em `where` sem SQL
/// bruto) -- isLowStock e essa comparacao pre-computada e persistida,
/// permitindo um filtro nativo, paginado e sem N+1.
model Part {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sku          String
  name         String
  description  String?
  unit         String
  category     String?
  manufacturer String?
  /// Codigo original do fabricante do veiculo (OEM), distinto do sku
  /// (codigo interno).
  oemCode      String?  @map("oem_code")
  minStock     Decimal? @map("min_stock") @db.Decimal(10, 2)
  /// Cache persistido -- ver comentario do model.
  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(10, 2)
  /// Cache persistido -- currentStock <= minStock (sempre false quando
  /// minStock nao informado, nunca uma comparacao inventada). Ver
  /// comentario do model.
  isLowStock   Boolean  @default(false) @map("is_low_stock")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator          UserAccount         @relation("PartCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  movements        PartStockMovement[]
  maintenanceParts MaintenancePart[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@index([tenantId, isLowStock])
  @@map("parts")
}

/// Ledger de movimentacao de estoque (Fase 83) -- append-only (mesmo
/// espirito de TireMovement/FinancialTransaction): nunca ha UPDATE/DELETE
/// pela API. Correcoes geram uma NOVA movimentacao ADJUSTMENT, nunca editam
/// uma linha existente.
model PartStockMovement {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  partId        String                @map("part_id") @db.Uuid
  type          PartStockMovementType
  /// IN/OUT: sempre positivo (o efeito no saldo vem de `type`). ADJUSTMENT:
  /// pode ser positivo (correcao para cima) ou negativo (para baixo) --
  /// representa o delta diretamente.
  quantity      Decimal               @db.Decimal(10, 2)
  /// Custo unitario de referencia (ex: preco de compra na entrada).
  /// Opcional -- usado para estimar valor de estoque no dashboard; nunca
  /// inventado quando ausente.
  unitCost      Decimal?              @map("unit_cost") @db.Decimal(10, 2)
  movementDate  DateTime              @default(now()) @map("movement_date")
  reason        String?
  /// Referencia/origem em texto livre (ex: nota fiscal, numero de pedido,
  /// nome do fornecedor) -- sem CRM/fornecedor separado nesta fase (secao 4
  /// da Fase 83).
  reference     String?
  notes         String?
  /// Preenchido quando a origem da SAIDA e o consumo em uma Ordem de
  /// Servico (Fase 82) -- ver PartsService.consumePartsForMaintenance.
  /// Nulo para entradas/saidas/ajustes manuais.
  maintenanceId String?               @map("maintenance_id") @db.Uuid
  createdBy     String                @map("created_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  part        Part                @relation(fields: [partId], references: [id], onDelete: Cascade)
  maintenance VehicleMaintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  creator     UserAccount         @relation("PartStockMovementCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, partId])
  @@index([tenantId, maintenanceId])
  @@index([tenantId, movementDate])
  @@map("part_stock_movements")
}

enum MaintenanceProviderType {
  WORKSHOP
  SUPPLIER

  @@map("maintenance_provider_type")
}

/// Oficina ou fornecedor relacionado a manutencao da frota (Fase 84).
/// Oficina e fornecedor sao conceitualmente o MESMO tipo de entidade (nome/
/// documento/contato/endereco/ativo) -- modelados como UMA UNICA tabela com
/// `type` discriminador, em vez de 2 tabelas quase identicas (decisao
/// documentada em docs/maintenance-providers.md). VehicleMaintenance.
/// workshopId/supplierId referenciam esta tabela filtrando implicitamente
/// por type=WORKSHOP/SUPPLIER (o service valida o type correto na
/// associacao, nunca o schema). `specialties` so faz sentido tipicamente
/// para oficinas, mas fica disponivel para ambos os tipos sem restricao
/// artificial (um fornecedor tambem pode ser "especializado" em algo).
model MaintenanceProvider {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @map("tenant_id") @db.Uuid
  type        MaintenanceProviderType
  name        String
  tradeName   String?                 @map("trade_name")
  /// CPF/CNPJ, opcional. Unico por tenant+type quando informado (multiplos
  /// nulos sao permitidos pelo indice unico do Postgres, mesmo padrao ja
  /// usado por Vehicle.renavam/chassisNumber).
  document    String?                 @db.VarChar(20)
  phone       String?
  email       String?
  address     String?
  contactName String?                 @map("contact_name")
  specialties String?
  notes       String?
  isActive    Boolean                 @default(true) @map("is_active")
  createdBy   String                  @map("created_by") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator                UserAccount          @relation("MaintenanceProviderCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  maintenancesAsWorkshop VehicleMaintenance[] @relation("MaintenanceWorkshop")
  maintenancesAsSupplier VehicleMaintenance[] @relation("MaintenanceSupplier")

  @@unique([tenantId, type, document])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, type, isActive])
  @@map("maintenance_providers")
}

/// Pneu da frota (Fase 20). status = estado de ciclo de vida (NEW/IN_USE/
/// STOCK/RETREADED/SCRAPPED); locationType/vehicleId/trailerId/position =
/// ONDE o pneu esta fisicamente AGORA (sempre um snapshot atual -- o
/// historico de cada troca fica em TireMovement, nunca sobrescrito).
model Tire {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  fireNumber          String           @map("fire_number")
  manufacturer        String
  model               String
  size                String
  dot                 String?
  serialNumber        String?          @map("serial_number")
  purchaseDate        DateTime?        @map("purchase_date")
  purchasePrice       Decimal?         @map("purchase_price") @db.Decimal(10, 2)
  expectedLifespanKm  Decimal?         @map("expected_lifespan_km") @db.Decimal(10, 2)
  initialTreadDepthMm Decimal?         @map("initial_tread_depth_mm") @db.Decimal(5, 2)
  /// Atualizado automaticamente pela inspecao mais recente (ver
  /// TiresService.createInspection).
  currentTreadDepthMm Decimal?         @map("current_tread_depth_mm") @db.Decimal(5, 2)
  status              TireStatus       @default(STOCK)
  locationType        TireLocationType @default(STOCK) @map("location_type")
  vehicleId           String?          @map("vehicle_id") @db.Uuid
  trailerId           String?          @map("trailer_id") @db.Uuid
  position            String?
  createdBy           String           @map("created_by") @db.Uuid
  updatedBy           String?          @map("updated_by") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?         @relation("TireCurrentVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  trailer     Trailer?         @relation("TireCurrentTrailer", fields: [trailerId], references: [id], onDelete: SetNull)
  creator     UserAccount      @relation("TireCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater     UserAccount?     @relation("TireUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  movements   TireMovement[]
  retreads    TireRetread[]
  inspections TireInspection[]
  disposal    TireDisposal?

  @@unique([tenantId, fireNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, vehicleId])
  @@index([tenantId, trailerId])
  @@map("tires")
}

/// Historico de troca/movimentacao de um pneu -- toda alteracao de
/// localizacao gera uma linha aqui, nunca sobrescrita (ver
/// TiresService.createMovement). previous* fica null na primeira
/// movimentacao (pneu recem-cadastrado, sem localizacao anterior alem do
/// estoque implicito).
model TireMovement {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  tireId               String            @map("tire_id") @db.Uuid
  movementDate         DateTime          @default(now()) @map("movement_date")
  previousLocationType TireLocationType? @map("previous_location_type")
  previousVehicleId    String?           @map("previous_vehicle_id") @db.Uuid
  previousTrailerId    String?           @map("previous_trailer_id") @db.Uuid
  previousPosition     String?           @map("previous_position")
  newLocationType      TireLocationType  @map("new_location_type")
  newVehicleId         String?           @map("new_vehicle_id") @db.Uuid
  newTrailerId         String?           @map("new_trailer_id") @db.Uuid
  newPosition          String?           @map("new_position")
  odometerKm           Decimal?          @map("odometer_km") @db.Decimal(10, 2)
  reason               String?
  /// Fase 109 -- vinculo opcional com a OS (VehicleMaintenance) que motivou
  /// esta troca/movimentacao, quando aplicavel. MESMO padrao ja usado por
  /// PartStockMovement.maintenanceId (Fase 83): uma OS pode estar ligada a
  /// varias movimentacoes de pneu (troca de mais de um pneu na mesma
  /// visita), cada uma sua propria linha -- nunca uma segunda maquina de
  /// estados "pneu em manutencao". Ausente = movimentacao avulsa, sem
  /// vinculo com nenhuma OS (comportamento identico ao pre-Fase 109).
  maintenanceId        String?           @map("maintenance_id") @db.Uuid
  createdBy            String            @map("created_by") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tire            Tire                @relation(fields: [tireId], references: [id], onDelete: Cascade)
  previousVehicle Vehicle?            @relation("TireMovementPreviousVehicle", fields: [previousVehicleId], references: [id], onDelete: SetNull)
  newVehicle      Vehicle?            @relation("TireMovementNewVehicle", fields: [newVehicleId], references: [id], onDelete: SetNull)
  previousTrailer Trailer?            @relation("TireMovementPreviousTrailer", fields: [previousTrailerId], references: [id], onDelete: SetNull)
  newTrailer      Trailer?            @relation("TireMovementNewTrailer", fields: [newTrailerId], references: [id], onDelete: SetNull)
  maintenance     VehicleMaintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  creator         UserAccount         @relation("TireMovementCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, tireId])
  @@index([maintenanceId])
  @@map("tire_movements")
}

/// Recapagem -- um pneu pode ter varias ao longo da vida. Registrar uma
/// recapagem atualiza Tire.status para RETREADED automaticamente.
model TireRetread {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tireId      String   @map("tire_id") @db.Uuid
  company     String
  cost        Decimal  @db.Decimal(10, 2)
  retreadDate DateTime @map("retread_date")
  warranty    String?
  mileageKm   Decimal? @map("mileage_km") @db.Decimal(10, 2)
  notes       String?
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tire    Tire        @relation(fields: [tireId], references: [id], onDelete: Cascade)
  creator UserAccount @relation("TireRetreadCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, tireId])
  @@map("tire_retreads")
}

/// Inspecao periodica (sulco/pressao) -- registrar uma inspecao atualiza
/// Tire.currentTreadDepthMm automaticamente para o valor medido.
model TireInspection {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tireId         String   @map("tire_id") @db.Uuid
  inspectionDate DateTime @default(now()) @map("inspection_date")
  treadDepthMm   Decimal  @map("tread_depth_mm") @db.Decimal(5, 2)
  pressurePsi    Decimal? @map("pressure_psi") @db.Decimal(6, 2)
  notes          String?
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tire    Tire        @relation(fields: [tireId], references: [id], onDelete: Cascade)
  creator UserAccount @relation("TireInspectionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, tireId])
  @@map("tire_inspections")
}

/// Descarte -- 1:1 com Tire (um pneu so e descartado uma vez). Registrar um
/// descarte atualiza Tire.status para SCRAPPED e remove o pneu de qualquer
/// veiculo/carreta automaticamente.
model TireDisposal {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tireId        String   @unique @map("tire_id") @db.Uuid
  reason        String
  disposalDate  DateTime @map("disposal_date")
  odometerKm    Decimal? @map("odometer_km") @db.Decimal(10, 2)
  residualValue Decimal? @map("residual_value") @db.Decimal(10, 2)
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tire    Tire        @relation(fields: [tireId], references: [id], onDelete: Cascade)
  creator UserAccount @relation("TireDisposalCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("tire_disposals")
}

/// Posto de abastecimento (Fase 18) -- dado de cadastro do tenant (ao
/// contrario de TollPlaza/TagProvider, que sao globais: cada transportadora
/// cadastra seus proprios postos conveniados/habituais).
model FuelStation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  cnpj      String?  @db.VarChar(20)
  city      String?
  state     String?  @db.VarChar(2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplies FuelSupply[]

  @@index([tenantId])
  @@map("fuel_stations")
}

/// Abastecimento de um veiculo (Fase 18). tripId e opcional -- quando
/// presente, vehicleId/driverId sao SEMPRE derivados da Trip (nunca aceitos
/// do cliente); quando ausente, vehicleId/driverId sao informados
/// diretamente (e validados). totalAmount e SEMPRE calculado
/// (liters * pricePerLiter), nunca aceito do cliente.
/// fuelStationId e OPCIONAL (Fase 25): o app do motorista registra apenas
/// KM+litros e a localizacao (latitude/longitude) -- sem escolher/inventar um
/// posto. O fluxo administrativo (Fase 18) continua exigindo fuelStationId no
/// DTO de criacao manual.
model FuelSupply {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  vehicleId     String       @map("vehicle_id") @db.Uuid
  driverId      String       @map("driver_id") @db.Uuid
  tripId        String?      @map("trip_id") @db.Uuid
  fuelStationId String?      @map("fuel_station_id") @db.Uuid
  attachmentId  String?      @map("attachment_id") @db.Uuid
  fuelType      FuelType     @map("fuel_type")
  liters        Decimal      @db.Decimal(10, 3)
  pricePerLiter Decimal      @map("price_per_liter") @db.Decimal(10, 4)
  /// Sempre liters * pricePerLiter -- ver FuelSuppliesService.
  totalAmount   Decimal      @map("total_amount") @db.Decimal(10, 2)
  /// Odometro no momento do abastecimento -- nunca menor que
  /// Vehicle.odometerKm no momento do registro (ver validacao no service).
  odometerKm    Decimal      @map("odometer_km") @db.Decimal(10, 2)
  supplyDate    DateTime     @map("supply_date")
  paymentType   PaymentType? @map("payment_type")
  invoiceNumber String?      @map("invoice_number")
  notes         String?
  /// Localizacao do abastecimento (Fase 25) -- preenchida pelo app do
  /// motorista quando nao ha fuelStationId conhecido.
  latitude      Decimal?     @db.Decimal(9, 6)
  longitude     Decimal?     @db.Decimal(9, 6)
  deviceEventId String?      @unique @map("device_event_id")
  syncedAt      DateTime?    @map("synced_at")
  syncStatus    SyncStatus   @default(SYNCED) @map("sync_status")
  createdBy     String       @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver      Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  trip        Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  fuelStation FuelStation? @relation(fields: [fuelStationId], references: [id], onDelete: Restrict)
  attachment  Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  creator     UserAccount  @relation("FuelSupplyCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater     UserAccount? @relation("FuelSupplyUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, driverId])
  @@index([tenantId, tripId])
  @@index([tenantId, fuelStationId])
  @@index([tenantId, supplyDate])
  @@map("fuel_supplies")
}

/// Implemento (carreta simples, bitrem, rodotrem, vanderleia, reboque,
/// semirreboque, dolly). Combinado ao Vehicle via TripComposition/
/// TripCompositionTrailer em cada composicao.
model Trailer {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  plate     String      @db.VarChar(10)
  type      TrailerType @default(SIMPLE)
  notes     String?
  isActive  Boolean     @default(true) @map("is_active")
  /// Exclusao logica (mesmo padrao ja usado em Driver/UserAccount).
  deletedAt DateTime?   @map("deleted_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tripCompositionTrailers TripCompositionTrailer[]
  tires                   Tire[]                   @relation("TireCurrentTrailer")
  tireMovementsAsPrevious TireMovement[]           @relation("TireMovementPreviousTrailer")
  tireMovementsAsNew      TireMovement[]           @relation("TireMovementNewTrailer")
  checklistExecutions     ChecklistExecution[]

  @@unique([tenantId, plate])
  @@index([tenantId])
  @@map("trailers")
}

/// Operadora de tag de pedagio (Sem Parar, ConectCar, Veloe, Move Mais).
/// Dado de referencia GLOBAL -- nao pertence a um tenant especifico.
model TagProvider {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  website   String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicleTags      VehicleTag[]
  tollTransactions TollTransaction[]
  importJobs       ImportJob[]

  @@map("tag_providers")
}

/// Vinculo entre o veiculo do tenant e sua tag de pedagio, preparando a
/// importacao futura de extratos por operadora.
model VehicleTag {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  vehicleId     String    @map("vehicle_id") @db.Uuid
  tagProviderId String    @map("tag_provider_id") @db.Uuid
  tagNumber     String    @map("tag_number")
  isActive      Boolean   @default(true) @map("is_active")
  activatedAt   DateTime? @map("activated_at")
  /// Data de vencimento da tag -- usada para bloquear transacoes de pedagio
  /// registradas com tag vencida (ver TollTransactionsService).
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tagProvider TagProvider @relation(fields: [tagProviderId], references: [id], onDelete: Restrict)

  @@unique([tagProviderId, tagNumber])
  @@index([tenantId])
  @@index([vehicleId])
  @@map("vehicle_tags")
}

// ============================================================================
// MOTORISTAS — perfil, jornada
// ============================================================================

/// Classificacao operacional do motorista (Fase 61). OWN = proprio,
/// pertence a operacao direta da transportadora. AGGREGATED = agregado,
/// vinculado operacionalmente mas com relacao contratual propria.
/// THIRD_PARTY = terceiro, motorista/servico externo utilizado pela
/// transportadora. Default OWN preserva o comportamento de todos os
/// motoristas ja cadastrados antes desta fase (nunca reclassificados
/// automaticamente para AGGREGATED/THIRD_PARTY).
enum DriverType {
  OWN
  AGGREGATED
  THIRD_PARTY

  @@map("driver_type")
}

/// Status operacional do motorista (Fase 61), mesmo espirito de
/// VehicleStatus. SUSPENDED e distinto de INACTIVE: suspensao e um
/// bloqueio temporario/disciplinar, inativo e um encerramento efetivo do
/// vinculo -- ambos bloqueiam nova atribuicao a viagem (ver
/// Driver.isActive, mantido sincronizado com este campo).
enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("driver_status")
}

/// Perfil operacional do motorista. userAccountId e opcional -- so existe
/// quando o motorista tem login no app (Driver App). Documentos (CNH,
/// exame medico, MOPP, ANTT...) NAO sao campos aqui -- usam o model
/// Document generico/polimorfico (ownerType=DRIVER, ownerId=Driver.id).
model Driver {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  userAccountId   String?      @unique @map("user_account_id") @db.Uuid
  name            String
  cpf             String       @db.VarChar(11)
  rg              String?      @db.VarChar(20)
  cnhNumber       String       @map("cnh_number") @db.VarChar(20)
  cnhCategory     String       @map("cnh_category") @db.VarChar(5)
  cnhExpiresAt    DateTime     @map("cnh_expires_at")
  birthDate       DateTime?    @map("birth_date")
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?      @db.VarChar(2)
  zipCode         String?      @map("zip_code") @db.VarChar(9)
  notes           String?
  admissionDate   DateTime?    @map("admission_date")
  /// Preenchida no desligamento do motorista -- distinta de deletedAt
  /// (desligado ainda e um registro historico valido; excluido logicamente
  /// nao deveria mais aparecer em listagens).
  terminationDate DateTime?    @map("termination_date")
  /// Fase 61 -- classificacao operacional (proprio/agregado/terceiro).
  type            DriverType   @default(OWN)
  /// Fase 61 -- status operacional detalhado. SEMPRE mantido sincronizado
  /// com isActive pelo DriversService (isActive = status == ACTIVE) --
  /// isActive continua sendo o campo lido por TODAS as checagens ja
  /// existentes (TripsService.assertDriverAvailable, inicio de viagem,
  /// DriverGuard do Driver App), nunca duplicando essa logica: um
  /// motorista SUSPENDED ou INACTIVE ja fica automaticamente bloqueado
  /// para nova viagem/acesso ao app so pela sincronizacao de isActive,
  /// sem precisar alterar nenhum desses pontos.
  status          DriverStatus @default(ACTIVE)
  /// Fase 61 -- disponibilidade operacional (ex: em folga/em viagem longa),
  /// distinta de status (vinculo) -- indicacao manual, nunca inferida
  /// automaticamente de viagens em andamento.
  isAvailable     Boolean      @default(true) @map("is_available")
  isActive        Boolean      @default(true) @map("is_active")
  /// Exclusao logica (mesmo padrao de UserAccount.deletedAt).
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAccount         UserAccount?              @relation(fields: [userAccountId], references: [id], onDelete: SetNull)
  trips               Trip[]
  shifts              DriverShift[]
  tripOccurrences     TripOccurrence[]
  tollTransactions    TollTransaction[]
  tripExpenses        TripExpense[]
  tripAdvances        TripAdvance[]
  fuelSupplies        FuelSupply[]
  tripStops           TripStop[]
  axleEvents          AxleEvent[]
  checklistExecutions ChecklistExecution[]
  fiscalDocuments     FiscalDocument[]
  /// Fase 61 -- historico de vinculo com veiculo (atual = endedAt null).
  vehicleAssignments  DriverVehicleAssignment[]

  @@unique([tenantId, cpf])
  @@unique([tenantId, cnhNumber])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@map("drivers")
}

/// Historico de vinculo motorista <-> veiculo (Fase 61) -- distinto de
/// DriverShift (jornada de trabalho) e de TripComposition (composicao
/// usada numa viagem especifica). Mesmo espirito de
/// Tire[]@relation("TireCurrentVehicle")/TireMovement (Fase 45): o vinculo
/// ATUAL e a linha com endedAt nulo; trocar de veiculo fecha a linha atual
/// (endedAt = agora) e abre uma nova, preservando o historico completo --
/// nunca apaga/sobrescreve uma atribuicao anterior. Nunca altera
/// retroativamente TripComposition/Trip ja registradas.
model DriverVehicleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  driverId  String    @map("driver_id") @db.Uuid
  vehicleId String    @map("vehicle_id") @db.Uuid
  startedAt DateTime  @map("started_at")
  /// Nulo = vinculo atual (no maximo 1 linha com endedAt nulo por
  /// motorista, garantido pelo DriversService, nunca por constraint de
  /// banco -- mesmo padrao ja aceito no projeto para TollRate/FreightRule).
  endedAt   DateTime? @map("ended_at")
  notes     String?   @db.Text
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver  Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  creator UserAccount @relation("DriverVehicleAssignmentCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, driverId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, driverId, endedAt])
  @@map("driver_vehicle_assignments")
}

/// Jornada de trabalho do motorista. trip_id e opcional -- a jornada pode
/// existir fora de uma viagem especifica (parado, manutencao, descanso).
/// Fase 67 -- status (OPEN/CLOSED/CANCELLED) e SEMPRE derivado de
/// endedAt/cancelledAt no mapper, nunca uma coluna redundante (mesmo padrao
/// de TripStop). cancelledAt adicionado para permitir cancelar uma jornada
/// aberta por engano sem que ela entre em calculos de duracao.
model DriverShift {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  driverId    String    @map("driver_id") @db.Uuid
  tripId      String?   @map("trip_id") @db.Uuid
  startedAt   DateTime  @map("started_at")
  endedAt     DateTime? @map("ended_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver      Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  trip        Trip?            @relation(fields: [tripId], references: [id], onDelete: SetNull)
  breaks      ShiftBreak[]
  occurrences TripOccurrence[]

  @@index([tenantId])
  @@index([driverId])
  @@index([tripId])
  @@map("driver_shifts")
}

/// Pausa dentro de uma jornada de motorista. type reaproveita o enum
/// TripStopType (ja possui REST/MEAL/FUEL/MAINTENANCE/OTHER -- nao ha
/// necessidade de um enum novo, Fase 67).
model ShiftBreak {
  id            String       @id @default(uuid()) @db.Uuid
  driverShiftId String       @map("driver_shift_id") @db.Uuid
  type          TripStopType @default(REST)
  startedAt     DateTime     @map("started_at")
  endedAt       DateTime?    @map("ended_at")
  reason        String?

  driverShift DriverShift @relation(fields: [driverShiftId], references: [id], onDelete: Cascade)

  @@index([driverShiftId])
  @@map("shift_breaks")
}

enum TripOccurrenceType {
  ACCIDENT
  BREAKDOWN
  DELAY
  ROUTE_DEVIATION
  DELIVERY_PROBLEM
  DOCUMENT_PROBLEM
  VEHICLE_PROBLEM
  FUEL_PROBLEM
  TIRE_PROBLEM
  OTHER
  /// Fase 101 -- catalogo especifico de ocorrencias de ENTREGA (vinculadas a
  /// TripDeliveryStop). "Veiculo/rota" reaproveita VEHICLE_PROBLEM/
  /// ROUTE_DEVIATION acima (ja existiam, nunca duplicados); "documentacao"
  /// reaproveita DOCUMENT_PROBLEM; "atraso" reaproveita DELAY; "outros"
  /// reaproveita OTHER. Os 4 abaixo sao os unicos conceitos que nao tinham
  /// nenhum valor equivalente no catalogo generico de ocorrencias de viagem.
  RECIPIENT_ABSENT
  WRONG_ADDRESS
  DELIVERY_REFUSED
  CARGO_DAMAGE

  @@map("trip_occurrence_type")
}

enum TripOccurrenceSeverity {
  INFO
  WARNING
  CRITICAL
  /// Fase 101 -- escala LOW/MEDIUM/HIGH/CRITICAL pedida para ocorrencias de
  /// entrega. INFO/WARNING/CRITICAL (Fase 67) continuam usados sem alteracao
  /// pelos demais tipos de ocorrencia de viagem (acidente, quebra etc.) --
  /// as duas escalas convivem no mesmo enum, nunca uma redefine a outra.
  LOW
  MEDIUM
  HIGH

  @@map("trip_occurrence_severity")
}

enum TripOccurrenceStatus {
  OPEN
  RESOLVED
  CANCELLED

  @@map("trip_occurrence_status")
}

/// Ocorrencia registrada durante uma viagem (Fase 67). Nunca uma segunda
/// fonte de eventos -- apenas o registro do proprio incidente; a timeline
/// unificada (GET /trips/:id/timeline) agrega este model como mais uma
/// origem, junto de TripStop/RouteEvent/FuelSupply/etc. status e sempre
/// derivado de resolvedAt/cancelledAt no mapper (mesmo padrao de TripStop),
/// nunca redundante. Evidencia reaproveita Attachment via FK direta
/// (mesmo padrao de FuelSupply.attachmentId/TripExpense.attachmentId),
/// nunca um sistema de arquivos novo.
model TripOccurrence {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  tripId             String                 @map("trip_id") @db.Uuid
  /// Fase 101 -- vinculo direto com a parada/entrega especifica (Fase 88),
  /// distinto de tripId (a viagem inteira). Opcional: ocorrencias que nao
  /// sao de uma entrega especifica (acidente, quebra em transito etc.)
  /// continuam sem este vinculo.
  tripDeliveryStopId String?                @map("trip_delivery_stop_id") @db.Uuid
  driverShiftId      String?                @map("driver_shift_id") @db.Uuid
  driverId           String?                @map("driver_id") @db.Uuid
  vehicleId          String?                @map("vehicle_id") @db.Uuid
  type               TripOccurrenceType
  severity           TripOccurrenceSeverity @default(INFO)
  description        String
  occurredAt         DateTime               @map("occurred_at")
  latitude           Decimal?               @db.Decimal(9, 6)
  longitude          Decimal?               @db.Decimal(9, 6)
  locationLabel      String?                @map("location_label")
  /// Fase 101 -- marca que a ocorrencia esta sendo tratada (status
  /// IN_PROGRESS, derivado igual a RESOLVED/CANCELLED abaixo -- nunca uma
  /// coluna de status redundante).
  inProgressAt       DateTime?              @map("in_progress_at")
  resolvedAt         DateTime?              @map("resolved_at")
  resolvedBy         String?                @map("resolved_by") @db.Uuid
  cancelledAt        DateTime?              @map("cancelled_at")
  attachmentId       String?                @map("attachment_id") @db.Uuid
  metadata           Json?                  @default("{}")
  /// Idempotencia de submissao offline pelo Driver App (mesmo padrao de
  /// TripStop/FuelSupply/AxleEvent/ChecklistExecution/FiscalDocument).
  /// Sempre null para ocorrencias criadas pelo fluxo administrativo, unico
  /// por tenant (Postgres permite multiplos NULL sob unique).
  deviceEventId      String?                @unique @map("device_event_id")
  createdBy          String                 @map("created_by") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip             Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripDeliveryStop TripDeliveryStop? @relation(fields: [tripDeliveryStopId], references: [id], onDelete: SetNull)
  driverShift      DriverShift?      @relation(fields: [driverShiftId], references: [id], onDelete: SetNull)
  driver           Driver?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  attachment       Attachment?       @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  creator          UserAccount       @relation("TripOccurrenceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  resolver         UserAccount?      @relation("TripOccurrenceResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  /// Fase 102 -- documentos/evidencias vinculados via FiscalDocument.tripOccurrenceId
  /// (mecanismo generico, distinto do attachmentId unico acima).
  fiscalDocuments  FiscalDocument[]

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@index([tenantId, tripDeliveryStopId])
  @@index([tenantId, severity])
  @@index([tenantId, occurredAt])
  @@index([tenantId, driverId])
  @@index([tenantId, vehicleId])
  @@map("trip_occurrences")
}

// ============================================================================
// CLIENTES E LOCAIS
// ============================================================================

/// Embarcador -- dono da carga transportada.
model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  document  String?  @db.VarChar(20) // CNPJ/CPF
  /// Fase 93 -- CRM: informacoes comerciais basicas do cliente (nao
  /// existiam ate aqui -- mesmo padrao ja usado por Driver/
  /// MaintenanceProvider/FuelStation, nunca um cadastro paralelo).
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trips                 Trip[]
  revenues              TripRevenue[]
  fiscalDocuments       FiscalDocument[]
  /// Fase 59 -- gestao de fretes, contratos e tabelas de frete.
  contracts             Contract[]
  freightTables         FreightTable[]
  /// Fase 72 -- contas a receber originadas do faturamento das viagens.
  receivables           Receivable[]
  /// Fase 88 -- paradas/entregas planejadas onde este cliente e o destinatario.
  tripDeliveryStops     TripDeliveryStop[]
  /// Fase 93 -- CRM: pessoas de contato e observacoes/interacoes comerciais.
  contacts              CustomerContact[]
  notes                 CustomerNote[]
  /// Fase 94 -- solicitacoes de cotacao de transporte feitas pelo cliente.
  quotations            Quotation[]
  /// Fase 95 -- propostas comerciais formais emitidas para o cliente.
  proposals             Proposal[]
  /// Fase 96 -- oportunidades do pipeline comercial deste cliente.
  pipelineOpportunities PipelineOpportunity[]

  @@index([tenantId])
  @@map("customers")
}

/// Fase 93 -- pessoa de contato do cliente (comprador, financeiro,
/// logistica...). Nao existia estrutura equivalente -- Customer nao tinha
/// nenhum campo de contato ate esta fase. "role" e texto livre (mesmo
/// principio ja usado em Vehicle.category): cargo/funcao varia demais entre
/// empresas para travar num enum.
model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  name       String
  role       String?
  phone      String?
  email      String?
  notes      String?
  /// Indicacao manual de qual contato acionar primeiro -- nunca inferido.
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Fase 94 -- cotacoes que citam este contato como solicitante.
  quotations Quotation[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@map("customer_contacts")
}

/// Fase 93 -- observacao/interacao comercial em texto livre (ligacao,
/// reuniao, negociacao, follow-up) -- um registro por interacao, mais
/// proximo de um log do que de um campo editavel: nunca atualizado depois
/// de criado (mesmo espirito de AuditLog/TripOccurrence -- historico nunca
/// reescrito), so pode ser removido quando lancado por engano.
model CustomerNote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  content    String   @db.Text
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creator  UserAccount @relation("CustomerNoteCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@map("customer_notes")
}

/// Local de carga/descarga -- fabrica, CD, porto, terminal, cliente, filial.
/// Reutilizavel entre viagens (a mesma fabrica e cadastrada uma vez).
model Location {
  id        String                                @id @default(uuid()) @db.Uuid
  tenantId  String                                @map("tenant_id") @db.Uuid
  name      String
  type      LocationType                          @default(OTHER)
  address   String?
  /// Ponto geografico (PostGIS). Tipo nao suportado nativamente pelo Prisma.
  geoPoint  Unsupported("geometry(Point, 4326)")? @map("geo_point")
  createdAt DateTime                              @default(now()) @map("created_at")
  updatedAt DateTime                              @updatedAt @map("updated_at")

  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fleets                    Fleet[]
  tripsAsOrigin             Trip[]             @relation("TripOrigin")
  tripsAsDestination        Trip[]             @relation("TripDestination")
  /// Fase 59 -- criterio opcional de origem/destino de uma FreightRule.
  freightRulesAsOrigin      FreightRule[]      @relation("FreightRuleOrigin")
  freightRulesAsDestination FreightRule[]      @relation("FreightRuleDestination")
  /// Fase 88 -- paradas/entregas planejadas que usam este local como destino.
  tripDeliveryStops         TripDeliveryStop[]
  /// Fase 94 -- cotacoes que usam este local como origem/destino.
  quotationsAsOrigin        Quotation[]        @relation("QuotationOrigin")
  quotationsAsDestination   Quotation[]        @relation("QuotationDestination")

  @@index([tenantId])
  @@map("locations")
}

// ============================================================================
// COMPOSICAO DE VEICULO — cavalo + implementos + eixos
// ============================================================================

/// Composicao de cavalo mecanico + implementos, com configuracao de eixos.
/// tripId e OPCIONAL de proposito: a composicao pode ser montada/testada
/// pela gestao de frota (esta fase) ANTES de existir uma Trip -- o modulo
/// de Viagens (fase futura) associa tripId quando a viagem e criada. Quando
/// associada, e 1:1 com Trip (unique).
model TripComposition {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tripId    String?  @unique @map("trip_id") @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip              Trip?                    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle           Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  trailers          TripCompositionTrailer[]
  axleConfiguration AxleConfiguration?
  axleEvents        AxleEvent[]

  @@index([tenantId])
  @@index([vehicleId])
  @@map("trip_compositions")
}

/// Implemento(s) daquela composicao, com posicao (1a carreta, 2a carreta --
/// cobre bitrem/rodotrem com multiplos implementos).
model TripCompositionTrailer {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  tripCompositionId String @map("trip_composition_id") @db.Uuid
  trailerId         String @map("trailer_id") @db.Uuid
  positionOrder     Int    @map("position_order")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tripComposition TripComposition @relation(fields: [tripCompositionId], references: [id], onDelete: Cascade)
  trailer         Trailer         @relation(fields: [trailerId], references: [id], onDelete: Restrict)

  @@unique([tripCompositionId, positionOrder])
  @@index([tenantId])
  @@index([trailerId])
  @@map("trip_composition_trailers")
}

/// Snapshot da configuracao de eixos para a composicao daquela viagem --
/// eixo levantado normalmente NAO e cobrado, entao essa configuracao
/// determina a categoria de cobranca em TollRate/TollPrediction/TollTransaction.
model AxleConfiguration {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  tripCompositionId String   @unique @map("trip_composition_id") @db.Uuid
  totalAxles        Int      @map("total_axles")
  raisedAxles       Int      @default(0) @map("raised_axles")
  loweredAxles      Int      @default(0) @map("lowered_axles")
  suspendedAxles    Int      @default(0) @map("suspended_axles")
  steeringAxles     Int      @default(0) @map("steering_axles")
  tractionAxles     Int      @default(0) @map("traction_axles")
  /// Categoria calculada (padrao usado pelas concessionarias, ex: "2 eixos"),
  /// derivada dos campos acima -- usada para casar com TollRate.axleCategory.
  billableCategory  String   @map("billable_category")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tripComposition TripComposition @relation(fields: [tripCompositionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("axle_configurations")
}

// ============================================================================
// VIAGEM — ciclo de vida, rota, eventos, rastreamento, alertas
// ============================================================================

/// Viagem. Estados: PLANNED -> IN_PROGRESS -> COMPLETED | CANCELLED.
/// Replanejamento e um evento dentro de IN_PROGRESS, nao um status proprio.
model Trip {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  customerId            String?         @map("customer_id") @db.Uuid
  driverId              String?         @map("driver_id") @db.Uuid
  originLocationId      String          @map("origin_location_id") @db.Uuid
  destinationLocationId String          @map("destination_location_id") @db.Uuid
  /// Rota de pedagio (Fase 23) -- corredor operacional conhecido, usado
  /// para determinar deterministicamente as pracas esperadas na viagem.
  /// Opcional: viagens sem rota continuam funcionando normalmente (nao
  /// entram na conciliacao, mas seguem operando e podendo ter pedagios
  /// registrados manualmente como antes da Fase 23).
  tollRouteId           String?         @map("toll_route_id") @db.Uuid
  /// Rota GEOGRAFICA planejada (Fase 26), calculada por um provider externo
  /// (ver RoutePlan) -- distinta de tollRouteId (corredor operacional
  /// manual da Fase 23; os dois convivem, nenhum substitui o outro).
  /// Aponta para qual das RoutePlan desta viagem (podem existir varias:
  /// alternativas + recalculos historicos) e a atualmente selecionada/ativa.
  routePlanId           String?         @unique @map("route_plan_id") @db.Uuid
  status                TripStatus      @default(PLANNED)
  priority              TripPriority    @default(NORMAL)
  /// Carregado ou vazio, informado pelo motorista na largada (Fase 27) --
  /// nulo em viagens antigas/nao iniciadas por este fluxo.
  loadStatus            TripLoadStatus? @map("load_status")
  /// Odometro do veiculo no momento da largada, informado pelo motorista
  /// (Fase 27) -- distinto de Vehicle.odometerKm (que reflete a leitura MAIS
  /// RECENTE do veiculo, atualizada a cada abastecimento/conclusao). Gravado
  /// uma unica vez (primeiro start nunca e sobrescrito por retomadas).
  initialOdometerKm     Decimal?        @map("initial_odometer_km") @db.Decimal(10, 1)
  notes                 String?
  plannedDeparture      DateTime?       @map("planned_departure")
  plannedArrival        DateTime?       @map("planned_arrival")
  actualDeparture       DateTime?       @map("actual_departure")
  actualArrival         DateTime?       @map("actual_arrival")
  /// Exclusao logica -- so permitida enquanto a viagem nunca saiu do
  /// planejamento (ver regra em TripsService: apenas PLANNED/CANCELLED).
  deletedAt             DateTime?       @map("deleted_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  driver           Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  origin           Location   @relation("TripOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destination      Location   @relation("TripDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  tollRoute        TollRoute? @relation(fields: [tollRouteId], references: [id], onDelete: SetNull)
  // routePlanId aponta para a RoutePlan ATUAL entre as varias que a viagem
  // pode acumular (relation nomeada "CurrentRoutePlan", distinta da relation
  // 1:N "TripRoutePlans" abaixo, que e o historico completo via
  // RoutePlan.tripId) -- ver comentario em RoutePlan.
  currentRoutePlan RoutePlan? @relation("CurrentRoutePlan", fields: [routePlanId], references: [id], onDelete: SetNull)

  composition         TripComposition?
  routeVersions       RouteVersion[]
  routeEvents         RouteEvent[]
  routePlans          RoutePlan[]          @relation("TripRoutePlans")
  trackingPoints      TrackingPoint[]
  alerts              Alert[]
  tollTransactions    TollTransaction[]
  expenses            TripExpense[]
  revenues            TripRevenue[]
  advances            TripAdvance[]
  settlement          TripSettlement?
  fuelSupplies        FuelSupply[]
  metrics             TripMetrics?
  driverShifts        DriverShift[]
  tripOccurrences     TripOccurrence[]
  telemetry           Telemetry[]
  tripStops           TripStop[]
  /// Fase 88 -- paradas/entregas PLANEJADAS (distinto de tripStops acima,
  /// que sao paradas OPERACIONAIS detectadas pelo app do motorista).
  tripDeliveryStops   TripDeliveryStop[]
  axleEvents          AxleEvent[]
  checklistExecutions ChecklistExecution[]
  fiscalDocuments     FiscalDocument[]
  /// Fase 59 -- resultado comercial (contrato/tabela/regra/valores) aplicado
  /// a esta viagem. 1:1 opcional -- viagem sem cotacao comercial continua
  /// funcionando normalmente.
  freight             TripFreight?
  /// Fase 60 -- faturamento operacional (situacao/valor faturavel/faturado)
  /// desta viagem. 1:1 opcional.
  billing             TripBilling?
  /// Fase 72 -- contas a receber geradas a partir do faturamento desta
  /// viagem. Na pratica no maximo 1 (billing.id e @unique em Receivable),
  /// mas declarada como lista por nao haver constraint de unicidade
  /// direta em tripId aqui (a idempotencia real e por billingId).
  receivables         Receivable[]
  /// Fase 73 -- contas a pagar geradas a partir das despesas desta viagem.
  payables            Payable[]
  /// Fase 94 -- cotacao de origem, quando esta viagem foi criada a partir da
  /// conversao de uma cotacao aprovada (ver Quotation.convertedTripId).
  sourceQuotation     Quotation?

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  /// Fase 93 -- historico de viagens por cliente (CRM), consulta ja
  /// existente (GET /trips?customerId=) que nunca tinha indice dedicado.
  @@index([tenantId, customerId])
  @@map("trips")
}

/// Versao imutavel da rota de uma viagem. Cada replanejamento cria uma nova
/// versao -- nunca se edita uma versao existente.
model RouteVersion {
  id            String                                     @id @default(uuid()) @db.Uuid
  tenantId      String                                     @map("tenant_id") @db.Uuid
  tripId        String                                     @map("trip_id") @db.Uuid
  versionNumber Int                                        @map("version_number")
  reason        RouteVersionReason                         @default(INITIAL)
  /// Geometria da rota (PostGIS linestring). Nao suportado nativamente.
  geometry      Unsupported("geometry(LineString, 4326)")?
  createdAt     DateTime                                   @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip            Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tollPredictions TollPrediction[]
  triggeringEvent RouteEvent?      @relation("RouteEventResult")

  @@unique([tripId, versionNumber])
  @@index([tenantId])
  @@map("route_versions")
}

/// Evento que motiva alerta e, quando exige desvio de fato, uma nova
/// RouteVersion. Nem todo evento gera replanejamento.
model RouteEvent {
  id                      String         @id @default(uuid()) @db.Uuid
  tenantId                String         @map("tenant_id") @db.Uuid
  tripId                  String         @map("trip_id") @db.Uuid
  type                    RouteEventType
  detectedAt              DateTime       @default(now()) @map("detected_at")
  resolvedAt              DateTime?      @map("resolved_at")
  resultingRouteVersionId String?        @unique @map("resulting_route_version_id") @db.Uuid
  /// Fase 26 -- quando o evento (tipicamente DEVIATION, detectado
  /// automaticamente a partir de TrackingPoint x RoutePlan.encodedPolyline)
  /// resulta num recalculo de rota geografica, aponta para o RoutePlan
  /// gerado. Mesma convencao de resultingRouteVersionId (FK opcional/unica),
  /// mas para o novo conceito de rota (RoutePlan), nao a rota operacional.
  resultingRoutePlanId    String?        @unique @map("resulting_route_plan_id") @db.Uuid

  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip                  Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  resultingRouteVersion RouteVersion? @relation("RouteEventResult", fields: [resultingRouteVersionId], references: [id], onDelete: SetNull)
  resultingRoutePlan    RoutePlan?    @relation("RouteEventRoutePlanResult", fields: [resultingRoutePlanId], references: [id], onDelete: SetNull)
  alerts                Alert[]

  @@index([tenantId])
  @@index([tripId])
  @@map("route_events")
}

/// Origem da estimativa de pedagio de uma RoutePlan (Fase 26). MATCHED_PLAZAS
/// = soma das RoutePlanToll casadas com TollPlaza (fonte preferida, mais
/// precisa); PROVIDER_AGGREGATE = a API de rotas informou que ha pedagio na
/// rota e devolveu um valor agregado, mas nenhuma praca individual pode ser
/// identificada com confianca no catalogo (nunca inventamos uma praca so
/// para "explicar" esse valor); NONE = sem qualquer informacao de pedagio.
enum RouteTollEstimateSource {
  MATCHED_PLAZAS
  PROVIDER_AGGREGATE
  NONE

  @@map("route_toll_estimate_source")
}

/// Confianca da correspondencia entre uma praca descoberta na rota e uma
/// TollPlaza do catalogo (Fase 26). MATCHED = dentro da tolerancia
/// configurada; UNMATCHED = candidato identificado (coordenadas de um
/// provider futuro que devolva pracas nomeadas), mas sem correspondencia
/// confiavel -- nunca vira uma TollPlaza nova automaticamente.
enum TollMatchStatus {
  MATCHED
  UNMATCHED

  @@map("toll_match_status")
}

/// Rota GEOGRAFICA planejada (Fase 26), calculada por um RoutingProvider
/// externo (ver apps/api/src/routing). DISTINTA de TollRoute (Fase 23,
/// corredor operacional manual por nome/praca, sem geolocalizacao) -- as
/// duas convivem, nenhuma substitui a outra (ver Trip.tollRouteId x
/// Trip.routePlanId). Uma Trip pode acumular varias RoutePlan ao longo do
/// tempo (alternativas oferecidas + recalculos apos desvio) -- a relation
/// "TripRoutePlans" (via tripId) e o historico completo; Trip.routePlanId
/// ("CurrentRoutePlan") aponta para qual delas esta ativa agora. Nunca
/// editada apos criada (mesmo espirito de imutabilidade de RouteVersion) --
/// um recalculo sempre cria uma RoutePlan nova, nunca atualiza uma existente.
model RoutePlan {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  tripId               String                  @map("trip_id") @db.Uuid
  /// Composicao/veiculo cujo AxleConfiguration.totalAxles foi usado para
  /// estimar o pedagio (snapshot -- ver axleCountUsed). Nao duplica dados do
  /// veiculo, so referencia.
  vehicleId            String?                 @map("vehicle_id") @db.Uuid
  originLabel          String                  @map("origin_label")
  destinationLabel     String                  @map("destination_label")
  originLatitude       Decimal                 @map("origin_latitude") @db.Decimal(10, 7)
  originLongitude      Decimal                 @map("origin_longitude") @db.Decimal(10, 7)
  destinationLatitude  Decimal                 @map("destination_latitude") @db.Decimal(10, 7)
  destinationLongitude Decimal                 @map("destination_longitude") @db.Decimal(10, 7)
  distanceMeters       Int                     @map("distance_meters")
  durationSeconds      Int                     @map("duration_seconds")
  /// Geometria codificada no formato "encoded polyline" do Google (algoritmo
  /// publico, reaproveitavel por qualquer provider) -- evita depender de
  /// PostGIS/SQL bruto (Unsupported() no Prisma) para o caso de uso desta
  /// fase. Decodificada sob demanda (ver routing/utils/polyline.util.ts).
  encodedPolyline      String                  @map("encoded_polyline") @db.Text
  /// Soma das RoutePlanToll.estimatedAmount conhecidas, OU o valor agregado
  /// do provider quando nao ha nenhuma praca casada (ver tollEstimateSource).
  /// Sempre uma PREVISAO -- nunca confundir com cobranca real (TollTransaction).
  totalTollAmount      Decimal?                @map("total_toll_amount") @db.Decimal(10, 2)
  tollEstimateSource   RouteTollEstimateSource @default(NONE) @map("toll_estimate_source")
  currency             String                  @default("BRL") @db.VarChar(3)
  /// Quantidade de eixos usada para estimar pedagio (padrao da composicao no
  /// momento do calculo) -- NUNCA altera AxleConfiguration.totalAxles.
  axleCountUsed        Int?                    @map("axle_count_used")
  /// Motivo desta versao existir -- reaproveita o enum ja criado para
  /// RouteVersion (Fase 23/roadmap), mesmo significado semantico.
  reason               RouteVersionReason      @default(INITIAL)
  /// Identificador do provider usado (ex: "GOOGLE") -- string livre, nao
  /// enum, de proposito: novos providers nao devem exigir migration.
  provider             String
  /// Id da rota no provider, quando ele expuser um (nem todo provider tem).
  providerRouteId      String?                 @map("provider_route_id")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip           Trip            @relation("TripRoutePlans", fields: [tripId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  currentForTrip Trip?           @relation("CurrentRoutePlan")
  tolls          RoutePlanToll[]
  deviationEvent RouteEvent?     @relation("RouteEventRoutePlanResult")

  @@index([tenantId])
  @@index([tripId])
  @@map("route_plans")
}

/// Praca de pedagio descoberta ao longo de uma RoutePlan (Fase 26).
/// Descoberta cruzando a geometria da rota (RoutePlan.encodedPolyline) com o
/// catalogo de TollPlaza (nao o inverso -- a API de rotas usada nesta fase
/// nao devolve uma lista confiavel de pracas nomeadas, so geometria + valor
/// agregado, ver GoogleRoutingProvider). Por isso, nesta implementacao, toda
/// linha aqui criada ja nasce com tollPlazaId preenchido (MATCHED); o campo
/// matchStatus/matchConfidence fica modelado para quando um provider futuro
/// devolver candidatos nomeados que precisem de correspondencia por
/// coordenadas/distancia (ver routing/utils/toll-matching.util.ts).
model RoutePlanToll {
  id                       String          @id @default(uuid()) @db.Uuid
  tenantId                 String          @map("tenant_id") @db.Uuid
  routePlanId              String          @map("route_plan_id") @db.Uuid
  /// Nulo somente quando matchStatus = UNMATCHED.
  tollPlazaId              String?         @map("toll_plaza_id") @db.Uuid
  /// Posicao da praca ao longo da rota (1 = mais proxima da origem).
  sequence                 Int
  latitude                 Decimal         @db.Decimal(10, 7)
  longitude                Decimal         @db.Decimal(10, 7)
  /// Nome exibido -- vem da TollPlaza casada quando houver (nunca inventado
  /// quando UNMATCHED; nesse caso fica um rotulo generico "Praca N").
  name                     String
  distanceFromOriginMeters Int             @map("distance_from_origin_meters")
  /// Sempre uma PREVISAO (TOLL ESTIMATED) -- nulo quando TollPlaza.pricePerAxle
  /// e desconhecido (nunca assumir zero como tarifa valida, mesmo principio
  /// da Fase 22/computeAuditVerdict).
  estimatedAmount          Decimal?        @map("estimated_amount") @db.Decimal(10, 2)
  currency                 String          @default("BRL") @db.VarChar(3)
  axleCountUsed            Int?            @map("axle_count_used")
  matchStatus              TollMatchStatus @default(UNMATCHED) @map("match_status")
  /// Score 0..1 de confianca da correspondencia (1 = distancia zero da
  /// rota). Nulo quando UNMATCHED.
  matchConfidence          Decimal?        @map("match_confidence") @db.Decimal(4, 3)
  /// Fonte da descoberta (ex: "TOLL_PLAZA_MATCH") -- distingue de futuras
  /// fontes (ex: candidato nomeado devolvido por outro provider).
  source                   String
  /// Dados brutos do provider/calculo, quando uteis para auditoria futura
  /// (ex: distancia calculada ate a rota, indice no polyline).
  metadata                 Json?
  createdAt                DateTime        @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routePlan RoutePlan  @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  tollPlaza TollPlaza? @relation(fields: [tollPlazaId], references: [id], onDelete: SetNull)

  @@unique([routePlanId, sequence])
  @@index([tenantId])
  @@index([routePlanId])
  @@index([tollPlazaId])
  @@map("route_plan_tolls")
}

/// Ponto de GPS -- alto volume, granularidade de segundos. Fonte tanto do
/// rastreamento ao vivo (via WebSocket) quanto do replay de viagem.
/// Recomenda-se particionamento por tempo (ex: mensal) em producao.
model TrackingPoint {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  tripId        String     @map("trip_id") @db.Uuid
  latitude      Decimal    @db.Decimal(9, 6)
  longitude     Decimal    @db.Decimal(9, 6)
  speedKmh      Decimal?   @map("speed_kmh") @db.Decimal(5, 2)
  headingDeg    Decimal?   @map("heading_deg") @db.Decimal(5, 2)
  recordedAt    DateTime   @map("recorded_at")
  /// Id gerado pelo dispositivo (app do motorista, Fase 25) -- garante
  /// idempotencia quando o mesmo ponto e reenviado apos reconexao. Nulo para
  /// pontos que venham a ser gerados por outra origem (ex: replay/importacao).
  deviceEventId String?    @unique @map("device_event_id")
  syncedAt      DateTime   @default(now()) @map("synced_at")
  syncStatus    SyncStatus @default(SYNCED) @map("sync_status")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tripId, recordedAt])
  @@map("tracking_points")
}

/// Parada operacional da viagem (Fase 25) -- distinta de TollRouteStop (praca
/// de pedagio ESPERADA pela rota). Detectada pelo app do motorista (veiculo
/// parado na mesma regiao por tempo acima do limite configuravel em
/// TenantSettings) e classificada inicialmente como UNKNOWN; o motorista pode
/// reclassificar depois (FUEL/REST/MEAL/MAINTENANCE/OTHER) sem precisar
/// reabrir a parada.
model TripStop {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  /// Opcional desde a Fase 43 -- uma parada administrativa (patio/garagem
  /// fora de uma viagem ativa) pode existir sem trip. Quando criada pelo
  /// driver-app (fluxo original, Fase 25), tripId continua sempre presente
  /// -- vehicleId/driverId continuam derivados da propria Trip nesse caso,
  /// nunca inventados.
  tripId          String?        @map("trip_id") @db.Uuid
  vehicleId       String         @map("vehicle_id") @db.Uuid
  driverId        String?        @map("driver_id") @db.Uuid
  type            TripStopType   @default(UNKNOWN)
  /// Opcionais desde a Fase 43 -- uma parada administrativa lancada sem
  /// coordenada (ex.: retroativa, informada por telefone) nunca inventa
  /// latitude/longitude; o driver-app continua sempre enviando ambos.
  latitude        Decimal?       @db.Decimal(9, 6)
  longitude       Decimal?       @db.Decimal(9, 6)
  startedAt       DateTime       @map("started_at")
  endedAt         DateTime?      @map("ended_at")
  /// Sempre calculado (endedAt - startedAt) no fechamento -- nunca aceito do
  /// cliente.
  durationMinutes Int?           @map("duration_minutes")
  /// Nome/local do posto ou ponto identificado -- nulo quando nao for
  /// possivel identificar (nunca inventado, ver regra da Fase 25).
  locationLabel   String?        @map("location_label")
  /// Observacao livre (Fase 43) -- nunca obrigatoria, nunca usada para
  /// inferir classificacao automaticamente.
  notes           String?
  /// Fase 43 -- quem/o que originou o registro (ver enum TripStopSource).
  source          TripStopSource @default(DRIVER_APP)
  /// Fase 43 -- preenchido no cancelamento; um evento cancelado nunca entra
  /// em indicadores/rankings/alertas. "status" (OPEN/COMPLETED/CANCELLED) e
  /// SEMPRE computado a partir de endedAt/cancelledAt na entity/mapper --
  /// nunca uma coluna redundante que poderia dessincronizar.
  cancelledAt     DateTime?      @map("cancelled_at")
  deviceEventId   String         @unique @map("device_event_id")
  syncedAt        DateTime       @default(now()) @map("synced_at")
  syncStatus      SyncStatus     @default(SYNCED) @map("sync_status")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip    Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver  Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, startedAt])
  @@map("trip_stops")
}

/// Parada/entrega PLANEJADA de uma viagem multi-entrega (Fase 88) -- distinta
/// de TripStop acima (parada OPERACIONAL detectada pelo app do motorista por
/// tempo parado, Fase 25/43). TripDeliveryStop nasce no PLANEJAMENTO
/// (sequencia, cliente, local, previsao manual de chegada) e evolui um
/// status proprio (PENDING -> IN_PROGRESS -> COMPLETED/CANCELLED) conforme a
/// entrega efetivamente acontece -- os dois conceitos nunca se confundem nem
/// se fundem numa tabela so. A viagem continua tendo um unico par
/// origin/destinationLocationId (Trip); as paradas aqui sao os pontos
/// intermediarios de entrega dentro dessa mesma viagem.
model TripDeliveryStop {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  tripId         String                 @map("trip_id") @db.Uuid
  /// Posicao da parada na viagem (1, 2, 3...) -- unica dentro da viagem.
  sequence       Int
  /// Destinatario, quando ja cadastrado (Fase 88 nao exige Customer -- uma
  /// parada pode existir so com o local).
  customerId     String?                @map("customer_id") @db.Uuid
  /// Local de entrega -- reaproveita Location (mesmo model usado por
  /// Trip.origin/destinationLocationId), nunca um endereco solto paralelo.
  locationId     String                 @map("location_id") @db.Uuid
  status         TripDeliveryStopStatus @default(PENDING)
  /// Previsao de chegada informada manualmente no planejamento -- NUNCA
  /// calculada por algoritmo (roteirizacao/ETA fica para a Fase 89).
  plannedArrival DateTime?              @map("planned_arrival")
  /// Fase 99 -- EXECUCAO real, sempre DERIVADA da propria transicao de
  /// status (nunca informada manualmente, mesmo espirito de
  /// PipelineOpportunity.wonAt/lostAt): gravada automaticamente quando a
  /// parada entra em IN_PROGRESS. Junto com plannedArrival, responde
  /// "previsao x execucao" pedido pela fase.
  actualArrival  DateTime?              @map("actual_arrival")
  /// Fase 99 -- gravado automaticamente quando a parada entra em COMPLETED.
  deliveredAt    DateTime?              @map("delivered_at")
  /// Fase 99 -- motivo obrigatorio ao marcar FAILED (mesmo padrao de
  /// PipelineOpportunity.lostReason) -- permite identificar "problema" sem
  /// ainda implementar o modulo completo de ocorrencias (fases futuras).
  failureReason  String?                @map("failure_reason") @db.Text
  notes          String?
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip           Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  location       Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  /// Fase 100 -- comprovantes de entrega (POD) vinculados diretamente a esta
  /// parada, reaproveitando FiscalDocument/Attachment (documentType=
  /// DELIVERY_PROOF) -- nunca um model/armazenamento novo. 0..N por parada
  /// (multiplas evidencias = multiplas linhas, mesmo padrao de
  /// ChecklistEvidence).
  proofDocuments FiscalDocument[]
  /// Fase 101 -- ocorrencias registradas para esta parada especifica,
  /// reaproveitando TripOccurrence (Fase 67) -- nunca um model novo.
  occurrences    TripOccurrence[]

  @@unique([tripId, sequence])
  @@index([tenantId])
  @@index([tenantId, tripId])
  @@index([tenantId, customerId])
  @@index([tenantId, locationId])
  @@index([tenantId, status])
  @@map("trip_delivery_stops")
}

/// Status operacional da parada/entrega planejada (Fase 88). PENDING = ainda
/// nao chegou; IN_PROGRESS = motorista/equipe operando a entrega no local;
/// COMPLETED = entrega concluida; CANCELLED = parada removida do fluxo sem
/// ter sido entregue (nunca conta como concluida); FAILED (Fase 99) =
/// entrega TENTADA mas nao concluida (ex: destinatario ausente, endereco
/// nao localizado) -- distinta de CANCELLED (removida do planejamento antes
/// de qualquer tentativa). Identifica "problema/ocorrencia" sem ainda
/// implementar o modulo completo de ocorrencias (fases futuras).
enum TripDeliveryStopStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED

  @@map("trip_delivery_stop_status")
}

/// Excecao TEMPORARIA de eixos numa praca especifica (Fase 25) -- NUNCA alta
/// AxleConfiguration.totalAxles (que continua sendo o padrao permanente da
/// composicao). Cada passagem com quantidade diferente do padrao gera um
/// registro aqui; o retorno ao padrao apos a praca e implicito (fechamento do
/// evento), sem exigir nenhuma acao do motorista. Serve de historico/consulta
/// para quem lanca a TollTransaction real saber quantos eixos foram usados
/// naquela passagem -- nao gera a transacao sozinho (sem leitura automatica
/// de tag nesta fase).
model AxleEvent {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  tripId            String          @map("trip_id") @db.Uuid
  tripCompositionId String          @map("trip_composition_id") @db.Uuid
  vehicleId         String          @map("vehicle_id") @db.Uuid
  driverId          String          @map("driver_id") @db.Uuid
  /// Praca de pedagio identificada por proximidade GPS -- nulo quando o app
  /// nao conseguiu identificar a praca com seguranca.
  tollPlazaId       String?         @map("toll_plaza_id") @db.Uuid
  /// Snapshot de AxleConfiguration.totalAxles no momento do evento.
  defaultAxles      Int             @map("default_axles")
  /// Quantidade efetivamente informada (pelo motorista) ou assumida
  /// (timeout) para esta passagem.
  declaredAxles     Int             @map("declared_axles")
  /// Sempre max(defaultAxles - declaredAxles, 0) -- nunca aceito do cliente.
  suspendedAxles    Int             @map("suspended_axles")
  source            AxleEventSource
  startedAt         DateTime        @map("started_at")
  endedAt           DateTime?       @map("ended_at")
  latitude          Decimal         @db.Decimal(9, 6)
  longitude         Decimal         @db.Decimal(9, 6)
  deviceEventId     String          @unique @map("device_event_id")
  syncedAt          DateTime        @default(now()) @map("synced_at")
  syncStatus        SyncStatus      @default(SYNCED) @map("sync_status")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip            Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripComposition TripComposition @relation(fields: [tripCompositionId], references: [id], onDelete: Cascade)
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver          Driver          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  tollPlaza       TollPlaza?      @relation(fields: [tollPlazaId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@index([tollPlazaId])
  @@map("axle_events")
}

/// Evento de sistema (desvio, discrepancia de pedagio, atraso, documento
/// vencendo). Representa O QUE aconteceu -- a entrega ao usuario e Notification.
model Alert {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  tripId           String?       @map("trip_id") @db.Uuid
  routeEventId     String?       @map("route_event_id") @db.Uuid
  type             AlertType
  severity         AlertSeverity @default(MEDIUM)
  message          String
  acknowledgedAt   DateTime?     @map("acknowledged_at")
  acknowledgedById String?       @map("acknowledged_by_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip           Trip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  routeEvent     RouteEvent?    @relation(fields: [routeEventId], references: [id], onDelete: SetNull)
  acknowledgedBy UserAccount?   @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([tenantId])
  @@index([tripId])
  @@map("alerts")
}

/// Entrega de um Alert a um usuario por um canal especifico. Um Alert pode
/// gerar varias Notifications (push + email, por exemplo).
/// Fase 69 -- Centro de Alertas e Notificacoes. Ate aqui, model 100% orfao
/// (zero uso em qualquer service/controller, confirmado por auditoria --
/// diferente de Alert, que e ativo/usado por RoutingService/TripsService/
/// FleetOperationsMetricsService). Ativado como o CENTRO INTERNO de
/// notificacoes: type/title/message/severity/entityType/entityId/readAt
/// sao os campos realmente usados nesta fase (leitura/nao-lida, navegacao
/// para a origem). alertId/channel/status/sentAt sao preservados (sempre
/// nulos nesta fase) para uma fase FUTURA de entrega por canal externo
/// (email/push/whatsapp) -- nunca removidos, nunca reaproveitados com
/// outro significado (nenhuma alteracao destrutiva).
model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  /// Vinculo LEGADO e opcional com o model Alert (ROUTE_DEVIATION/etc) --
  /// as notificacoes desta fase (originadas de FleetAlert/TripOccurrence/
  /// Vehicle/etc) nunca tem um Alert correspondente, portanto opcional.
  alertId     String?              @map("alert_id") @db.Uuid
  recipientId String               @map("recipient_id") @db.Uuid
  /// Fase 69 -- classificacao da notificacao (mesma fonte de verdade do
  /// FleetAlert correspondente, nunca uma segunda logica de deteccao).
  type        NotificationType
  title       String
  message     String
  /// Reaproveita o enum AlertSeverity (LOW/MEDIUM/HIGH/CRITICAL) ja
  /// existente -- nenhum enum de severidade novo.
  severity    AlertSeverity        @default(MEDIUM)
  /// Nome do model de origem (ex: "TripOccurrence", "Vehicle",
  /// "VehicleMaintenance", "Tire", "FuelSupply", "FiscalDocument", "Trip",
  /// "Driver", "TripSettlement") + id do registro -- permite navegar ate a
  /// origem sem duplicar nenhum dado dela aqui.
  entityType  String               @map("entity_type")
  entityId    String               @map("entity_id") @db.Uuid
  /// Preenchido quando o destinatario le a notificacao. Nunca apagada
  /// quando a condicao de origem e resolvida -- historico permanece.
  readAt      DateTime?            @map("read_at")
  /// Dados adicionais de exibicao (ex: placa, tipo da ocorrencia) --
  /// somente o que evita uma consulta extra na tela de listagem, nunca um
  /// snapshot completo da entidade de origem.
  metadata    Json?
  /// Campos legados de entrega por canal externo (Fase 69 nunca preenche;
  /// ver comentario do model acima).
  channel     NotificationChannel?
  status      NotificationStatus?  @default(PENDING)
  sentAt      DateTime?            @map("sent_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alert     Alert?      @relation(fields: [alertId], references: [id], onDelete: SetNull)
  recipient UserAccount @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  /// Deduplicacao (secao 5/17 do pedido Fase 69): o MESMO alerta nunca gera
  /// uma segunda notificacao logica para o mesmo destinatario enquanto a
  /// condicao seguir ativa -- geracao usa createMany({skipDuplicates:true})
  /// contra esta chave, nunca um "findFirst then create" por notificacao.
  @@unique([tenantId, recipientId, type, entityType, entityId])
  @@index([tenantId])
  @@index([alertId])
  @@index([recipientId, readAt])
  @@map("notifications")
}

enum NotificationType {
  CRITICAL_OCCURRENCE
  VEHICLE_UNAVAILABLE
  VEHICLE_MAINTENANCE
  TIRE_NEAR_REPLACEMENT
  FUEL_ODOMETER_REGRESSION
  FISCAL_DOCUMENT_PROBLEM
  TRIP_DELAYED
  DRIVER_SUSPENDED
  DRIVER_INACTIVE
  BILLING_PENDING
  /// Fase 70 -- reaproveita a MESMA classificacao de
  /// trip-compliance.util.ts (computeDeliveryProofStatus), nunca uma
  /// segunda maquina de estados: PENDING = comprovante ja enviado
  /// aguardando revisao (nunca "ausente", a Fase 54 documenta que nao ha
  /// regra de obrigatoriedade configurada -- ver docs/notifications.md).
  DELIVERY_PROOF_PENDING
  DELIVERY_PROOF_PROBLEM
  /// Fase 98 -- reaproveita o MESMO limiar de "vencendo em breve" ja usado
  /// por resolveDocumentExpiryStatus (fleet/utils/document-expiry.util.ts,
  /// 30 dias) -- nunca um segundo limiar. Contract.status=ACTIVE com
  /// endDate dentro do limiar (inclusive ja vencido).
  CONTRACT_EXPIRING
  /// Fase 111 -- ChecklistExecution COMPLETED com item critical+required
  /// respondido NAO (mesmo criterio de hasCriticalNonConformity/
  /// checklist-non-conformity.util.ts, nunca uma segunda regra).
  CHECKLIST_CRITICAL_NON_CONFORMITY

  @@map("notification_type")
}

/// Dados de telemetria do veiculo (ignicao, bateria, combustivel,
/// temperatura, RPM, odometro, velocidade CAN) -- separado de TrackingPoint
/// porque e mais pesado e mais esparso que a posicao GPS.
model Telemetry {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tripId       String?  @map("trip_id") @db.Uuid
  vehicleId    String   @map("vehicle_id") @db.Uuid
  ignitionOn   Boolean? @map("ignition_on")
  batteryLevel Decimal? @map("battery_level") @db.Decimal(5, 2)
  fuelLevel    Decimal? @map("fuel_level") @db.Decimal(5, 2)
  temperatureC Decimal? @map("temperature_c") @db.Decimal(5, 2)
  rpm          Int?
  odometerKm   Decimal? @map("odometer_km") @db.Decimal(10, 2)
  canSpeedKmh  Decimal? @map("can_speed_kmh") @db.Decimal(5, 2)
  recordedAt   DateTime @map("recorded_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip    Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vehicleId, recordedAt])
  @@index([tripId])
  @@map("telemetry")
}

// ============================================================================
// PEDAGIO — praca, tarifa, previsao, cobranca real, auditoria
// ============================================================================

/// Praca de pedagio. Dado de referencia GLOBAL -- nao pertence a um tenant.
// Fase 33 -- catalogo oficial de pedagios (ANTT/ARTESP). Fonte de um dado
// oficial (praca ou tarifa): rastreabilidade obrigatoria (secao 38 da fase --
// "de onde veio essa tarifa?"). Um unico registro por provider (nao "uma
// fonte por sincronizacao"): lastSyncAt/lastSuccessAt/lastFailureAt resumem
// o estado atual; o HISTORICO de execucoes fica em TollDataSyncRun.
enum TollDataProvider {
  ANTT
  /// Fase 35 -- fonte DISTINTA de ANTT (praca/KMZ): tarifas oficiais por
  /// concessao publicadas em paginas proprias do gov.br/antt (ver
  /// AnttConcessionTollDataProvider). Precisa de um valor de enum proprio
  /// porque TollDataSource.provider e @unique -- nao pode compartilhar a
  /// linha ANTT (praca), sob pena de colisao entre os dois providers.
  ANTT_TARIFAS
  /// Fase 36 -- tarifas por concessao estadual do RJ (AGETRANSP). Fonte,
  /// formato e semantica de vigencia diferentes de ANTT_TARIFAS -- valor
  /// de enum proprio pelo mesmo motivo (TollDataSource.provider e
  /// @unique).
  RJ_AGETRANSP
  ARTESP
  OTHER

  @@map("toll_data_provider")
}

enum TollDataSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED

  @@map("toll_data_sync_status")
}

/// Confianca de uma tarifa (Fase 33, secao 20/38). VERIFIED = tem fonte
/// oficial rastreavel (documento/URL/data de coleta) registrada no momento
/// da criacao. PENDING_REVIEW = criada sem uma fonte oficial suficiente
/// (nunca deveria acontecer via fluxo normal, mas o enum existe para nunca
/// forcar um registro inconsistente a virar VERIFIED por omissao). STALE =
/// marcada manualmente quando uma fonte fica indisponivel por muito tempo
/// (ver secao 21 -- nunca apagar o ultimo dado valido). UNAVAILABLE = sem
/// nenhuma tarifa oficial conhecida para aquela praca/categoria.
enum TollRateStatus {
  VERIFIED
  PENDING_REVIEW
  STALE
  UNAVAILABLE

  @@map("toll_rate_status")
}

/// Confianca do vinculo entre uma TollPlaza e um registro de uma fonte
/// externa (Fase 33, secao 5) -- LINKED quando a estrategia deterministica
/// encontrou exatamente 1 candidato; PENDING_REVIEW quando o sincronizador
/// preferiu criar uma praca nova a arriscar mesclar automaticamente duas
/// pracas potencialmente diferentes.
enum TollPlazaMatchConfidence {
  LINKED
  PENDING_REVIEW

  @@map("toll_plaza_match_confidence")
}

model TollPlaza {
  id           String                                @id @default(uuid()) @db.Uuid
  name         String
  operator     String // concessionaria (ex: CCR, Arteris) -- distinta de TagProvider (Sem Parar, ConectCar...), texto livre de proposito
  highway      String?
  /// Quilometro da rodovia onde a praca esta localizada.
  km           Decimal?                              @db.Decimal(10, 3)
  city         String?
  state        String?                               @db.VarChar(2)
  latitude     Decimal?                              @db.Decimal(10, 7)
  longitude    Decimal?                              @db.Decimal(10, 7)
  /// Valor cobrado por eixo -- usado no calculo automatico de
  /// TollTransaction.expectedAmount (valorPorEixo * quantidadeDeEixos).
  /// Distinto de TollRate (tarifa por categoria/periodo, usada nas
  /// previsoes de rota) -- aqui e uma formula linear simples.
  pricePerAxle Decimal?                              @map("price_per_axle") @db.Decimal(10, 2)
  /// Ponto geografico (PostGIS) -- exige SQL bruto, nao exposto via API
  /// nesta fase (mesmo padrao ja usado em Location.geoPoint).
  geoPoint     Unsupported("geometry(Point, 4326)")? @map("geo_point")
  createdAt    DateTime                              @default(now()) @map("created_at")
  updatedAt    DateTime                              @updatedAt @map("updated_at")

  rates           TollRate[]
  predictions     TollPrediction[]
  transactions    TollTransaction[]
  routeStops      TollRouteStop[]
  axleEvents      AxleEvent[]
  routePlanTolls  RoutePlanToll[]
  dataSourceLinks TollPlazaDataSourceLink[]

  @@map("toll_plazas")
}

/// Fonte oficial de dados de pedagio (Fase 33) -- 1 linha por provider
/// (ANTT/ARTESP/OTHER), nunca por execucao. Dado de referencia GLOBAL (sem
/// tenantId), mesmo padrao de TollPlaza/TagProvider.
model TollDataSource {
  id            String           @id @default(uuid()) @db.Uuid
  provider      TollDataProvider @unique
  name          String
  authority     String
  baseUrl       String           @map("base_url")
  enabled       Boolean          @default(true)
  lastSyncAt    DateTime?        @map("last_sync_at")
  lastSuccessAt DateTime?        @map("last_success_at")
  lastFailureAt DateTime?        @map("last_failure_at")
  /// Sanitizado -- nunca contem token/segredo (fontes sao publicas, ver
  /// secao 15 da fase).
  lastError     String?          @map("last_error")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  syncRuns   TollDataSyncRun[]
  plazaLinks TollPlazaDataSourceLink[]
  rates      TollRate[]

  @@map("toll_data_sources")
}

/// Historico de execucoes de sincronizacao (Fase 33, secao 12) -- nunca
/// sobrescrito, 1 linha por execucao (manual ou agendada).
model TollDataSyncRun {
  id               String             @id @default(uuid()) @db.Uuid
  sourceId         String             @map("source_id") @db.Uuid
  provider         TollDataProvider
  startedAt        DateTime           @default(now()) @map("started_at")
  finishedAt       DateTime?          @map("finished_at")
  status           TollDataSyncStatus @default(RUNNING)
  recordsRead      Int                @default(0) @map("records_read")
  recordsCreated   Int                @default(0) @map("records_created")
  recordsUpdated   Int                @default(0) @map("records_updated")
  recordsUnchanged Int                @default(0) @map("records_unchanged")
  recordsRejected  Int                @default(0) @map("records_rejected")
  /// Sanitizado -- nunca contem token/segredo/corpo bruto da fonte.
  errorMessage     String?            @map("error_message")
  /// "scheduler" para execucao automatica, ou o userId do administrador que
  /// disparou a sincronizacao manual (secao 11) -- nunca um motorista.
  triggeredBy      String?            @map("triggered_by")
  createdAt        DateTime           @default(now()) @map("created_at")

  source TollDataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([provider, startedAt])
  @@index([sourceId])
  @@map("toll_data_sync_runs")
}

/// Vinculo deterministico entre uma TollPlaza e o registro correspondente
/// numa fonte externa (Fase 33, secao 5) -- evita recriar a praca a cada
/// sincronizacao (idempotencia) sem nunca mesclar automaticamente duas
/// pracas quando a correspondencia e ambigua (ver TollDataSyncService).
model TollPlazaDataSourceLink {
  id              String                   @id @default(uuid()) @db.Uuid
  tollPlazaId     String                   @map("toll_plaza_id") @db.Uuid
  sourceId        String                   @map("source_id") @db.Uuid
  provider        TollDataProvider
  /// Chave deterministica derivada da fonte (concessionaria+rodovia+km+nome
  /// normalizados) -- nunca so nome, nunca so coordenada (secao 5).
  sourceKey       String                   @map("source_key")
  matchConfidence TollPlazaMatchConfidence @default(LINKED) @map("match_confidence")
  /// Ultimo registro bruto normalizado da fonte, para auditoria futura --
  /// nunca usado para decidir regra de negocio (so leitura humana).
  rawSnapshot     Json?                    @map("raw_snapshot")
  lastSeenAt      DateTime                 @map("last_seen_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  tollPlaza TollPlaza      @relation(fields: [tollPlazaId], references: [id], onDelete: Cascade)
  source    TollDataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([provider, sourceKey])
  @@index([tollPlazaId])
  @@index([sourceId])
  @@map("toll_plaza_data_source_links")
}

/// Rota de pedagio (Fase 23) -- corredor operacional conhecido pela
/// transportadora (ex: "Sao Jose do Rio Preto -> Sao Paulo"), usado para
/// determinar deterministicamente quais pracas sao esperadas numa viagem,
/// SEM depender de geolocalizacao/roteirizacao automatica (fora de escopo
/// desta fase -- ver TollPrediction/RouteVersion para a abordagem
/// geografica, ainda nao usada por nenhum codigo). originLabel/
/// destinationLabel sao texto livre (nome de cidade/regiao), distintos de
/// Location (que representa um endereco operacional especifico de
/// embarque/descarga) -- um corredor de pedagio e um conceito de rodovia,
/// nao de endereco.
model TollRoute {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  originLabel      String   @map("origin_label")
  destinationLabel String   @map("destination_label")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stops  TollRouteStop[]
  trips  Trip[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("toll_routes")
}

/// Parada (praca esperada) de uma TollRoute, em ordem. A mesma TollPlaza
/// pode participar de varias rotas; uma rota nao pode repetir a mesma praca
/// duas vezes (ver @@unique abaixo) -- TollPlaza continua sendo a unica
/// fonte de verdade da praca, esta tabela so guarda a ORDEM dela dentro de
/// uma rota especifica.
model TollRouteStop {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  tollRouteId String @map("toll_route_id") @db.Uuid
  tollPlazaId String @map("toll_plaza_id") @db.Uuid
  /// Posicao da praca na rota (1 = primeira praca esperada).
  sequence    Int

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tollRoute TollRoute @relation(fields: [tollRouteId], references: [id], onDelete: Cascade)
  tollPlaza TollPlaza @relation(fields: [tollPlazaId], references: [id], onDelete: Restrict)

  @@unique([tollRouteId, sequence])
  @@unique([tollRouteId, tollPlazaId])
  @@index([tenantId])
  @@index([tollPlazaId])
  @@map("toll_route_stops")
}

/// Tarifa por praca e categoria de eixos, versionada no tempo (effectiveFrom)
/// -- preserva o valor correto historico mesmo que a tarifa mude depois.
/// Dado de referencia GLOBAL. Estendida na Fase 33 (rastreabilidade da
/// fonte oficial, vigencia com fim explicito, status de confianca) -- os
/// 3 campos originais (tollPlazaId/axleCategory/price/effectiveFrom) e a
/// tabela em si ja existiam desde antes (nunca usados por nenhum service
/// ate a Fase 33: ver relatorio final da fase para o achado da auditoria).
model TollRate {
  id              String         @id @default(uuid()) @db.Uuid
  tollPlazaId     String         @map("toll_plaza_id") @db.Uuid
  axleCategory    String         @map("axle_category") // ex: "2 eixos", "9 eixos"
  price           Decimal        @db.Decimal(10, 2)
  currency        String         @default("BRL") @db.VarChar(3)
  effectiveFrom   DateTime       @map("effective_from")
  /// Nulo = ainda vigente (a tarifa mais recente de uma categoria nunca tem
  /// effectiveUntil preenchido; quando uma nova versao e criada, a anterior
  /// passa a ter effectiveUntil = novo effectiveFrom, ver TollTariffService).
  effectiveUntil  DateTime?      @map("effective_until")
  status          TollRateStatus @default(PENDING_REVIEW)
  /// Fonte oficial (ANTT/ARTESP/OTHER) -- nulo apenas para tarifas legadas
  /// anteriores a Fase 33 (nenhuma existia em producao, mas o campo fica
  /// opcional por seguranca/compatibilidade de schema).
  sourceId        String?        @map("source_id") @db.Uuid
  /// Referencia textual ao documento oficial (ex: numero da deliberacao/ato,
  /// nome do arquivo) -- nunca inventado, preenchido pelo importador ou pelo
  /// administrador que registrou a tarifa.
  sourceDocument  String?        @map("source_document")
  /// URL ou identificador oficial de onde o valor foi obtido.
  sourceReference String?        @map("source_reference")
  /// Quando o dado foi efetivamente coletado/registrado (distinto de
  /// effectiveFrom, que e a vigencia OFICIAL da tarifa).
  collectedAt     DateTime?      @map("collected_at")
  createdBy       String?        @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tollPlaza TollPlaza       @relation(fields: [tollPlazaId], references: [id], onDelete: Cascade)
  source    TollDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  creator   UserAccount?    @relation("TollRateCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([tollPlazaId, axleCategory, effectiveFrom])
  @@index([tollPlazaId])
  @@index([tollPlazaId, axleCategory, effectiveFrom])
  @@index([sourceId])
  @@index([status])
  @@map("toll_rates")
}

/// Custo de pedagio previsto por praca, calculado para uma versao de rota
/// especifica. Recalculado a cada replanejamento (nova RouteVersion).
model TollPrediction {
  id              String   @id @default(uuid()) @db.Uuid
  routeVersionId  String   @map("route_version_id") @db.Uuid
  tollPlazaId     String   @map("toll_plaza_id") @db.Uuid
  predictedAmount Decimal  @map("predicted_amount") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  routeVersion RouteVersion @relation(fields: [routeVersionId], references: [id], onDelete: Cascade)
  tollPlaza    TollPlaza    @relation(fields: [tollPlazaId], references: [id], onDelete: Restrict)
  audits       TollAudit[]

  @@index([routeVersionId])
  @@index([tollPlazaId])
  @@map("toll_predictions")
}

/// Cobranca real ocorrida em uma praca. Vincula-se a Trip e a TollPlaza --
/// NUNCA diretamente a uma RouteVersion; e a TollAudit quem cruza os dois
/// (conciliacao com a PREVISAO de rota). vehicleId/driverId/tagProviderId
/// sao denormalizados a partir da Trip/tag ativa no momento do registro --
/// mesma convencao ja adotada no projeto (tenant_id denormalizado em toda
/// tabela operacional) para permitir filtros/relatorios diretos sem joins
/// complexos e sensiveis a mudanca de tag ao longo do tempo.
model TollTransaction {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  tripId            String                @map("trip_id") @db.Uuid
  vehicleId         String                @map("vehicle_id") @db.Uuid
  driverId          String?               @map("driver_id") @db.Uuid
  tollPlazaId       String                @map("toll_plaza_id") @db.Uuid
  tagProviderId     String?               @map("tag_provider_id") @db.Uuid
  axleCount         Int                   @map("axle_count")
  /// Calculado automaticamente: TollPlaza.pricePerAxle * axleCount.
  expectedAmount    Decimal               @map("expected_amount") @db.Decimal(10, 2)
  chargedAmount     Decimal               @map("charged_amount") @db.Decimal(10, 2)
  /// Calculado automaticamente: chargedAmount - expectedAmount.
  discrepancyAmount Decimal               @map("discrepancy_amount") @db.Decimal(10, 2)
  /// Classificacao automatica (NORMAL/DIVERGENT/EXEMPT) -- ver
  /// TollTransactionsService. Distinta de TollAudit.status (que conciliar
  /// com a PREVISAO de rota, nao com a formula simples de valor por eixo).
  status            TollTransactionStatus @default(NORMAL)
  chargedAt         DateTime              @map("charged_at")
  source            TollTransactionSource @default(INTEGRATION)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver      Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  tollPlaza   TollPlaza    @relation(fields: [tollPlazaId], references: [id], onDelete: Restrict)
  tagProvider TagProvider? @relation(fields: [tagProviderId], references: [id], onDelete: SetNull)
  audit       TollAudit?

  @@index([tenantId])
  @@index([tripId])
  @@index([tollPlazaId, chargedAt])
  @@index([tenantId, vehicleId])
  @@index([tenantId, driverId])
  @@index([tenantId, status])
  @@index([tenantId, tagProviderId])
  @@map("toll_transactions")
}

/// Job de importacao de extrato de pedagio enviado por uma operadora (Fase
/// 15). O parser real (CSV/XLSX hoje; XML/TXT/API_INTEGRATION preparados
/// para o futuro) e escolhido dinamicamente a partir de fileType, sem exigir
/// mudanca de schema para suportar um novo formato.
model ImportJob {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  providerId       String          @map("provider_id") @db.Uuid
  /// Nome do arquivo no storage privado (gerado, nunca o nome original --
  /// evita colisao/overwrite e nao expoe o nome enviado pelo usuario no disco).
  filename         String
  originalFilename String          @map("original_filename")
  fileType         ImportFileType  @map("file_type")
  status           ImportJobStatus @default(PENDING)
  importedRecords  Int             @default(0) @map("imported_records")
  ignoredRecords   Int             @default(0) @map("ignored_records")
  errorRecords     Int             @default(0) @map("error_records")
  startedAt        DateTime?       @map("started_at")
  finishedAt       DateTime?       @map("finished_at")
  createdBy        String          @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  /// Fase 48 -- tamanho real do arquivo (Express.Multer.File.size) para
  /// enforcement de limite de armazenamento do plano. Nullable: jobs
  /// anteriores a esta fase ficam NULL (nunca estimado retroativamente),
  /// excluidos da soma de uso real.
  sizeBytes        Int?            @map("size_bytes")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider TagProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  creator  UserAccount      @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  errors   ImportJobError[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([providerId])
  @@map("import_jobs")
}

/// Detalhe de uma linha do extrato nao importada (erro de validacao ou
/// duplicidade) -- nunca interrompe o job inteiro, apenas registra a
/// inconsistencia daquela linha especifica. Alimenta GET /toll-import/:id/errors.
model ImportJobError {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  importJobId String             @map("import_job_id") @db.Uuid
  rowNumber   Int                @map("row_number")
  issueType   ImportRowIssueType @map("issue_type")
  message     String
  /// Snapshot da linha original do arquivo, para o usuario conseguir
  /// corrigir e reenviar sem precisar abrir o arquivo de novo.
  rawData     Json               @map("raw_data")
  createdAt   DateTime           @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([tenantId])
  @@map("import_job_errors")
}

/// Conciliacao entre valor previsto e valor cobrado. SEMPRE derivada/
/// calculada -- nunca editada manualmente.
model TollAudit {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  tollTransactionId String          @unique @map("toll_transaction_id") @db.Uuid
  tollPredictionId  String?         @map("toll_prediction_id") @db.Uuid
  discrepancyAmount Decimal?        @map("discrepancy_amount") @db.Decimal(10, 2)
  status            TollAuditStatus @default(PENDING)
  calculatedAt      DateTime        @default(now()) @map("calculated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tollTransaction TollTransaction @relation(fields: [tollTransactionId], references: [id], onDelete: Cascade)
  tollPrediction  TollPrediction? @relation(fields: [tollPredictionId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("toll_audits")
}

// ============================================================================
// FINANCEIRO — despesas e comparativo planejado x executado
// ============================================================================

/// Despesa operacional de uma viagem (abastecimento, alimentacao,
/// hospedagem, manutencao emergencial, etc. -- Fase 16). Toda despesa
/// pertence obrigatoriamente a uma Trip; driverId/vehicleId sao SEMPRE
/// derivados da Trip no momento da criacao (nunca aceitos do cliente), o
/// mesmo principio ja aplicado em TollTransaction (Fase 14). Suporta um
/// fluxo de aprovacao simples (status) e vinculo opcional a um Attachment
/// ja existente (comprovante) -- sem upload de arquivo nesta fase.
model TripExpense {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  tripId         String                @map("trip_id") @db.Uuid
  driverId       String?               @map("driver_id") @db.Uuid
  vehicleId      String?               @map("vehicle_id") @db.Uuid
  category       ExpenseCategory
  description    String
  supplier       String?
  documentNumber String?               @map("document_number")
  expenseDate    DateTime              @map("expense_date")
  amount         Decimal               @db.Decimal(10, 2)
  currency       String                @default("BRL") @db.VarChar(3)
  paymentMethod  ExpensePaymentMethod? @map("payment_method")
  status         ExpenseStatus         @default(PENDING)
  /// Quem tomou a decisao (aprovou OU rejeitou) -- preenchido em ambos os
  /// casos, ja que nao ha um par rejectedBy/rejectedAt dedicado; a decisao
  /// exata fica registrada no AuditLog da acao.
  approvedBy     String?               @map("approved_by") @db.Uuid
  approvedAt     DateTime?             @map("approved_at")
  attachmentId   String?               @map("attachment_id") @db.Uuid
  createdBy      String                @map("created_by") @db.Uuid
  updatedBy      String?               @map("updated_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip       Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver     Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  attachment Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  approver   UserAccount? @relation("TripExpenseApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  creator    UserAccount  @relation("TripExpenseCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater    UserAccount? @relation("TripExpenseUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  /// Fase 73 -- conta a pagar gerada a partir desta despesa (1:1 opcional,
  /// Payable.expenseId e @unique).
  payable    Payable?

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, driverId])
  @@index([tenantId, vehicleId])
  @@map("trip_expenses")
}

/// Receita da viagem (frete, bonificacao, servico extra, seguro -- Fase 17).
/// Toda receita pertence obrigatoriamente a uma Trip do mesmo tenant.
model TripRevenue {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  tripId        String          @map("trip_id") @db.Uuid
  description   String
  category      RevenueCategory
  /// Nunca negativo -- validado tambem no DTO (@Min(0)).
  amount        Decimal         @db.Decimal(10, 2)
  receivedAt    DateTime        @map("received_at")
  invoiceNumber String?         @map("invoice_number")
  customerId    String?         @map("customer_id") @db.Uuid
  attachmentId  String?         @map("attachment_id") @db.Uuid
  createdBy     String          @map("created_by") @db.Uuid
  updatedBy     String?         @map("updated_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip         Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  attachment   Attachment?       @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  creator      UserAccount       @relation("TripRevenueCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater      UserAccount?      @relation("TripRevenueUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  /// Fase 59 -- presente quando esta receita foi gerada a partir de um
  /// valor comercial de frete (ver TripFreight.revenueId, unique).
  tripFreight  TripFreight?
  /// Fase 60 -- presente quando esta receita foi gerada por um lancamento
  /// de faturamento operacional (ver TripBillingEntry.revenueId, unique).
  billingEntry TripBillingEntry?

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@index([tenantId, category])
  @@index([tenantId, customerId])
  @@map("trip_revenues")
}

/// Adiantamento pago ao motorista durante a viagem (Fase 17). driverId e
/// SEMPRE derivado da Trip (nunca aceito do cliente) -- mesmo principio ja
/// aplicado em TripExpense/TollTransaction.
model TripAdvance {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  tripId        String                @map("trip_id") @db.Uuid
  driverId      String                @map("driver_id") @db.Uuid
  description   String
  /// Sempre positivo -- validado tambem no DTO (@IsPositive).
  amount        Decimal               @db.Decimal(10, 2)
  paymentMethod ExpensePaymentMethod? @map("payment_method")
  paidAt        DateTime              @map("paid_at")
  attachmentId  String?               @map("attachment_id") @db.Uuid
  createdBy     String                @map("created_by") @db.Uuid
  updatedBy     String?               @map("updated_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip       Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver     Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  attachment Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  creator    UserAccount  @relation("TripAdvanceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater    UserAccount? @relation("TripAdvanceUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@index([tenantId, driverId])
  @@map("trip_advances")
}

/// Comparativo planejado x executado -- o maior diferencial do sistema.
/// 1:1 com Trip, concentra as metricas de planejamento e de execucao real
/// num so lugar para consultas de inteligencia operacional.
model TripMetrics {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tripId   String @unique @map("trip_id") @db.Uuid

  plannedDistanceKm  Decimal? @map("planned_distance_km") @db.Decimal(10, 2)
  plannedDurationMin Int?     @map("planned_duration_min")
  plannedFuelLiters  Decimal? @map("planned_fuel_liters") @db.Decimal(10, 2)
  plannedTollAmount  Decimal? @map("planned_toll_amount") @db.Decimal(10, 2)
  plannedTotalCost   Decimal? @map("planned_total_cost") @db.Decimal(10, 2)

  actualDistanceKm  Decimal? @map("actual_distance_km") @db.Decimal(10, 2)
  actualDurationMin Int?     @map("actual_duration_min")
  actualFuelLiters  Decimal? @map("actual_fuel_liters") @db.Decimal(10, 2)
  actualTollAmount  Decimal? @map("actual_toll_amount") @db.Decimal(10, 2)
  actualTotalCost   Decimal? @map("actual_total_cost") @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("trip_metrics")
}

/// Fechamento financeiro da viagem (Fase 17) -- 1:1 com Trip, criado (lazy)
/// apenas quando a viagem e fechada pela primeira vez. Os totais sao um
/// SNAPSHOT calculado no momento do fechamento (nao recalculado ao vivo);
/// reabrir (REOPENED) altera apenas o status, nunca apaga o snapshot
/// anterior -- fechar novamente depois de reaberto recalcula os totais.
model TripSettlement {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  tripId        String           @unique @map("trip_id") @db.Uuid
  totalRevenue  Decimal          @default(0) @map("total_revenue") @db.Decimal(12, 2)
  totalExpenses Decimal          @default(0) @map("total_expenses") @db.Decimal(12, 2)
  totalAdvances Decimal          @default(0) @map("total_advances") @db.Decimal(12, 2)
  /// totalRevenue - totalExpenses - totalAdvances -- pode ser negativo
  /// (prejuizo); nunca bloqueia o fechamento.
  netResult     Decimal          @default(0) @map("net_result") @db.Decimal(12, 2)
  status        SettlementStatus @default(OPEN)
  closedBy      String?          @map("closed_by") @db.Uuid
  closedAt      DateTime?        @map("closed_at")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip   Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  closer UserAccount? @relation("TripSettlementCloser", fields: [closedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("trip_settlements")
}

// ============================================================================
// DOCUMENTOS E ANEXOS — genericos, polimorficos
// ============================================================================

/// Documento formal (CRLV, ANTT, CNH, licenciamento, seguro). Dono
/// polimorfico -- pode pertencer a um veiculo, trailer, motorista ou tenant.
model Document {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  type      DocumentType
  ownerType DocumentOwnerType @map("owner_type")
  ownerId   String            @map("owner_id") @db.Uuid
  number    String?
  issuedAt  DateTime?         @map("issued_at")
  expiresAt DateTime?         @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([tenantId, ownerType, ownerId])
  @@index([expiresAt])
  @@map("documents")
}

/// Arquivo anexavel a qualquer entidade (foto do caminhao, da carga, da
/// nota, do pedagio, comprovante). entityName + entityId sao polimorficos,
/// mesmo padrao do ExternalReference. documentId e opcional -- usado quando
/// o anexo e o arquivo de um Document.
model Attachment {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  documentId   String?        @map("document_id") @db.Uuid
  entityName   String         @map("entity_name") // ex: "Trip", "TollTransaction"
  entityId     String         @map("entity_id") @db.Uuid
  type         AttachmentType @default(OTHER)
  storageKey   String         @map("storage_key")
  uploadedById String?        @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  /// Fase 48 -- tamanho real do arquivo (Express.Multer.File.size) para
  /// enforcement de limite de armazenamento do plano. Nullable: anexos
  /// anteriores a esta fase ficam NULL (nunca estimado retroativamente),
  /// excluidos da soma de uso real.
  sizeBytes    Int?           @map("size_bytes")

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document          Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  tripExpenses      TripExpense[]
  tripRevenues      TripRevenue[]
  tripAdvances      TripAdvance[]
  fuelSupplies      FuelSupply[]
  /// Fase 38 -- evidencia de checklist (foto/assinatura) reusa este
  /// mecanismo de storage existente em vez de criar um novo (ver
  /// ChecklistEvidence.attachmentId).
  checklistEvidence ChecklistEvidence[]
  /// Fase 52 -- arquivo do documento fiscal/documental (PDF/XML/JPG/PNG),
  /// mesmo mecanismo generico de storage, nunca um storage novo.
  fiscalDocuments   FiscalDocument[]
  /// Fase 67 -- evidencia de ocorrencia (foto), mesmo mecanismo generico.
  tripOccurrences   TripOccurrence[]

  @@index([tenantId, entityName, entityId])
  @@map("attachments")
}

// ============================================================================
// CHECKLIST OPERACIONAL (Fase 38) — fundacao parametrizavel: Template ->
// Section -> Item -> Execution -> Answer -> Evidence. Suporta qualquer
// modelo de checklist (Sider, Bau, Graneleiro...) sem virar colunas fixas
// no banco -- o formulario real de 32 itens (Sider) e representado como
// dados (sections/items), nunca como schema. Upload real de foto fica para
// fase futura: ChecklistEvidence.attachmentId aponta para o Attachment ja
// existente (nunca um storage novo) quando essa fase existir.
// ============================================================================

enum ChecklistType {
  PRE_TRIP
  POST_TRIP
  MAINTENANCE
  TRAILER
  SAFETY
  ACCIDENT
  AUDIT

  @@map("checklist_type")
}

/// DRAFT = editavel; PUBLISHED = imutavel (alteracao estrutural exige nova
/// versao, ver ChecklistTemplate.previousVersionId); ARCHIVED = fora de uso,
/// nunca aparece em `driver/checklists/available`, mas o historico de
/// execucoes antigas continua consultavel.
enum ChecklistTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("checklist_template_status")
}

/// Extensivel de proposito (seção 7 da Fase 38) -- nesta fase so BOOLEAN e
/// funcionalmente validado ponta a ponta; os demais existem para nao
/// travar a evolucao do formulario (ex: TEXT para observacao, PHOTO para
/// "foto do 1o eixo", ODOMETER para o campo de KM).
enum ChecklistItemType {
  BOOLEAN
  TEXT
  NUMBER
  PHOTO
  SIGNATURE
  ODOMETER
  SELECT

  @@map("checklist_item_type")
}

enum ChecklistExecutionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED

  @@map("checklist_execution_status")
}

enum ChecklistEvidenceType {
  ODOMETER
  AXLE_1
  AXLE_2
  AXLE_3
  GENERAL
  DAMAGE
  SIGNATURE

  @@map("checklist_evidence_type")
}

/// Modelo reutilizavel de checklist. Versionado: uma alteracao estrutural em
/// um template PUBLISHED nunca modifica retroativamente execucoes ja feitas
/// -- cria uma nova linha (nova versao), preservando a antiga intacta e
/// ligada via previousVersionId (mesmo espirito de "fecha o antigo, cria o
/// novo" ja usado em TollRatesService, so que aqui o "fechar" e status
/// PUBLISHED->ARCHIVED feito manualmente pelo admin, nunca automatico).
model ChecklistTemplate {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  name              String
  description       String?
  type              ChecklistType
  /// Tipo de veiculo/carreta ao qual este template se aplica -- reusa os
  /// enums ja existentes (VehicleType/TrailerType), nunca duplicados aqui.
  /// Nenhum dos dois e obrigatorio: um template pode ser generico.
  vehicleType       VehicleType?            @map("vehicle_type")
  trailerType       TrailerType?            @map("trailer_type")
  version           Int                     @default(1)
  status            ChecklistTemplateStatus @default(DRAFT)
  /// Aponta para a versao anterior que este template substitui (preenchido
  /// somente quando criado via POST .../versions). Unique: uma versao
  /// anterior so pode ser sucedida por uma unica nova versao (sem
  /// ramificacao).
  previousVersionId String?                 @unique @map("previous_version_id") @db.Uuid
  publishedAt       DateTime?               @map("published_at")
  archivedAt        DateTime?               @map("archived_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  previousVersion ChecklistTemplate?   @relation("ChecklistTemplateVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion     ChecklistTemplate?   @relation("ChecklistTemplateVersions")
  sections        ChecklistSection[]
  executions      ChecklistExecution[]

  @@index([tenantId, type, status])
  @@map("checklist_templates")
}

/// Agrupamento de itens dentro de um template (ex: SEGURANCA, PNEUS,
/// FREIOS). Pertence a UM template/versao especifica -- nunca compartilhada
/// entre versoes (uma nova versao copia suas proprias sections).
model ChecklistSection {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  title       String
  description String?
  /// Ordem explicita de exibicao (seção 6 da Fase 38) -- nunca inferida da
  /// ordem de insercao no banco.
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    ChecklistItem[]

  @@index([templateId])
  @@map("checklist_sections")
}

/// Pergunta/campo dentro de uma section. `code` e estavel dentro da mesma
/// section (ex: "cinto_seguranca") -- usado como chave de negocio legivel,
/// distinta do uuid.
model ChecklistItem {
  id                  String            @id @default(uuid()) @db.Uuid
  sectionId           String            @map("section_id") @db.Uuid
  code                String
  label               String
  description         String?
  type                ChecklistItemType
  required            Boolean           @default(false)
  order               Int
  requiresObservation Boolean           @default(false) @map("requires_observation")
  requiresPhoto       Boolean           @default(false) @map("requires_photo")
  /// Item cuja resposta negativa representa uma nao-conformidade relevante
  /// (ex: freio, cinto). Nesta fase apenas preserva a informacao (ver
  /// ChecklistExecutionsService.hasCriticalNonConformity) -- nao bloqueia
  /// nada automaticamente (seção 16 da Fase 38).
  critical            Boolean           @default(false)
  /// Configuracao extra especifica do tipo (ex: opcoes de um SELECT). Sem
  /// uso funcional nesta fase -- so BOOLEAN e validado ponta a ponta.
  options             Json?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  section  ChecklistSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers  ChecklistAnswer[]
  evidence ChecklistEvidence[]

  @@unique([sectionId, code])
  @@index([sectionId])
  @@map("checklist_items")
}

/// Uma execucao real de um template, feita por um motorista. `templateId`
/// ja fixa a versao exata (cada versao e uma linha propria de
/// ChecklistTemplate); `templateVersion` e uma copia denormalizada do
/// numero de versao no momento da execucao, so para leitura/exibicao sem
/// join (nunca recalculada depois -- ver seção 5 da Fase 38).
model ChecklistExecution {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  templateId         String                   @map("template_id") @db.Uuid
  templateVersion    Int                      @map("template_version")
  tripId             String?                  @map("trip_id") @db.Uuid
  driverId           String?                  @map("driver_id") @db.Uuid
  vehicleId          String?                  @map("vehicle_id") @db.Uuid
  trailerId          String?                  @map("trailer_id") @db.Uuid
  status             ChecklistExecutionStatus @default(IN_PROGRESS)
  /// Gerado pelo dispositivo -- garante idempotencia (mesmo padrao de
  /// TripStop/AxleEvent/FuelSupply, ver trip-operations).
  deviceEventId      String                   @map("device_event_id")
  startedAt          DateTime                 @default(now()) @map("started_at")
  completedAt        DateTime?                @map("completed_at")
  latitude           Decimal?                 @db.Decimal(10, 7)
  longitude          Decimal?                 @db.Decimal(10, 7)
  address            String?
  /// Valor informado (numero). Distinto da evidencia fotografica do
  /// odometro (ChecklistEvidence type=ODOMETER) -- os dois podem coexistir,
  /// nunca sao confundidos (seção 15 da Fase 38).
  odometerKm         Decimal?                 @map("odometer_km") @db.Decimal(10, 1)
  inspectionLocation String?                  @map("inspection_location")
  responsibleName    String?                  @map("responsible_name")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template     ChecklistTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  trip         Trip?                @relation(fields: [tripId], references: [id], onDelete: SetNull)
  driver       Driver?              @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  trailer      Trailer?             @relation(fields: [trailerId], references: [id], onDelete: SetNull)
  answers      ChecklistAnswer[]
  evidence     ChecklistEvidence[]
  /// Fase 111 -- OS(s) abertas a partir de uma nao-conformidade critica
  /// encontrada neste checklist (ver VehicleMaintenance.checklistExecutionId).
  maintenances VehicleMaintenance[]

  @@unique([tenantId, deviceEventId])
  @@index([tenantId, status])
  @@index([tripId])
  @@index([driverId])
  @@index([vehicleId])
  @@map("checklist_executions")
}

/// Resposta de um item dentro de uma execucao. Unique (executionId, itemId)
/// -- nunca duas respostas para o mesmo item na mesma execucao (seção 8 da
/// Fase 38); reenvio idempotente faz upsert sobre essa mesma chave, nunca
/// cria uma segunda linha.
model ChecklistAnswer {
  id            String   @id @default(uuid()) @db.Uuid
  executionId   String   @map("execution_id") @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  booleanValue  Boolean? @map("boolean_value")
  textValue     String?  @map("text_value")
  numberValue   Decimal? @map("number_value") @db.Decimal(10, 2)
  selectedValue String?  @map("selected_value")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  execution ChecklistExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  item      ChecklistItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  evidence  ChecklistEvidence[]

  @@unique([executionId, itemId])
  @@map("checklist_answers")
}

/// Foto/assinatura associada a uma execucao (e opcionalmente a um item/
/// resposta especifica). `attachmentId` aponta para o Attachment generico
/// ja existente (reusado, nunca um storage novo) -- populado desde a Fase
/// 39 via POST driver/checklists/:id/evidence (multer, disco privado,
/// mesmo padrao de toll-import). `deviceEventId` (Fase 39) garante
/// idempotencia de upload -- mesmo padrao de deviceEventId ja usado em
/// ChecklistExecution/AxleEvent/TripStop. `itemId` (Fase 39) e a
/// associacao PRIMARIA com o item do template -- deliberadamente
/// independente de `answerId` (que so existe depois que a resposta foi
/// enviada ao servidor): a foto de um item PHOTO precisa poder ser
/// capturada e enfileirada offline SEM depender de uma resposta ja
/// confirmada no servidor. `answerId` continua existindo para o caso em
/// que a evidencia complementa uma resposta ja conhecida.
model ChecklistEvidence {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  executionId   String                @map("execution_id") @db.Uuid
  itemId        String?               @map("item_id") @db.Uuid
  answerId      String?               @map("answer_id") @db.Uuid
  type          ChecklistEvidenceType
  attachmentId  String?               @map("attachment_id") @db.Uuid
  deviceEventId String                @map("device_event_id")
  description   String?
  latitude      Decimal?              @db.Decimal(10, 7)
  longitude     Decimal?              @db.Decimal(10, 7)
  capturedAt    DateTime              @default(now()) @map("captured_at")
  createdAt     DateTime              @default(now()) @map("created_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution  ChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  item       ChecklistItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  answer     ChecklistAnswer?   @relation(fields: [answerId], references: [id], onDelete: SetNull)
  attachment Attachment?        @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@unique([executionId, deviceEventId])
  @@index([executionId])
  @@index([itemId])
  @@map("checklist_evidence")
}

// ============================================================================
// FISCAL/DOCUMENTAL (Fase 52) — documentos fiscais/operacionais vinculados a
// viagem/veiculo/motorista/cliente (CT-e, MDF-e, NF-e, CIOT, DACTE, DAMDFE,
// comprovante de entrega). SEM emissao fiscal, SEM integracao SEFAZ/gateway
// nesta fase -- so armazenamento, identificacao basica de estrutura (parser
// tolerante) e vinculacao operacional. status=VALID significa apenas
// "estrutura/conteudo basico reconhecido pelo sistema", NUNCA validacao
// fiscal oficial perante a SEFAZ (ver docs/fiscal-documents.md).
// ============================================================================

enum FiscalDocumentType {
  CTE
  MDFE
  NFE
  CIOT
  DACTE
  DAMDFE
  DELIVERY_PROOF
  OTHER
  /// Fase 102 -- evidencia documental de uma TripOccurrence (foto de avaria,
  /// boletim de ocorrencia etc.), distinta de DELIVERY_PROOF (evidencia de
  /// ENTREGA). Mesmo mecanismo generico de FiscalDocument, nunca um storage
  /// paralelo.
  OCCURRENCE_EVIDENCE

  @@map("fiscal_document_type")
}

/// VALID/INVALID referem-se apenas ao reconhecimento de estrutura/conteudo
/// basico pelo sistema (parser XML ou revisao manual) -- nunca uma validacao
/// fiscal oficial perante a SEFAZ (essa integracao nao existe nesta fase).
enum FiscalDocumentStatus {
  PENDING
  VALID
  INVALID
  CANCELLED

  @@map("fiscal_document_status")
}

/// Como o documento entrou no sistema -- UPLOAD (arquivo enviado
/// manualmente, sem parser) ou XML_IMPORT (arquivo XML processado pelo
/// parser tolerante, secao 4 do pedido).
enum FiscalDocumentSource {
  UPLOAD
  XML_IMPORT

  @@map("fiscal_document_source")
}

/// Documento fiscal/documental vinculado a operacao. Vinculo com
/// Trip/Vehicle/Driver/Customer e sempre opcional e independente (nunca
/// derivado automaticamente uns dos outros, distinto do padrao de
/// TripExpense) -- um documento pode ser importado antes de qualquer
/// vinculacao e vinculado depois via PATCH.
model FiscalDocument {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  documentType       FiscalDocumentType   @map("document_type")
  documentNumber     String?              @map("document_number")
  /// Chave de acesso (44 digitos, NF-e/CT-e/MDF-e) -- unica por tenant
  /// quando presente (Postgres permite multiplos NULL sob unique, entao
  /// documentos sem chave nunca colidem entre si por este campo).
  accessKey          String?              @map("access_key")
  series             String?
  issueDate          DateTime?            @map("issue_date")
  senderName         String?              @map("sender_name")
  senderDocument     String?              @map("sender_document")
  recipientName      String?              @map("recipient_name")
  recipientDocument  String?              @map("recipient_document")
  status             FiscalDocumentStatus @default(PENDING)
  source             FiscalDocumentSource
  attachmentId       String?              @map("attachment_id") @db.Uuid
  /// Nome original do arquivo enviado pelo cliente -- so metadado de
  /// exibicao, NUNCA usado como caminho de storage (ver
  /// fiscal-document-storage.config.ts, mesmo padrao de toll-import/
  /// checklist-evidence: nome em disco e sempre um UUID novo).
  fileName           String?              @map("file_name")
  mimeType           String?              @map("mime_type")
  sizeBytes          Int?                 @map("size_bytes")
  /// Campos adicionais reconhecidos pelo parser XML sem coluna propria (ex:
  /// "amount" -- valor total do documento, presente no XML mas fora da
  /// lista minima de colunas pedida na Fase 52) -- preserva o dado bruto,
  /// nunca descartado nem inventado quando ausente.
  metadata           Json?                @default("{}")
  /// Fase 56 -- idempotencia de submissao offline pelo Driver App (mesmo
  /// padrao de ChecklistExecution/TripStop/FuelSupply/AxleEvent): reenviar a
  /// fila (syncQueue.ts) apos reconexao nunca cria um segundo comprovante.
  /// Sempre null para documentos criados pelo fluxo administrativo (upload/
  /// import), unico por tenant (Postgres permite multiplos NULL sob unique).
  deviceEventId      String?              @unique @map("device_event_id")
  tripId             String?              @map("trip_id") @db.Uuid
  /// Fase 100 -- vinculo DIRETO com a parada/entrega especifica (Fase 88),
  /// distinto de tripId (a viagem inteira). Opcional: documentos nao-POD, e
  /// PODs de viagens sem paradas explicitas, continuam sem este vinculo.
  /// Quando presente, so pode apontar para uma TripDeliveryStop COMPLETED
  /// (ver FiscalDocumentsService.assertDeliveryProofStopUsable).
  tripDeliveryStopId String?              @map("trip_delivery_stop_id") @db.Uuid
  /// Fase 102 -- vinculo DIRETO com a ocorrencia especifica (Fase 67/101),
  /// distinto de tripId (a viagem inteira). Independente de
  /// tripDeliveryStopId -- uma ocorrencia pode ou nao estar ligada a uma
  /// parada. Nenhuma exigencia de status da ocorrencia (mesmo criterio ja
  /// usado para vincular a propria ocorrencia a uma parada, Fase 101): uma
  /// evidencia pode ser anexada antes, durante ou depois da resolucao.
  tripOccurrenceId   String?              @map("trip_occurrence_id") @db.Uuid
  vehicleId          String?              @map("vehicle_id") @db.Uuid
  driverId           String?              @map("driver_id") @db.Uuid
  customerId         String?              @map("customer_id") @db.Uuid
  createdBy          String               @map("created_by") @db.Uuid
  updatedBy          String?              @map("updated_by") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attachment       Attachment?       @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  trip             Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  tripDeliveryStop TripDeliveryStop? @relation(fields: [tripDeliveryStopId], references: [id], onDelete: SetNull)
  tripOccurrence   TripOccurrence?   @relation(fields: [tripOccurrenceId], references: [id], onDelete: SetNull)
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver           Driver?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  creator          UserAccount       @relation("FiscalDocumentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater          UserAccount?      @relation("FiscalDocumentUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  /// Fase Fiscal/XML -- lado reverso de Payable.fiscalDocumentId (1:1
  /// opcional). Presente quando o usuario gerou uma conta a pagar a partir
  /// deste documento (autopreenchimento, nunca automatico) -- ver
  /// FiscalDocumentsService/PayablesService.create.
  payable          Payable?
  /// Fase Fiscal/XML -- lado reverso de Receivable.fiscalDocumentId, mesmo
  /// principio de `payable` acima.
  receivable       Receivable?

  @@unique([tenantId, accessKey])
  @@index([tenantId, documentType])
  @@index([tenantId, status])
  @@index([tenantId, tripId])
  @@index([tenantId, tripDeliveryStopId])
  @@index([tenantId, tripOccurrenceId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, driverId])
  @@index([tenantId, issueDate])
  @@map("fiscal_documents")
}

// ============================================================================
// FRETE COMERCIAL — contratos, tabelas de frete, regras e precificacao (Fase 59)
// ============================================================================

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED

  @@map("contract_status")
}

/// Contrato comercial de frete com um cliente. Nao confundir com CIOT/CT-e
/// (Fases 52-58, modulo fiscal/documental -- aquele e o documento fiscal do
/// transporte contratado; este e o acordo comercial que da origem ao preco).
/// Nenhuma regra fiscal e alterada/lida por este model.
model Contract {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  customerId      String         @map("customer_id") @db.Uuid
  code            String
  description     String?
  status          ContractStatus @default(DRAFT)
  startDate       DateTime       @map("start_date")
  /// Nulo = sem data de termino definida. Contrato so e considerado
  /// "vencido" quando endDate esta no passado -- nunca inferido por outro
  /// criterio (ver ContractsService.assertUsable).
  endDate         DateTime?      @map("end_date")
  notes           String?        @db.Text
  /// Condicoes comerciais em texto livre (ex: prazo de pagamento, reajuste,
  /// SLA) -- nenhuma estrutura obrigatoria foi pedida para esta fase.
  commercialTerms String?        @map("commercial_terms") @db.Text
  createdBy       String         @map("created_by") @db.Uuid
  updatedBy       String?        @map("updated_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  freightTables      FreightTable[]
  tripFreights       TripFreight[]
  creator            UserAccount       @relation("ContractCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater            UserAccount?      @relation("ContractUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  /// Fase 98 -- processos de renovacao que partiram DESTE contrato (esta
  /// linha nunca e alterada por uma renovacao alem do status/updatedBy --
  /// startDate/endDate/commercialTerms permanecem intactos, ver
  /// ContractRenewal).
  renewalsAsPrevious ContractRenewal[] @relation("ContractRenewalPrevious")
  /// Presente quando ESTE contrato foi criado como resultado de uma
  /// renovacao concluida de outro contrato.
  renewalAsNew       ContractRenewal?  @relation("ContractRenewalNew")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, endDate])
  @@map("contracts")
}

// ============================================================================
// RENOVACAO DE CONTRATOS (Fase 98)
// ============================================================================

/// PENDING = iniciada, aguardando conclusao ou cancelamento. COMPLETED =
/// concluida -- newContractId preenchido, o contrato anterior nunca tem
/// startDate/endDate/commercialTerms alterados (regra 3 -- so o status pode
/// mudar, para EXPIRED, refletindo que foi substituido). CANCELLED =
/// abandonada, nenhum dos dois contratos e alterado.
enum ContractRenewalStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@map("contract_renewal_status")
}

/// Processo de renovacao de um Contract -- NUNCA um segundo cadastro de
/// contrato (regra 2): o contrato renovado continua sendo um Contract
/// normal, criado atraves do MESMO ContractsService.create ja existente
/// (Fase 59), reaproveitado integralmente. Este model so registra o
/// PROCESSO/HISTORICO da renovacao (quando foi iniciada, por quem, quando
/// concluida/cancelada, e a vigencia anterior/nova) -- o Contract em si
/// (`Contract` model, tabela `contracts`) nunca ganha nenhum campo novo por
/// causa desta fase, preservando 100% sua estrutura ja existente e testada.
model ContractRenewal {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  previousContractId String                @map("previous_contract_id") @db.Uuid
  /// Preenchido somente quando status=COMPLETED -- o Contract novo, criado
  /// via ContractsService.create no momento da conclusao.
  newContractId      String?               @unique @map("new_contract_id") @db.Uuid
  status             ContractRenewalStatus @default(PENDING)
  /// Snapshot da vigencia anterior no momento em que a renovacao foi
  /// INICIADA (regra 3/5 -- data real, nunca inferida; preservada aqui
  /// mesmo que o Contract anterior seja consultado/editado por outra via
  /// depois, ja que edicao de Contract e um fluxo independente e legitimo).
  previousEndDate    DateTime?             @map("previous_end_date")
  /// Preenchidos somente ao concluir -- a vigencia do Contract novo.
  newStartDate       DateTime?             @map("new_start_date")
  newEndDate         DateTime?             @map("new_end_date")
  notes              String?               @db.Text
  initiatedBy        String                @map("initiated_by") @db.Uuid
  initiatedAt        DateTime              @default(now()) @map("initiated_at")
  completedBy        String?               @map("completed_by") @db.Uuid
  completedAt        DateTime?             @map("completed_at")
  cancelledBy        String?               @map("cancelled_by") @db.Uuid
  cancelledAt        DateTime?             @map("cancelled_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  previousContract Contract     @relation("ContractRenewalPrevious", fields: [previousContractId], references: [id], onDelete: Restrict)
  newContract      Contract?    @relation("ContractRenewalNew", fields: [newContractId], references: [id], onDelete: SetNull)
  initiator        UserAccount  @relation("ContractRenewalInitiator", fields: [initiatedBy], references: [id], onDelete: Restrict)
  completer        UserAccount? @relation("ContractRenewalCompleter", fields: [completedBy], references: [id], onDelete: SetNull)
  canceller        UserAccount? @relation("ContractRenewalCanceller", fields: [cancelledBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, previousContractId])
  @@index([tenantId, status])
  @@map("contract_renewals")
}

enum FreightTableStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED

  @@map("freight_table_status")
}

/// Tabela de frete de um cliente (agrupa 1+ FreightRule). O calculo NUNCA
/// acopla direto a tabela -- sempre passa pela regra (FreightRule) vigente
/// dentro dela, permitindo que a mesma tabela evolua sem quebrar o historico
/// (ver FreightRule para o versionamento propriamente dito).
model FreightTable {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  customerId     String             @map("customer_id") @db.Uuid
  contractId     String?            @map("contract_id") @db.Uuid
  name           String
  code           String
  status         FreightTableStatus @default(DRAFT)
  effectiveFrom  DateTime           @map("effective_from")
  /// Nulo = sem termino definido.
  effectiveUntil DateTime?          @map("effective_until")
  notes          String?            @db.Text
  createdBy      String             @map("created_by") @db.Uuid
  updatedBy      String?            @map("updated_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contract     Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  rules        FreightRule[]
  tripFreights TripFreight[]
  creator      UserAccount   @relation("FreightTableCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater      UserAccount?  @relation("FreightTableUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  /// Fase 94 -- cotacoes cujo valor foi calculado a partir desta tabela
  /// (snapshot -- nunca muda retroativamente se a tabela for editada depois).
  quotations   Quotation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, contractId])
  @@index([tenantId, status])
  @@map("freight_tables")
}

/// ACTIVE = pode ser selecionada pelo motor de calculo; ARCHIVED = fechada
/// por uma nova versao (ver previousVersionId/nextVersion), preservada
/// apenas para historico -- nunca apagada (secao 4 da Fase 59).
enum FreightRuleStatus {
  ACTIVE
  ARCHIVED

  @@map("freight_rule_status")
}

/// Regra de precificacao dentro de uma FreightTable. Versionada: uma edicao
/// comercial NUNCA altera a linha em uso -- fecha a versao atual
/// (status ARCHIVED, effectiveUntil = agora) e cria uma nova linha
/// (version + 1, previousVersionId apontando pra anterior), mesmo espirito
/// de ChecklistTemplate (Fase 38, encadeamento de versao) combinado com
/// TollRate (Fase 23/33, vigencia effectiveFrom/effectiveUntil) -- aqui os
/// dois são necessarios: o encadeamento preserva a arvore de historico
/// navegavel, a vigencia permite a consulta "qual regra valia nesta data"
/// que TripFreight depende para nunca mudar retroativamente (secao 4).
/// Todos os criterios sao opcionais -- uma regra pode usar so os que
/// precisar (nulo = nao restringe por aquele criterio).
model FreightRule {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  freightTableId    String            @map("freight_table_id") @db.Uuid
  version           Int               @default(1)
  status            FreightRuleStatus @default(ACTIVE)
  previousVersionId String?           @unique @map("previous_version_id") @db.Uuid
  effectiveFrom     DateTime          @map("effective_from")
  effectiveUntil    DateTime?         @map("effective_until")

  // --- criterios (todos opcionais; nulo = nao restringe) ---
  originLocationId      String?      @map("origin_location_id") @db.Uuid
  destinationLocationId String?      @map("destination_location_id") @db.Uuid
  /// Regiao textual (ex: UF/regiao) -- distinta de originLocationId (ponto
  /// operacional especifico); nunca inferida automaticamente de coordenadas.
  originRegion          String?      @map("origin_region")
  destinationRegion     String?      @map("destination_region")
  /// Texto livre -- nenhuma taxonomia oficial de tipo de carga existe hoje
  /// no projeto, nao inventada aqui.
  cargoType             String?      @map("cargo_type")
  /// Reaproveita o enum ja existente (Vehicle/ChecklistTemplate) -- nunca
  /// duplicado.
  vehicleType           VehicleType? @map("vehicle_type")
  minWeightKg           Decimal?     @map("min_weight_kg") @db.Decimal(10, 2)
  maxWeightKg           Decimal?     @map("max_weight_kg") @db.Decimal(10, 2)
  minCubageM3           Decimal?     @map("min_cubage_m3") @db.Decimal(10, 2)
  maxCubageM3           Decimal?     @map("max_cubage_m3") @db.Decimal(10, 2)
  /// Desempate deterministico explicito quando 2+ regras sao igualmente
  /// especificas para os mesmos parametros (maior prioridade vence) -- ver
  /// selectApplicableFreightRule em freight-calculation.util.ts.
  priority              Int          @default(0)

  // --- composicao de valor (todos opcionais; ausente = 0 no calculo) ---
  baseAmount            Decimal? @map("base_amount") @db.Decimal(10, 2)
  perKmAmount           Decimal? @map("per_km_amount") @db.Decimal(10, 2)
  perTonAmount          Decimal? @map("per_ton_amount") @db.Decimal(10, 2)
  /// Piso aplicado sobre base+perKm+perTon (nunca sobre pedagio/adicionais).
  minimumAmount         Decimal? @map("minimum_amount") @db.Decimal(10, 2)
  tollAmount            Decimal? @map("toll_amount") @db.Decimal(10, 2)
  riskAdditionalAmount  Decimal? @map("risk_additional_amount") @db.Decimal(10, 2)
  nightAdditionalAmount Decimal? @map("night_additional_amount") @db.Decimal(10, 2)
  dailyRateAmount       Decimal? @map("daily_rate_amount") @db.Decimal(10, 2)
  demurrageAmount       Decimal? @map("demurrage_amount") @db.Decimal(10, 2)
  /// Taxas nomeadas livremente: [{label: string, amount: number}] -- unica
  /// forma extensivel sem precisar de coluna nova a cada taxa nova pedida
  /// pelo negocio.
  otherFees             Json?    @map("other_fees")

  notes     String?  @db.Text
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  freightTable        FreightTable  @relation(fields: [freightTableId], references: [id], onDelete: Cascade)
  originLocation      Location?     @relation("FreightRuleOrigin", fields: [originLocationId], references: [id], onDelete: SetNull)
  destinationLocation Location?     @relation("FreightRuleDestination", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  previousVersion     FreightRule?  @relation("FreightRuleVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion         FreightRule?  @relation("FreightRuleVersions")
  tripFreights        TripFreight[]
  creator             UserAccount   @relation("FreightRuleCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater             UserAccount?  @relation("FreightRuleUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  /// Fase 94 -- cotacoes cujo valor foi calculado a partir desta regra.
  quotations          Quotation[]

  @@index([tenantId])
  @@index([tenantId, freightTableId])
  @@index([tenantId, status])
  @@index([tenantId, freightTableId, status, effectiveFrom])
  @@map("freight_rules")
}

/// Resultado comercial aplicado a UMA viagem -- 1:1 com Trip (mesmo espirito
/// de TripSettlement/TripMetrics). Os valores monetarios sao sempre um
/// SNAPSHOT gravado no momento em que a cotacao foi aplicada: mesmo que a
/// FreightRule/FreightTable/Contract referenciados sejam arquivados ou
/// tenham uma nova versao criada depois, os valores aqui NUNCA mudam
/// retroativamente (secao 4/regras importantes da Fase 59).
model TripFreight {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  tripId           String   @unique @map("trip_id") @db.Uuid
  contractId       String?  @map("contract_id") @db.Uuid
  freightTableId   String?  @map("freight_table_id") @db.Uuid
  freightRuleId    String?  @map("freight_rule_id") @db.Uuid
  /// Parametros de entrada usados no calculo (origem/destino/distancia/peso/
  /// cubagem/veiculo/tipo de carga/adicionais aplicados) -- preservado para
  /// auditoria/reproducibilidade, nunca reprocessado automaticamente depois.
  calculationInput Json     @map("calculation_input")
  baseAmount       Decimal? @map("base_amount") @db.Decimal(10, 2)
  additionsAmount  Decimal? @map("additions_amount") @db.Decimal(10, 2)
  tollAmount       Decimal? @map("toll_amount") @db.Decimal(10, 2)
  feesAmount       Decimal? @map("fees_amount") @db.Decimal(10, 2)
  /// Valor calculado pelo motor (secao 5) -- nunca editado manualmente.
  estimatedAmount  Decimal? @map("estimated_amount") @db.Decimal(10, 2)
  /// Valor efetivamente contratado/negociado -- pode divergir do estimado
  /// (negociacao humana), editavel via PATCH; nunca sobrescreve o estimado.
  contractedAmount Decimal? @map("contracted_amount") @db.Decimal(10, 2)
  /// Valor final de fechamento (opcional) -- distinto de contractedAmount
  /// (o que foi negociado) e de receita realizada (o que foi efetivamente
  /// registrado no financeiro, ver TripRevenue via revenueId).
  finalAmount      Decimal? @map("final_amount") @db.Decimal(10, 2)
  /// Vinculo com a receita (TripRevenue, Fase 51) gerada a partir deste
  /// valor -- unico por TripFreight, garante que aplicar a receita nunca
  /// cria duplicidade (secao 8: "nao criar receita duplicada").
  revenueId        String?  @unique @map("revenue_id") @db.Uuid
  createdBy        String   @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip         Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  contract     Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  freightTable FreightTable? @relation(fields: [freightTableId], references: [id], onDelete: SetNull)
  freightRule  FreightRule?  @relation(fields: [freightRuleId], references: [id], onDelete: SetNull)
  revenue      TripRevenue?  @relation(fields: [revenueId], references: [id], onDelete: SetNull)
  creator      UserAccount   @relation("TripFreightCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater      UserAccount?  @relation("TripFreightUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, contractId])
  @@index([tenantId, freightTableId])
  @@map("trip_freights")
}

// ============================================================================
// COTACOES — solicitacoes de transporte feitas pelo cliente (Fase 94)
// ============================================================================

/// DRAFT = em elaboracao, ainda editavel livremente. SENT = comunicada ao
/// cliente, ainda editavel (conteudo/valor) enquanto aguarda resposta.
/// APPROVED/REJECTED = resposta do cliente -- finais para o conteudo, mas
/// APPROVED ainda pode avancar para CONVERTED ou ser CANCELLED. CONVERTED =
/// virou uma Trip real (ver convertedTripId) -- terminal. CANCELLED =
/// encerrada sem seguir adiante -- terminal. Nenhum estado "EXPIRED"
/// proprio: validade e sempre derivada de validUntil (ver
/// QuotationEntity.expired no mapper), nunca uma transicao que alguem
/// escolhe -- é um fato de tempo, nao uma decisao de negocio.
enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED

  @@map("quotation_status")
}

/// CALCULATED = valor veio do motor de precificacao existente (Fase 59,
/// FreightPricingService.simulate -- nunca duplicado aqui). MANUAL =
/// nenhuma tabela/regra aplicavel foi encontrada (ou o calculo nao cobre o
/// caso) e o valor foi informado por um humano (regra 4 da Fase 94).
enum QuotationAmountSource {
  CALCULATED
  MANUAL

  @@map("quotation_amount_source")
}

/// Solicitacao de transporte de um cliente, ainda fora do fluxo operacional
/// de Trip -- registra e acompanha o pedido comercial antes de virar uma
/// viagem de fato. Reutiliza Customer/CustomerContact (Fase 93), Location e
/// o motor de precificacao de Freight (Fase 59); nunca duplica nenhum deles.
///
/// O valor e as condicoes sao sempre um SNAPSHOT gravado no momento da
/// cotacao (mesmo principio de TripFreight.calculationInput/estimatedAmount,
/// secao 4/5 da Fase 59): mesmo que a FreightTable/FreightRule referenciada
/// mude depois, os campos aqui gravados NUNCA sao reprocessados
/// automaticamente (regra 5). freightTableId/freightRuleId sao apenas
/// ponteiros de rastreabilidade (onDelete: SetNull -- apagar a tabela/regra
/// de origem nunca apaga a cotacao nem seu valor ja gravado).
model Quotation {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  customerId            String          @map("customer_id") @db.Uuid
  /// Pessoa de contato do cliente que fez a solicitacao (Fase 93) -- opcional.
  customerContactId     String?         @map("customer_contact_id") @db.Uuid
  originLocationId      String          @map("origin_location_id") @db.Uuid
  destinationLocationId String          @map("destination_location_id") @db.Uuid
  /// Texto livre -- mesmo principio de FreightRule.cargoType (nenhuma
  /// taxonomia oficial de tipo de carga existe hoje no projeto).
  cargoType             String?         @map("cargo_type")
  weightKg              Decimal?        @map("weight_kg") @db.Decimal(10, 2)
  cubageM3              Decimal?        @map("cubage_m3") @db.Decimal(10, 2)
  vehicleType           VehicleType?    @map("vehicle_type")
  /// Condicoes comerciais e observacoes em texto livre.
  conditions            String?         @db.Text
  status                QuotationStatus @default(DRAFT)
  validUntil            DateTime        @map("valid_until")

  amountSource     QuotationAmountSource @map("amount_source")
  /// Valor cotado final (snapshot -- o que foi de fato apresentado ao
  /// cliente). Igual a calculatedAmount quando amountSource=CALCULATED, ou
  /// informado manualmente quando amountSource=MANUAL.
  amount           Decimal               @map("amount") @db.Decimal(10, 2)
  /// Ponteiros de rastreabilidade (snapshot -- nunca usados para
  /// reprocessar o valor depois de gravado).
  freightTableId   String?               @map("freight_table_id") @db.Uuid
  freightRuleId    String?               @map("freight_rule_id") @db.Uuid
  /// Breakdown retornado pelo motor no momento do calculo (nulo quando
  /// amountSource=MANUAL e nenhum calculo esteve disponivel).
  baseAmount       Decimal?              @map("base_amount") @db.Decimal(10, 2)
  additionsAmount  Decimal?              @map("additions_amount") @db.Decimal(10, 2)
  tollAmount       Decimal?              @map("toll_amount") @db.Decimal(10, 2)
  feesAmount       Decimal?              @map("fees_amount") @db.Decimal(10, 2)
  /// Valor bruto calculado pelo motor (FreightQuoteEntity.totalAmount),
  /// preservado mesmo quando amountSource=MANUAL sobrescreveu o valor final
  /// (auditoria: "o motor sugeriu X, foi cotado Y").
  calculatedAmount Decimal?              @map("calculated_amount") @db.Decimal(10, 2)
  /// Parametros de entrada usados na tentativa de calculo (mesmo espirito de
  /// TripFreight.calculationInput) -- preservado para auditoria/
  /// reproducibilidade, nunca reprocessado automaticamente depois.
  calculationInput Json?                 @map("calculation_input")

  /// Viagem criada a partir desta cotacao (POST /quotations/:id/convert-to-trip,
  /// so quando status=APPROVED) -- reaproveita INTEGRALMENTE TripsService.create,
  /// nunca uma segunda logica de criacao de viagem.
  convertedTripId String? @unique @map("converted_trip_id") @db.Uuid

  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerContact       CustomerContact?      @relation(fields: [customerContactId], references: [id], onDelete: SetNull)
  originLocation        Location              @relation("QuotationOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destinationLocation   Location              @relation("QuotationDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  freightTable          FreightTable?         @relation(fields: [freightTableId], references: [id], onDelete: SetNull)
  freightRule           FreightRule?          @relation(fields: [freightRuleId], references: [id], onDelete: SetNull)
  convertedTrip         Trip?                 @relation(fields: [convertedTripId], references: [id], onDelete: SetNull)
  creator               UserAccount           @relation("QuotationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater               UserAccount?          @relation("QuotationUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  /// Fase 95 -- propostas comerciais formais geradas a partir desta cotacao.
  proposals             Proposal[]
  /// Fase 96 -- oportunidades do pipeline comercial vinculadas a esta cotacao.
  pipelineOpportunities PipelineOpportunity[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, validUntil])
  @@map("quotations")
}

// ============================================================================
// PROPOSTAS — proposta comercial formal ao cliente (Fase 95)
// ============================================================================

/// DRAFT = em elaboracao, UNICO estado com conteudo editavel. SENT =
/// enviada ao cliente, aguardando decisao -- conteudo ja bloqueado a partir
/// daqui ("impedir alteracoes incompativeis depois de SENT/ACCEPTED/
/// REJECTED/EXPIRED/CANCELLED"), so o STATUS ainda pode avancar.
/// ACCEPTED/REJECTED = decisao do cliente (ver decidedAt) -- terminais.
/// EXPIRED = marcada explicitamente quando a validade se esgota sem
/// decisao (mesmo espirito manual de ContractStatus.EXPIRED -- nenhum job
/// automatico neste projeto) -- terminal. CANCELLED = retirada antes de
/// uma decisao -- terminal.
enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED

  @@map("proposal_status")
}

/// Proposta comercial formal ao cliente -- distinta de Quotation (Fase 94):
/// a Quotation e o pedido/calculo comercial "de trabalho"; a Proposal e o
/// documento formal que de fato vai ao cliente para aceite, com numeracao
/// propria e ciclo de decisao. Vinculo com Quotation e OPCIONAL ("quando
/// aplicavel") -- tambem pode ser criada diretamente, sem cotacao previa.
///
/// O valor e as condicoes comerciais sao sempre um SNAPSHOT gravado no
/// momento da emissao (mesmo principio de Quotation/TripFreight): quando
/// gerada a partir de uma Quotation, os valores sao copiados de uma
/// cotacao que so pode ser vinculada aqui quando APPROVED -- estado em que
/// o proprio conteudo da Quotation ja esta congelado (ver
/// QuotationsService.assertContentEditable) -- nunca reprocessados depois.
/// Nenhum motor de precificacao proprio aqui (regra 3): o valor vem da
/// Quotation ja calculada ou e informado diretamente na criacao.
model Proposal {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  /// Sequencial por tenant (1, 2, 3...) -- gerado pelo backend
  /// (ProposalsService.create), nunca informado pelo cliente da API.
  number               Int
  customerId           String         @map("customer_id") @db.Uuid
  /// Cotacao de origem, quando aplicavel -- precisa estar APPROVED no
  /// momento da geracao (ver ProposalsService.assertQuotationUsable).
  quotationId          String?        @map("quotation_id") @db.Uuid
  status               ProposalStatus @default(DRAFT)
  /// Valor total da proposta (snapshot -- nunca recalculado depois de
  /// gravado).
  totalAmount          Decimal        @map("total_amount") @db.Decimal(10, 2)
  /// Condicoes comerciais (prazo, forma de pagamento etc.), snapshot em
  /// texto livre no momento da emissao.
  commercialConditions String?        @map("commercial_conditions") @db.Text
  /// Observacoes comerciais -- distinto de commercialConditions (mesmo
  /// espirito de Contract.notes vs Contract.commercialTerms, Fase 59).
  notes                String?        @db.Text
  issuedAt             DateTime       @default(now()) @map("issued_at")
  validUntil           DateTime       @map("valid_until")
  /// Quando o cliente decidiu (transicao para ACCEPTED/REJECTED) -- nulo
  /// para EXPIRED/CANCELLED (nao e uma decisao do cliente) e enquanto
  /// DRAFT/SENT (ainda sem decisao). Sempre derivado da propria transicao
  /// de status, nunca informado manualmente.
  decidedAt            DateTime?      @map("decided_at")
  createdBy            String         @map("created_by") @db.Uuid
  updatedBy            String?        @map("updated_by") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation             Quotation?            @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  creator               UserAccount           @relation("ProposalCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater               UserAccount?          @relation("ProposalUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  /// Fase 96 -- oportunidades do pipeline comercial vinculadas a esta proposta.
  pipelineOpportunities PipelineOpportunity[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, quotationId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("proposals")
}

// ============================================================================
// PIPELINE COMERCIAL — acompanhamento de oportunidades (Fase 96)
// ============================================================================

/// Estagio do funil comercial, CONFIGURAVEL POR TENANT (diferente de
/// QuotationStatus/ProposalStatus, que sao enums fixos) -- por isso e uma
/// tabela, nao um enum. Cada tenant recebe um conjunto inicial padrao (LEAD,
/// QUOTATION, PROPOSAL, NEGOTIATION, WON, LOST) na primeira vez que acessa o
/// pipeline (ver PipelineStagesService.ensureDefaultStages), e pode
/// renomear/reordenar/inativar ou adicionar novos estagios livremente.
/// isWon/isLost marcam estagios TERMINAIS (nenhuma PipelineOpportunity sai
/// deles -- ver PipelineOpportunitiesService.assertStageTransitionAllowed);
/// a distincao ganho/perda nunca e inferida do nome, sempre desses dois
/// booleans explicitos.
model PipelineStage {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// Posicao das colunas no Kanban / ordem de exibicao -- unico por tenant.
  order     Int
  isWon     Boolean  @default(false) @map("is_won")
  isLost    Boolean  @default(false) @map("is_lost")
  /// Inativado nunca aparece para novas oportunidades, mas oportunidades
  /// que ja o usam continuam validas (nunca apagado -- historico intacto).
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunities PipelineOpportunity[]

  @@unique([tenantId, order])
  @@index([tenantId])
  @@map("pipeline_stages")
}

/// Oportunidade comercial acompanhada do lead ate o fechamento (ganho ou
/// perda). Reutiliza INTEGRALMENTE Customer/Quotation/Proposal -- nunca
/// duplica cliente, calculo de frete ou snapshot comercial: quotationId/
/// proposalId sao apenas VINCULOS (onDelete: SetNull), e estimatedValue e
/// preenchido a partir de Proposal.totalAmount/Quotation.amount quando
/// vinculada (nunca um novo motor de precificacao, nunca um valor
/// inventado quando nao ha nenhum vinculo). Nao e um registro financeiro:
/// nenhuma conta a receber/pagar ou lancamento e criado ou lido daqui.
model PipelineOpportunity {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  /// Fase 94 -- cotacao relacionada, quando aplicavel. Sem exigencia de
  /// status especifico (diferente de Proposal, que so aceita Quotation
  /// APPROVED) -- uma oportunidade pode existir desde o primeiro contato,
  /// antes de qualquer cotacao aprovada.
  quotationId    String?       @map("quotation_id") @db.Uuid
  /// Fase 95 -- proposta relacionada, quando aplicavel.
  proposalId     String?       @map("proposal_id") @db.Uuid
  stageId        String        @map("stage_id") @db.Uuid
  /// Rotulo livre da oportunidade (ex: "Expansao frota SP") -- opcional,
  /// puramente descritivo.
  title          String?
  /// Estimativa de valor -- NUNCA um dado financeiro real (nenhuma
  /// Receivable/Payable/FinancialTransaction e criada ou referenciada
  /// aqui). Herdado de Proposal/Quotation quando vinculada e nao
  /// sobrescrito explicitamente; digitavel livremente quando nao ha vinculo.
  estimatedValue Decimal?      @map("estimated_value") @db.Decimal(10, 2)
  notes          String?       @db.Text
  stage          PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  /// Motivo obrigatorio ao mover para um estagio isLost=true (ver
  /// PipelineOpportunitiesService.updateStage) -- nulo em qualquer outro caso.
  lostReason     String?       @map("lost_reason") @db.Text
  /// Gravados automaticamente na propria transicao de estagio (isWon/
  /// isLost), nunca informados manualmente.
  wonAt          DateTime?     @map("won_at")
  lostAt         DateTime?     @map("lost_at")
  createdBy      String        @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation Quotation?   @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  proposal  Proposal?    @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  creator   UserAccount  @relation("PipelineOpportunityCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater   UserAccount? @relation("PipelineOpportunityUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, stageId])
  @@index([tenantId, quotationId])
  @@index([tenantId, proposalId])
  @@index([tenantId, createdAt])
  @@map("pipeline_opportunities")
}

// ============================================================================
// FATURAMENTO OPERACIONAL — conciliacao comercial da viagem (Fase 60)
// ============================================================================

/// DRAFT = sem valor faturavel ainda (TripFreight sem valor calculado).
/// READY = valor faturavel disponivel, nada faturado ainda.
/// PARTIALLY_INVOICED = invoicedAmount > 0 e < billableAmount.
/// INVOICED = invoicedAmount >= billableAmount (saldo zerado).
/// PAID = confirmacao manual de recebimento -- o projeto nao tem nenhuma
/// integracao de pagamento (Stripe/PIX/debito automatico, fora de escopo),
/// entao este status e SEMPRE definido explicitamente por um humano via
/// PATCH, nunca inferido/calculado automaticamente.
/// CANCELLED = bloqueia qualquer novo faturamento; entradas ja geradas
/// (TripBillingEntry/TripRevenue) NUNCA sao apagadas (historico imutavel).
enum TripBillingStatus {
  DRAFT
  READY
  PARTIALLY_INVOICED
  INVOICED
  PAID
  CANCELLED

  @@map("trip_billing_status")
}

/// Container de faturamento de UMA viagem -- 1:1 com Trip (mesmo espirito
/// de TripFreight/TripSettlement/TripMetrics, Fase 51/59). billableAmount
/// e SEMPRE lido do snapshot ja gravado em TripFreight (contractedAmount
/// -> finalAmount -> estimatedAmount, mesma prioridade ja usada pelo
/// FreightPricingService.applyRevenue da Fase 59) -- nunca recalculado
/// aqui, nunca reprocessado com uma regra comercial atualmente vigente
/// (Fase 59, secao 4: valores historicos de viagem nunca mudam
/// retroativamente). invoicedAmount e a soma das TripBillingEntry --
/// nunca editado diretamente, sempre derivado das entradas.
model TripBilling {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  tripId         String            @unique @map("trip_id") @db.Uuid
  status         TripBillingStatus @default(READY)
  /// Nulo quando a viagem ainda nao tem nenhum valor comercial calculado
  /// (TripFreight ausente ou sem valor) -- nunca inventado/estimado.
  billableAmount Decimal?          @map("billable_amount") @db.Decimal(10, 2)
  invoicedAmount Decimal           @default(0) @map("invoiced_amount") @db.Decimal(10, 2)
  notes          String?           @db.Text
  cancelledAt    DateTime?         @map("cancelled_at")
  cancelledBy    String?           @map("cancelled_by") @db.Uuid
  createdBy      String            @map("created_by") @db.Uuid
  updatedBy      String?           @map("updated_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip       Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  entries    TripBillingEntry[]
  creator    UserAccount        @relation("TripBillingCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater    UserAccount?       @relation("TripBillingUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  canceller  UserAccount?       @relation("TripBillingCanceller", fields: [cancelledBy], references: [id], onDelete: SetNull)
  /// Fase 72 -- titulo de conta a receber gerado a partir deste
  /// faturamento (1:1 opcional, Receivable.billingId e @unique).
  receivable Receivable?

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("trip_billings")
}

/// Lancamento IMUTAVEL de faturamento (total ou parcial) -- ledger
/// append-only, mesmo espirito de SubscriptionPayment (Fase 50): nenhum
/// endpoint de update/delete existe para este model. Cada entrada gera
/// EXATAMENTE 1 TripRevenue (revenueId @unique -- nunca duplicada,
/// reaproveitando TripRevenuesService.create integralmente).
model TripBillingEntry {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tripBillingId String   @map("trip_billing_id") @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  revenueId     String   @unique @map("revenue_id") @db.Uuid
  notes         String?  @db.Text
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tripBilling TripBilling @relation(fields: [tripBillingId], references: [id], onDelete: Cascade)
  revenue     TripRevenue @relation(fields: [revenueId], references: [id], onDelete: Restrict)
  creator     UserAccount @relation("TripBillingEntryCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, tripBillingId])
  @@map("trip_billing_entries")
}

// ============================================================================
// CONTAS A RECEBER (Fase 72) — visao de cobranca/acompanhamento sobre o
// faturamento ja existente (Fase 60). NAO e um segundo sistema financeiro:
// Receivable e um titulo gerado A PARTIR de um TripBilling (1:1, billingId
// @unique garante idempotencia -- nunca 2 titulos para o mesmo
// faturamento), com um campo que TripBilling nao tem (dueDate) e um
// historico de recebimentos reais e imutavel (ReceivablePayment), distinto
// de TripBilling.receivedAmount (que por limitacao da Fase 60 sempre
// espelha invoicedAmount, ja documentado em docs/receivables.md).
// ============================================================================

/// Estado ESCRITO do titulo -- atualizado transacionalmente a cada
/// pagamento/cancelamento (mesmo espirito de TripBillingStatus). NUNCA
/// contem OVERDUE: vencimento depende da passagem do tempo, entao e
/// sempre calculado ao vivo (status escrito OPEN/PARTIALLY_RECEIVED +
/// dueDate no passado = OVERDUE na entidade/listagem), nunca armazenado
/// (evitaria exigir um job para nao ficar desatualizado).
enum ReceivableStatus {
  OPEN
  PARTIALLY_RECEIVED
  PAID
  CANCELLED

  @@map("receivable_status")
}

enum ReceivablePaymentMethod {
  PIX
  BANK_TRANSFER
  BOLETO
  CASH
  CHECK
  CARD
  OTHER

  @@map("receivable_payment_method")
}

/// Titulo de conta a receber -- SNAPSHOT gerado a partir de um TripBilling
/// (POST /receivables/from-billing/:billingId). originalAmount e congelado
/// no momento da geracao (= TripBilling.invoicedAmount naquele instante):
/// alterar o faturamento depois NUNCA muda um titulo ja criado (mesmo
/// principio ja usado em TripFreight/TripSettlement, Fase 59/17).
/// receivedAmount e MATERIALIZADO (soma de ReceivablePayment.amount,
/// atualizado na MESMA transacao de cada pagamento -- nunca uma segunda
/// escrita) pelo mesmo motivo que TripBilling.invoicedAmount e
/// materializado a partir de TripBillingEntry: permite filtrar/paginar por
/// saldo/status sem exigir um SUM por linha a cada listagem. status NAO e
/// uma coluna persistida -- e sempre derivado (cancelledAt/receivedAmount/
/// originalAmount/dueDate) porque OVERDUE depende da passagem do tempo
/// (uma coluna estatica ficaria desatualizada sem um job).
model Receivable {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  /// Copiado de Trip.customerId no momento da geracao -- nulo quando a
  /// viagem nao tinha cliente vinculado (mesmo estado ja possivel em
  /// TripRevenue.customerId), OU informado diretamente num titulo manual
  /// (Fase Financeiro CP/CR -- ver comentario acima do model).
  customerId         String?          @map("customer_id") @db.Uuid
  /// Nullable desde a Fase Financeiro CP/CR: um titulo MANUAL (POST
  /// /receivables, sem faturamento de viagem -- ex: servico avulso) nao tem
  /// viagem nenhuma. Titulos gerados por POST /receivables/from-billing
  /// continuam sempre preenchendo este campo (copiado de TripBilling.tripId).
  tripId             String?          @map("trip_id") @db.Uuid
  /// Nullable pelo mesmo motivo de tripId acima -- um titulo manual nao tem
  /// faturamento de origem. @unique continua garantindo a idempotencia
  /// (secao 19): nunca 2 titulos para o mesmo faturamento (Postgres permite
  /// varios NULL sob unique -- nao restringe titulos manuais entre si).
  billingId          String?          @unique @map("billing_id") @db.Uuid
  /// Fase Fiscal/XML -- origem alternativa a billingId: titulo MANUAL gerado
  /// a partir de um FiscalDocument (NF-e/CT-e com valor extraido do XML,
  /// autopreenchimento no formulario de criacao manual -- ver
  /// ReceivablesService.create). @unique pelo mesmo motivo de billingId:
  /// nunca 2 titulos para o mesmo documento fiscal. Mutuamente exclusivo com
  /// parcelamento (installments) -- ver validacao no service.
  fiscalDocumentId   String?          @unique @map("fiscal_document_id") @db.Uuid
  /// Fase Financeiro CP/CR -- parcelamento (somente na criacao MANUAL, ver
  /// ReceivablesService.create). Todas as parcelas de um mesmo titulo
  /// parcelado compartilham o mesmo installmentGroupId (UUID gerado na
  /// criacao, nunca reaproveitado de outro model). Titulos nao parcelados
  /// (incluindo todos os gerados a partir de faturamento) tem os 3 campos
  /// nulos.
  installmentGroupId String?          @map("installment_group_id") @db.Uuid
  installmentNumber  Int?             @map("installment_number")
  installmentTotal   Int?             @map("installment_total")
  description        String
  originalAmount     Decimal          @map("original_amount") @db.Decimal(12, 2)
  /// Materializado -- ver comentario do model acima. Nunca editado direto,
  /// sempre incrementado dentro da transacao que cria um ReceivablePayment.
  receivedAmount     Decimal          @default(0) @map("received_amount") @db.Decimal(12, 2)
  issueDate          DateTime         @map("issue_date")
  dueDate            DateTime         @map("due_date")
  /// Ver comentario do enum ReceivableStatus -- nunca OVERDUE aqui.
  status             ReceivableStatus @default(OPEN)
  /// Cancelamento (secao 10) -- preserva historico de pagamentos ja
  /// registrados, apenas bloqueia novos.
  cancelledAt        DateTime?        @map("cancelled_at")
  cancelledBy        String?          @map("cancelled_by") @db.Uuid
  createdBy          String           @map("created_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  trip           Trip?               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  billing        TripBilling?        @relation(fields: [billingId], references: [id], onDelete: Cascade)
  fiscalDocument FiscalDocument?     @relation(fields: [fiscalDocumentId], references: [id], onDelete: SetNull)
  creator        UserAccount         @relation("ReceivableCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  canceller      UserAccount?        @relation("ReceivableCanceller", fields: [cancelledBy], references: [id], onDelete: SetNull)
  payments       ReceivablePayment[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, tripId])
  @@index([tenantId, installmentGroupId])
  @@index([tenantId, dueDate])
  @@index([tenantId, status])
  @@map("receivables")
}

/// Recebimento IMUTAVEL -- ledger append-only, mesmo espirito de
/// SubscriptionPayment (Fase 50) e TripBillingEntry (Fase 60): nenhum
/// endpoint de update/delete. Cada linha e um recebimento real (parcial ou
/// total); a soma de todas as linhas de um Receivable e SEMPRE igual a
/// Receivable.receivedAmount (mantido consistente na mesma transacao).
model ReceivablePayment {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @map("tenant_id") @db.Uuid
  receivableId           String                  @map("receivable_id") @db.Uuid
  amount                 Decimal                 @db.Decimal(12, 2)
  paymentDate            DateTime                @map("payment_date")
  paymentMethod          ReceivablePaymentMethod @map("payment_method")
  /// Fase Financeiro CP/CR -- juros/multa por atraso, sempre informados
  /// manualmente pelo usuario (nunca calculados por uma taxa automatica --
  /// o projeto nao modela nenhuma regra de juros/mora). Somam ao valor
  /// REAL recebido (FinancialTransaction), mas nunca abatem o saldo do
  /// titulo (Receivable.originalAmount nunca inclui juros/multa).
  interestAmount         Decimal?                @map("interest_amount") @db.Decimal(12, 2)
  fineAmount             Decimal?                @map("fine_amount") @db.Decimal(12, 2)
  /// Desconto concedido neste recebimento -- ABATE o saldo do titulo (soma
  /// a receivedAmount igual que `amount`, ver ReceivablesService.
  /// registerPayment), mas NAO gera movimentacao financeira real (nenhum
  /// dinheiro correspondente entra na FinancialTransaction).
  discountAmount         Decimal?                @map("discount_amount") @db.Decimal(12, 2)
  reference              String?
  notes                  String?                 @db.Text
  /// Fase 79 -- conta financeira onde o recebimento efetivamente entrou.
  /// Nullable so por compatibilidade com pagamentos registrados ANTES desta
  /// fase (nunca preenchido retroativamente) -- toda escrita nova exige o
  /// campo (RegisterReceivablePaymentDto.financialAccountId).
  financialAccountId     String?                 @map("financial_account_id") @db.Uuid
  /// Fase 79 -- a UNICA FinancialTransaction (CREDIT) gerada por este
  /// recebimento. @unique e a barreira de unicidade no banco (secao 8 do
  /// pedido): nenhum outro ReceivablePayment pode apontar para a mesma
  /// FinancialTransaction.
  financialTransactionId String?                 @unique @map("financial_transaction_id") @db.Uuid
  createdBy              String                  @map("created_by") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receivable           Receivable            @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  creator              UserAccount           @relation("ReceivablePaymentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  financialAccount     FinancialAccount?     @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  financialTransaction FinancialTransaction? @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, receivableId])
  @@map("receivable_payments")
}

// ============================================================================
// CONTAS A PAGAR (Fase 73) — espelho de "CONTAS A RECEBER" (Fase 72) para o
// lado da despesa. Payable e gerado A PARTIR de uma TripExpense (1:1,
// expenseId @unique garante idempotencia -- nunca 2 titulos para a mesma
// despesa) OU criado MANUALMENTE (Fase Financeiro CP/CR -- tripId/expenseId
// nulos, para custos administrativos sem viagem: aluguel, seguro, fornecedor
// nao-operacional). TripExpense continua sendo a UNICA fonte de verdade do
// custo OPERACIONAL da viagem; Payable so adiciona o que TripExpense nao tem
// (dueDate + historico de pagamento real via PayablePayment) e, para
// titulos manuais, e a UNICA fonte (nao ha TripExpense correspondente).
// category/paymentMethod REAPROVEITAM os enums ja existentes
// (ExpenseCategory/ExpensePaymentMethod) -- nenhum enum paralelo. O projeto
// nao possui um model Supplier: supplierName e um snapshot/entrada de texto
// livre, nunca uma relacao inventada (ver docs/payables.md).
// ============================================================================

/// Mesmo espirito de ReceivableStatus (Fase 72): nunca contem OVERDUE
/// (calculado ao vivo a partir de dueDate -- ver payable-status.util.ts).
enum PayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@map("payable_status")
}

/// Titulo de conta a pagar -- SNAPSHOT gerado a partir de uma TripExpense
/// (POST /payables/from-expense/:expenseId). originalAmount/category/
/// supplierName sao congelados no momento da geracao: alterar a despesa
/// depois NUNCA muda um titulo ja criado. paidAmount e MATERIALIZADO (soma
/// de PayablePayment.amount, atualizado na mesma transacao de cada
/// pagamento), mesmo motivo de Receivable.receivedAmount (Fase 72).
model Payable {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  /// Nullable desde a Fase Financeiro CP/CR: um titulo MANUAL (POST
  /// /payables, sem despesa de viagem -- ex: aluguel, seguro, fornecedor
  /// administrativo) nao tem viagem nenhuma. Titulos gerados por POST
  /// /payables/from-expense continuam sempre preenchendo este campo
  /// (copiado de TripExpense.tripId).
  tripId             String?         @map("trip_id") @db.Uuid
  /// Nullable pelo mesmo motivo de tripId acima. @unique continua
  /// garantindo a idempotencia (secao 22): nunca 2 titulos para a mesma
  /// despesa (Postgres permite varios NULL sob unique -- nao restringe
  /// titulos manuais entre si).
  expenseId          String?         @unique @map("expense_id") @db.Uuid
  /// Fase Fiscal/XML -- origem alternativa a expenseId: titulo MANUAL gerado
  /// a partir de um FiscalDocument (NF-e/CT-e com valor extraido do XML,
  /// autopreenchimento no formulario de criacao manual -- ver
  /// PayablesService.create). @unique pelo mesmo motivo de expenseId: nunca
  /// 2 titulos para o mesmo documento fiscal. Mutuamente exclusivo com
  /// parcelamento (installments) -- um documento fiscal gera 1 titulo, nunca
  /// N parcelas (ver validacao no service).
  fiscalDocumentId   String?         @unique @map("fiscal_document_id") @db.Uuid
  /// Snapshot de TripExpense.supplier (texto livre) -- o projeto nao possui
  /// um model Supplier estruturado, entao nunca inventamos uma relacao. Num
  /// titulo manual, informado diretamente pelo usuario (mesmo campo).
  supplierName       String?         @map("supplier_name")
  /// Snapshot de TripExpense.category quando gerado a partir de despesa, ou
  /// escolhido diretamente pelo usuario num titulo manual -- reaproveita o
  /// enum ja existente (nunca um enum paralelo, secao 13).
  category           ExpenseCategory
  description        String
  originalAmount     Decimal         @map("original_amount") @db.Decimal(12, 2)
  /// Materializado -- ver comentario do model acima.
  paidAmount         Decimal         @default(0) @map("paid_amount") @db.Decimal(12, 2)
  issueDate          DateTime        @map("issue_date")
  dueDate            DateTime        @map("due_date")
  status             PayableStatus   @default(OPEN)
  cancelledAt        DateTime?       @map("cancelled_at")
  cancelledBy        String?         @map("cancelled_by") @db.Uuid
  /// Fase Financeiro CP/CR -- parcelamento (somente na criacao MANUAL, ver
  /// PayablesService.create). Mesmo desenho de Receivable.installmentGroupId.
  installmentGroupId String?         @map("installment_group_id") @db.Uuid
  installmentNumber  Int?            @map("installment_number")
  installmentTotal   Int?            @map("installment_total")
  createdBy          String          @map("created_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip           Trip?            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expense        TripExpense?     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fiscalDocument FiscalDocument?  @relation(fields: [fiscalDocumentId], references: [id], onDelete: SetNull)
  creator        UserAccount      @relation("PayableCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  canceller      UserAccount?     @relation("PayableCanceller", fields: [cancelledBy], references: [id], onDelete: SetNull)
  payments       PayablePayment[]

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@index([tenantId, installmentGroupId])
  @@index([tenantId, dueDate])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("payables")
}

/// Pagamento IMUTAVEL -- ledger append-only, mesmo espirito de
/// ReceivablePayment (Fase 72) e SubscriptionPayment (Fase 50): nenhum
/// endpoint de update/delete. paymentMethod reaproveita ExpensePaymentMethod
/// (ja usado em TripExpense) -- nenhum enum paralelo.
model PayablePayment {
  id                     String               @id @default(uuid()) @db.Uuid
  tenantId               String               @map("tenant_id") @db.Uuid
  payableId              String               @map("payable_id") @db.Uuid
  amount                 Decimal              @db.Decimal(12, 2)
  paymentDate            DateTime             @map("payment_date")
  paymentMethod          ExpensePaymentMethod @map("payment_method")
  /// Fase Financeiro CP/CR -- juros/multa por atraso, sempre informados
  /// manualmente (nunca calculados por uma taxa automatica). Somam ao valor
  /// REAL pago (FinancialTransaction), mas nunca abatem o saldo do titulo.
  interestAmount         Decimal?             @map("interest_amount") @db.Decimal(12, 2)
  fineAmount             Decimal?             @map("fine_amount") @db.Decimal(12, 2)
  /// Desconto concedido neste pagamento -- ABATE o saldo do titulo (soma a
  /// paidAmount igual que `amount`, ver PayablesService.registerPayment),
  /// mas NAO gera movimentacao financeira real.
  discountAmount         Decimal?             @map("discount_amount") @db.Decimal(12, 2)
  reference              String?
  notes                  String?              @db.Text
  /// Fase 79 -- conta financeira de onde o pagamento efetivamente saiu.
  /// Nullable pelo mesmo motivo de ReceivablePayment.financialAccountId
  /// (compatibilidade retroativa, nunca preenchido para pagamentos antigos).
  financialAccountId     String?              @map("financial_account_id") @db.Uuid
  /// Fase 79 -- a UNICA FinancialTransaction (DEBIT) gerada por este
  /// pagamento. @unique = barreira de unicidade no banco (secao 8).
  financialTransactionId String?              @unique @map("financial_transaction_id") @db.Uuid
  createdBy              String               @map("created_by") @db.Uuid
  createdAt              DateTime             @default(now()) @map("created_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payable              Payable               @relation(fields: [payableId], references: [id], onDelete: Cascade)
  creator              UserAccount           @relation("PayablePaymentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  financialAccount     FinancialAccount?     @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  financialTransaction FinancialTransaction? @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, payableId])
  @@map("payable_payments")
}

// ============================================================================
// FECHAMENTO FINANCEIRO / PERIODOS (Fase 76) — camada de CONTROLE sobre os
// ledgers ja existentes (Receivable/Payable e seus pagamentos). NAO e um
// ledger novo: nenhum valor financeiro e duplicado ou armazenado aqui, so o
// estado (OPEN/CLOSED) de uma janela mensal por tenant. Fechar um periodo
// nunca apaga/altera dados historicos, apenas passa a bloquear novas
// mutacoes cuja data de competencia caia dentro dele (ver
// FinancialPeriodGuard e docs/financial-periods.md).
// ============================================================================

enum FinancialPeriodStatus {
  OPEN
  CLOSED

  @@map("financial_period_status")
}

/// Periodo financeiro mensal de um tenant (year/month, ex: 2026-08).
/// @@unique([tenantId, year, month]) garante no maximo um periodo por mes
/// por tenant. CLOSED nunca volta para OPEN nesta fase (secao 21 do pedido
/// -- reabertura fica para fase futura).
model FinancialPeriod {
  id        String                @id @default(uuid()) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  year      Int
  month     Int
  status    FinancialPeriodStatus @default(OPEN)
  openedAt  DateTime              @default(now()) @map("opened_at")
  closedAt  DateTime?             @map("closed_at")
  openedBy  String                @map("opened_by") @db.Uuid
  closedBy  String?               @map("closed_by") @db.Uuid
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opener UserAccount  @relation("FinancialPeriodOpener", fields: [openedBy], references: [id], onDelete: Restrict)
  closer UserAccount? @relation("FinancialPeriodCloser", fields: [closedBy], references: [id], onDelete: SetNull)

  @@unique([tenantId, year, month])
  @@index([tenantId, status])
  @@map("financial_periods")
}

// ============================================================================
// CONTAS FINANCEIRAS / SALDOS / MOVIMENTACOES MANUAIS (Fase 78) — primeira
// camada estrutural de contas bancarias/caixa da transportadora. NAO e
// integracao bancaria (sem OFX/CNAB/PIX/Open Finance) e NAO sincroniza
// automaticamente com ReceivablePayment/PayablePayment (ver secao 12 do
// pedido e docs/financial-accounts.md) -- e um livro-caixa manual.
// ============================================================================

enum FinancialAccountType {
  BANK
  CASH

  @@map("financial_account_type")
}

enum FinancialTransactionType {
  CREDIT
  DEBIT

  @@map("financial_transaction_type")
}

/// Conta bancaria/caixa da transportadora. initialBalance e fixado na
/// criacao e nunca alterado depois (secao 5 do pedido) -- qualquer correcao
/// vira uma FinancialTransaction de ajuste. NUNCA armazenar credencial
/// bancaria (senha, token, chave de API) -- apenas identificacao (nome do
/// banco/codigo/numero mascarado), sempre opcional.
model FinancialAccount {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  name                String
  type                FinancialAccountType
  initialBalance      Decimal              @default(0) @map("initial_balance") @db.Decimal(12, 2)
  bankName            String?              @map("bank_name")
  bankCode            String?              @map("bank_code")
  accountNumberMasked String?              @map("account_number_masked")
  isActive            Boolean              @default(true) @map("is_active")
  createdBy           String               @map("created_by") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator            UserAccount                @relation("FinancialAccountCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  transactions       FinancialTransaction[]
  /// Fase 79 -- recebimentos/pagamentos que usaram esta conta.
  receivablePayments ReceivablePayment[]
  payablePayments    PayablePayment[]
  /// Fase 80 -- extrato importado desta conta.
  bankTransactions   FinancialBankTransaction[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@map("financial_accounts")
}

/// Movimentacao IMUTAVEL (ledger append-only, mesmo espirito de
/// ReceivablePayment/PayablePayment) -- nunca ha UPDATE/DELETE pela API. O
/// saldo NUNCA e materializado aqui: sempre calculado como
/// initialBalance + SUM(CREDIT) - SUM(DEBIT) no momento da consulta (secao 3
/// do pedido), o que evita duas fontes de verdade divergentes. Uma
/// transferencia entre contas vira DUAS linhas (uma CREDIT, uma DEBIT)
/// vinculadas pelo mesmo referenceType='FinancialTransfer' +
/// referenceId=<uuid gerado na hora> -- reaproveita os campos genericos de
/// referencia (pensados para vinculo futuro com Receivable/Payable, secao
/// 12) em vez de criar uma tabela FinancialTransfer/coluna dedicada so para
/// isso (secao 4 do pedido: preferir a solucao mais simples).
model FinancialTransaction {
  id              String                   @id @default(uuid()) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  accountId       String                   @map("account_id") @db.Uuid
  type            FinancialTransactionType
  amount          Decimal                  @db.Decimal(12, 2)
  transactionDate DateTime                 @map("transaction_date")
  description     String
  referenceType   String?                  @map("reference_type")
  referenceId     String?                  @map("reference_id") @db.Uuid
  createdBy       String                   @map("created_by") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at")

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account           FinancialAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  creator           UserAccount               @relation("FinancialTransactionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  /// Fase 79 -- lado inverso de ReceivablePayment/PayablePayment.financialTransactionId
  /// (no maximo um dos dois, nunca ambos, para uma FinancialTransaction
  /// originada de pagamento -- transferencias/ajustes manuais nao tem nenhum).
  receivablePayment ReceivablePayment?
  payablePayment    PayablePayment?
  /// Fase 80 -- lado inverso de FinancialBankTransaction.financialTransactionId
  /// (no maximo uma BankTransaction conciliada por FinancialTransaction).
  bankTransaction   FinancialBankTransaction?

  @@index([tenantId])
  @@index([accountId, transactionDate])
  @@index([tenantId, type])
  @@map("financial_transactions")
}

// ============================================================================
// CONCILIACAO BANCARIA (Fase 80) — representa movimentacoes EXTERNAS
// (importadas de um extrato CSV), nunca outro ledger financeiro.
// FinancialTransaction continua sendo a UNICA fonte de verdade do saldo
// (ver docs/bank-reconciliation.md). Importar uma FinancialBankTransaction
// NUNCA cria uma FinancialTransaction automaticamente -- a conciliacao so
// VINCULA uma linha existente de cada lado, sempre por acao manual.
// ============================================================================

enum FinancialBankTransactionStatus {
  PENDING
  MATCHED
  DIVERGENT

  @@map("financial_bank_transaction_status")
}

/// Uma linha de extrato bancario importada. NAO copia todos os campos de
/// FinancialTransaction -- e uma representacao externa mais simples
/// (secao 2 do pedido). externalId identifica a movimentacao no banco
/// quando o extrato fornece (ex: FITID do OFX/CSV do banco); quando
/// ausente, rowHash e um hash best-effort da linha original, usado so como
/// sinal defensivo de duplicidade -- NUNCA uma garantia de identidade
/// (documentado em docs/bank-reconciliation.md).
model FinancialBankTransaction {
  id                     String                         @id @default(uuid()) @db.Uuid
  tenantId               String                         @map("tenant_id") @db.Uuid
  financialAccountId     String                         @map("financial_account_id") @db.Uuid
  date                   DateTime
  description            String
  amount                 Decimal                        @db.Decimal(12, 2)
  type                   FinancialTransactionType
  externalId             String?                        @map("external_id")
  rowHash                String?                        @map("row_hash")
  status                 FinancialBankTransactionStatus @default(PENDING)
  /// @unique -- no maximo uma BankTransaction aponta para cada
  /// FinancialTransaction (secao 3 do pedido).
  financialTransactionId String?                        @unique @map("financial_transaction_id") @db.Uuid
  metadata               Json?
  importedAt             DateTime                       @default(now()) @map("imported_at")
  updatedAt              DateTime                       @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financialAccount     FinancialAccount      @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  financialTransaction FinancialTransaction? @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, financialAccountId, externalId])
  @@index([tenantId])
  @@index([tenantId, financialAccountId])
  @@index([tenantId, status])
  @@index([financialAccountId, date])
  @@map("financial_bank_transactions")
}

// ============================================================================
// INTEGRACOES FUTURAS — mapeamento generico, sem acoplar a nenhum sistema
// ============================================================================

/// Mapeamento generico entre uma entidade interna e sua referencia num
/// sistema externo (TMS, ERP, telemetria, concessionaria de pedagio). Evita
/// criar uma tabela de integracao especifica a cada novo sistema.
model ExternalReference {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  entityName     String         @map("entity_name")
  entityId       String         @map("entity_id") @db.Uuid
  externalSystem ExternalSystem @map("external_system")
  externalId     String         @map("external_id")
  lastSyncedAt   DateTime?      @map("last_synced_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([externalSystem, externalId])
  @@index([tenantId, entityName, entityId])
  @@map("external_references")
}

