NODE_ENV=development
PORT=3333
DATABASE_URL="postgresql://user:password@localhost:5432/transportadoras_db?schema=public"
# O Next.js (apps/admin-web) cai para a porta 3001 automaticamente quando a
# 3000 ja esta ocupada -- liste as duas para o CORS nao quebrar nesse caso.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Segredos de assinatura dos tokens JWT. DEVEM ser diferentes entre si e ter
# no minimo 32 caracteres aleatorios. Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-por-um-segredo-forte-com-pelo-menos-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte-com-pelo-menos-32-caracteres
JWT_REFRESH_EXPIRES_IN=7d

# Upload de extratos de pedagio (Fase 15) -- diretorio privado (nunca servido
# estaticamente) e tamanho maximo por arquivo.
TOLL_IMPORT_STORAGE_DIR=./storage/toll-imports
TOLL_IMPORT_MAX_FILE_SIZE_MB=10

# Roteirizacao geografica (Fase 26) -- Google Routes API. OPCIONAL: sem esta
# chave, o modulo /trips/:id/route-plan funciona estruturalmente mas retorna
# erro 503 claro ("provider de rotas nao configurado") em vez de dados
# simulados. Nunca commitar uma chave real neste arquivo .env.example.
# Como obter: https://console.cloud.google.com/ -> ativar "Routes API" ->
# criar credencial de API key (exige projeto com faturamento habilitado).
GOOGLE_ROUTES_API_KEY=
# Raio (metros) de tolerancia para casar uma praca descoberta na rota com uma
# TollPlaza do catalogo.
ROUTING_TOLL_MATCH_RADIUS_METERS=300
ROUTING_REQUEST_TIMEOUT_MS=8000

# Catalogo oficial de pedagios (Fase 33) -- sincronizacao automatica com
# fontes publicas (ANTT/ARTESP, ver docs/toll-data-providers.md). Nao existe
# "chave" aqui: as fontes sao publicas. Desabilitado por padrao -- ligue
# explicitamente quando quiser depender da sincronizacao automatica diaria.
TOLL_DATA_SYNC_ENABLED=false
# Uma vez por dia, 03:00 -- nunca configurar para rodar a cada poucos
# minutos (polling agressivo contra a fonte oficial).
TOLL_DATA_SYNC_CRON=0 3 * * *

# Centro de Notificacoes (Fase 70) -- processamento periodico interno
# (nunca push/e-mail/SMS). Ligado por padrao: nao faz nenhuma chamada de
# rede externa, so leitura/escrita interna idempotente.
NOTIFICATIONS_PROCESS_ENABLED=true
NOTIFICATIONS_PROCESS_CRON=*/5 * * * *
